--[[
	AzucarHackerUI  v2.1.0  "Acordeón"
	=====================================
	Pestañas verticales separadas. Al presionar una:

	  1. La línea se ALARGA (barra de acento + color activo) SIN mover
	     las demás: el panel se despliega HACIA ABAJO encima de ellas,
	     no las empuja ni les tapa el orden.
	  2. Se abre un panel con todas sus funciones
	     (Toggle, Slider, Dropdown, Button, Input, Keybind, Stat...).
	  3. Si hay muchas pestañas, el panel general scrollea: arrastrás
	     hacia abajo y encontrás las que quedaron fuera.

	Reloj de COLOMBIA (UTC-5, sin horario de verano) en la cabecera.
	Para otro país: config.UtcOffset = +2, -3, etc. en CreateWindow.

	Uso:

		local UI = loadstring(game:HttpGet("...AzucarHackerUI.lua"))()

		local Window = UI:CreateWindow({ Title = "Azúcar Hub", Subtitle = "v2.1" })

		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })

		Combate:CreateToggle({
			Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state)
				while state and UI.FlagValues["AutoFarm"] do
					task.wait(0.1)
				end
			end,
		})

		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200},
			Default = 16, Callback = function(v) print(v) end })

		UI:SetAccentColor("Rojo")   -- "Rojo" | "Azul" | "Verde" | "Blanco" | "Rainbow"
]]

local TweenService      = game:GetService("TweenService")
