--[[
	AzucarDulce  v1.1
	=================
	(Antes: AzucarRage — misma estructura, piel nueva)

	UI CHICA, de un solo rectángulo: arriba las pestañas en una fila
	horizontal, abajo las lógicas (sliders, toggles, etc.) de la
	pestaña activa. Compacta, pensada para quedar flotando en una
	esquina. Por defecto se para del lado IZQUIERDO.

	Es un RESKIN de AzucarRage: la estructura, los controles y la
	lógica interna (Flags, Callbacks, guardado de config) son
	EXACTAMENTE los mismos. Lo único que cambió es el tema visual:
	rosa pastel y blanco en vez de negro y rojo, esquinas más
	redonditas, y una letra más suave para el título. Sin aura, sin
	chispas, sin Window:Rage() ni nada corriendo en bucle por detrás
	(eso se sacó del todo en AzucarRage y acá tampoco está) — las
	únicas animaciones son las chiquitas de cada control al tocarlo
	(un destello, un saltito, una barrita de acento), que no cuestan
	nada porque no quedan corriendo todo el tiempo.

	Paleta de "sabores" en vez de Rojo/Negro/Blanco: Fresa (rosa
	fuerte, el que usa por defecto), Chicle (rosa chicle), Uva
	(violeta suave) y Menta (verde agua). Cambia SOLO el acento
	(borde/pestaña activa/relleno de toggles y sliders), no el fondo.

	v1.1: NOTIFICACIONES. Window:Notify("Listo") o Window:Notify({
	Title = "...", Text = "...", Duration = 3 }) — aparece abajo a la
	derecha en una tarjetita redondeada, se queda Duration segundos (3
	por defecto) y se va sola con un fundido. Si mandás varias, se
	apilan.

	Uso:
		local UI = loadstring(game:HttpGet("...AzucarDulce.lua"))()
		local Window = UI:CreateWindow({
			Title       = "Dulce Hub",
			Badge       = "NAH ID ADAPT",
			ServerName  = "NAH ID ADAPT",
			ToggleKey   = Enum.KeyCode.K,
			Theme       = "Fresa",  -- "Fresa" | "Chicle" | "Uva" | "Menta"
			CornerStyle = "Round",  -- "Round" | "Sharp"
			Width       = 400,
			Height      = 300,
			AutoSaveConfig  = true,
			AutoLoadStagger = 0.1,
			AutoLoadOrder   = {"M", "F", "A"},
			AutoSaveIgnore  = {"MiniPekka"},
		})
		local Combate = Window:CreateTab({ Name = "Combate" })
		Combate:CreateToggle({ Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state) ... end })
		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) ... end })

		Window:Notify("Auto Farm activado")
		Window:Notify({ Title = "Atención", Text = "Te quedaste sin energía", Duration = 4 })
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = {}
UI.__index = UI
UI.Version    = "1.1"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}
UI.ConfigFolder = "AzucarDulce"

local autoSaveTargets = {}
local loadingConfig = false
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

-- ============================================================
-- 	NÚMEROS QUE PODÉS TOCAR
-- ============================================================
local WINDOW_W = 400
local WINDOW_H = 300
local TAB_STRIP_H = 28

local Stub = {}
Stub.__index = function()
	return function() return setmetatable({}, Stub) end
end

-- Letra del título: algo redondito y tierno si tu ejecutor la tiene
-- (Roblox fue agregando fuentes menos comunes); si no existe, cae
-- sola a GothamBold sin romper el script.
local function safeFont(names, fallback)
	if typeof(names) == "string" then names = { names } end
	for _, name in ipairs(names) do
		local ok, item = pcall(function() return Enum.Font[name] end)
		if ok and item then return item end
	end
	return fallback
end
local FONT_TITLE = safeFont({ "FredokaOne", "GrandstanderBold", "Nunito" }, Enum.Font.GothamBold)

-- ============================================================
-- 	TEMA: DULCE (rosa pastel + blanco, esquinas redonditas)
-- ============================================================
local Theme = {
	Background = Color3.fromRGB(255, 240, 246),
	Panel      = Color3.fromRGB(255, 232, 240),
	Field      = Color3.fromRGB(255, 225, 236),
	Line       = Color3.fromRGB(255, 220, 232),
	LineOpen   = Color3.fromRGB(255, 206, 223),
	Border     = Color3.fromRGB(255, 122, 170),
	Text       = Color3.fromRGB(100, 45, 65),
	TextDim    = Color3.fromRGB(180, 125, 145),
	Active     = Color3.fromRGB(255, 105, 150),
	ActiveDim  = Color3.fromRGB(214, 74, 115),
	Alpha      = 0.06, -- transparencia de TODA la tarjeta junta (0 = sólida)
	FontTitle  = FONT_TITLE,
	Font       = Enum.Font.GothamMedium,
	FontBold   = Enum.Font.GothamBold,
}
UI.Theme = Theme

-- Paleta: cambia SOLO el acento (borde/pestaña activa/relleno de
-- toggles y sliders), no el fondo. Se elige por código con
-- config.Theme al crear la ventana, o en caliente con
-- UI:SetAccentColor(...). Sin animación: el cambio es instantáneo.
local Palettes = {
	Fresa  = Color3.fromRGB(255, 105, 150),
	Chicle = Color3.fromRGB(255, 153, 204),
	Uva    = Color3.fromRGB(186, 130, 230),
	Menta  = Color3.fromRGB(110, 210, 180),
}
UI.Palettes = Palettes
UI.CurrentPalette = "Fresa"

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

function UI:SetAccentColor(paletteName)
	local color = Palettes[paletteName]
	if not color then
		warn("[AzucarDulce] Sabor desconocido: " .. tostring(paletteName) .. ". Usá Fresa, Chicle, Uva o Menta.")
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Border, Theme.Active = color, color
	Theme.ActiveDim = color:Lerp(Color3.new(0, 0, 0), 0.22)
	for _, fn in ipairs(accentListeners) do pcall(fn) end
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do inst[prop] = value end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	return inst
end
-- Modo de esquinas: "Round" (bien redonditas, el espíritu dulce) o
-- "Sharp" (sin radio). Se elige por código con config.CornerStyle al
-- crear la ventana, o en caliente con UI:SetCornerStyle(...).
local CornerMode = "Round"
local cornerListeners = {}
local function onCornerChange(fn) table.insert(cornerListeners, fn) return fn end
local function corner(radius)
	radius = radius or 0
	local inst = new("UICorner", { CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) })
	onCornerChange(function() inst.CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) end)
	return inst
end
function UI:SetCornerStyle(mode)
	if mode ~= "Round" and mode ~= "Sharp" then
		warn("[AzucarDulce] Modo de esquina desconocido: " .. tostring(mode) .. ". Usá \"Round\" o \"Sharp\".")
		return
	end
	CornerMode = mode
	for _, fn in ipairs(cornerListeners) do pcall(fn) end
end
local function stroke(color, thickness) return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 }) end
local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top or all or 0), PaddingRight = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0), PaddingLeft = UDim.new(0, left or all or 0),
	})
end
local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end

-- Barrita de acento que se enciende a la izquierda de una fila al
-- pasar el mouse (botones, toggles, filas de dropdown, etc.). Esto es
-- lo único "animado" que hay: dura una fracción de segundo al tocar
-- algo, no queda corriendo en bucle, así que no cuesta nada de más.
local function hoverField(obj, base)
	base = base or Theme.Field
	local mark = new("Frame", {
		Size = UDim2.new(0, 3, 0.4, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Active, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = obj,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	onAccent(function() if mark.Parent then mark.BackgroundColor3 = Theme.Active end end)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.LineOpen })
		tween(mark, { BackgroundTransparency = 0, Size = UDim2.new(0, 3, 0.75, 0) }, 0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = base })
		tween(mark, { BackgroundTransparency = 1, Size = UDim2.new(0, 3, 0.4, 0) }, 0.15)
	end)
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES + FLAGS
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end
	local args = table.pack(...)
	if controller then controller._threads = controller._threads or {} end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then controller._threads[thisThread] = true end
		local ok, err = pcall(function() fn(table.unpack(args, 1, args.n)) end)
		if not ok then
			warn("[AzucarDulce] Error en tu callback: " .. tostring(err))
		end
		if controller and controller._threads then controller._threads[thisThread] = nil end
	end)
end
local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do pcall(task.cancel, th) end
	controller._threads = {}
end
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then return config.Callback end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else warn("[AzucarDulce] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.") end
		end
	end
	return function() end
end
local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end
local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do UI:SaveConfig(name) end
	end
end
local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end
local function host(self)
	if self.List then return self.List, (self.Window or self), self end
	if self._tabs and self._tabs[1] then
		warn("[AzucarDulce] Creaste un control sobre la ventana en vez de sobre una pestaña. Se agregó a la primera pestaña.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	DÓNDE COLGAR LA UI + LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then return hui end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then
		if pcall(function() local p = Instance.new("Folder") p.Parent = coreGui p:Destroy() end) then
			return coreGui
		end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then table.insert(places, plr.PlayerGui) end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and child.Name == "AzucarDulce"
					and child:GetAttribute("AzucarLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

-- ============================================================
-- 	CREATE WINDOW — el rectángulo chico
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	if config.CornerStyle ~= nil then UI:SetCornerStyle(config.CornerStyle) end
	if config.Theme ~= nil then UI:SetAccentColor(config.Theme) end

	local title = config.Title or config.Name or "Azúcar Dulce"
	local W = config.Width or WINDOW_W
	local H = config.Height or WINDOW_H
	local RADIUS = 18

	local subtitleParts = {}
	if config.Badge and tostring(config.Badge) ~= "" then table.insert(subtitleParts, tostring(config.Badge)) end
	if config.ServerName and tostring(config.ServerName) ~= "" then table.insert(subtitleParts, tostring(config.ServerName)) end
	local subtitleText = table.concat(subtitleParts, "  •  ")
	local HEADER_H = (subtitleText ~= "" and 42) or 30

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarDulce", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999, IgnoreGuiInset = config.IgnoreGuiInset ~= false,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("AzucarLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	-- Posición por defecto: IZQUIERDA de la pantalla. Pasá
	-- config.Position si querés ubicarla en cualquier otro lado.
	local defaultPanelPos = UDim2.new(0, 24, 0.5, -H / 2)

	-- ---------------- EL RECTÁNGULO ----------------
	-- CanvasGroup: dibuja fondo + controles juntos con UNA sola
	-- transparencia (Theme.Alpha) en vez de apilar transparencias fila
	-- por fila. Borde fijo, sin degradado ni rotación.
	local Panel = new("CanvasGroup", {
		Name = "Panel", Size = UDim2.new(0, W, 0, H),
		Position = config.Position or defaultPanelPos,
		BackgroundColor3 = Theme.Background, GroupTransparency = Theme.Alpha,
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2, Parent = ScreenGui,
	}, { corner(RADIUS), stroke(Theme.Border, 2) })
	local PanelStroke = Panel:FindFirstChildOfClass("UIStroke")
	onAccent(function() if PanelStroke and PanelStroke.Parent then PanelStroke.Color = Theme.Border end end)

	-- Barra superior: título (+ Badge/ServerName si los pasaste) + reloj.
	local TopBar = new("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Parent = Panel })
	new("TextLabel", {
		Text = title, Font = Theme.FontTitle, TextSize = 14, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -62, 0, 18), Parent = TopBar,
	})
	if subtitleText ~= "" then
		new("TextLabel", {
			Text = subtitleText, Font = Theme.Font, TextSize = 10, TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 22), Size = UDim2.new(1, -20, 0, 14), Parent = TopBar,
		})
	end
	local ClockLabel = new("TextLabel", {
		Text = os.date("%H:%M:%S"), Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, BackgroundTransparency = 1,
		Position = UDim2.new(1, -56, 0, 4), Size = UDim2.new(0, 46, 0, 18), Parent = TopBar,
	})
	onAccent(function() if ClockLabel.Parent then ClockLabel.TextColor3 = Theme.Active end end)
	task.spawn(function() while ClockLabel.Parent do ClockLabel.Text = os.date("%H:%M:%S") task.wait(1) end end)

	-- Fila de pestañas: horizontal, sin barra de scroll visible. Cada
	-- pestaña se posiciona a mano en CreateTab (Window._tabX).
	local TabStrip = new("ScrollingFrame", {
		Name = "TabStrip", Position = UDim2.new(0, 0, 0, HEADER_H), Size = UDim2.new(1, 0, 0, TAB_STRIP_H),
		BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, ScrollBarThickness = 0, ScrollBarImageTransparency = 1,
		ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(0, 0, 0, 0),
		ClipsDescendants = true, ZIndex = 3, Parent = Panel,
	})

	-- Contenido: debajo de la fila de pestañas, vertical, sin barra.
	local ContentScroll = new("ScrollingFrame", {
		Name = "Content", Position = UDim2.new(0, 8, 0, HEADER_H + TAB_STRIP_H + 4), Size = UDim2.new(1, -16, 1, -(HEADER_H + TAB_STRIP_H + 12)),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Active,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Panel,
	})
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ContentScroll })
	onAccent(function() if ContentScroll.Parent then ContentScroll.ScrollBarImageColor3 = Theme.Active end end)

	local EmptyHint = new("TextLabel", {
		Text = "Sin pestañas. Usá Window:CreateTab({ Name = \"...\" }).", Font = Theme.Font, TextSize = 11,
		TextColor3 = Theme.TextDim, TextWrapped = true, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Parent = ContentScroll,
	})

	local Window = setmetatable({
		ScreenGui = ScreenGui, Panel = Panel,
		TabStrip = TabStrip, ContentScroll = ContentScroll, EmptyHint = EmptyHint,
		_tabs = {}, _tabX = 8, _connections = {}, _visible = true, _loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0, _loadOrder = config.AutoLoadOrder,
		W = W, H = H,
	}, UI)

	local function track(conn) table.insert(Window._connections, conn) return conn end

	-- Scroll horizontal de pestañas con la rueda del mouse y arrastre con mouse/dedo.
	local dragKind, dragStartPos, canvasStartX = nil, Vector2.new(0, 0), 0
	Window._dragMoved = false
	track(TabStrip.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		Window._dragMoved = false
		dragKind = kind
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		canvasStartX = TabStrip.CanvasPosition.X
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragKind then return end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - dragStartPos.X
		if math.abs(dx) > 6 then Window._dragMoved = true end
		if dragKind == Enum.UserInputType.MouseButton1 and Window._dragMoved then
			TabStrip.CanvasPosition = Vector2.new(canvasStartX - dx, 0)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragKind = nil
		end
	end))
	track(TabStrip.MouseWheelForward:Connect(function() TabStrip.CanvasPosition = Vector2.new(math.max(0, TabStrip.CanvasPosition.X - 40), 0) end))
	track(TabStrip.MouseWheelBackward:Connect(function() TabStrip.CanvasPosition = Vector2.new(TabStrip.CanvasPosition.X + 40, 0) end))

	-- Mostrar/ocultar con una tecla. config.ToggleKey = false/nil desactiva el atajo.
	local toggleKey = config.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.K end
	if toggleKey then
		track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == toggleKey then
				local ok, err = pcall(function() Window:Toggle() end)
				if not ok then
					warn("[AzucarDulce] Error al abrir/cerrar con " .. tostring(toggleKey) .. ": " .. tostring(err))
				end
			end
		end))
	end

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) ~= "table" then registry = {} rawset(_G, "__AzucarDulceWindows", registry) end
	table.insert(registry, Window)

	-- ---------------- Guardado/carga de configuración ----------------
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do table.insert(autoSaveIgnore, word) end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	return Window
end

function UI:Show()
	self.Panel.Visible = true
	self._visible = true
end
function UI:Hide()
	self.Panel.Visible = false
	self._visible = false
end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do pcall(function() conn:Disconnect() end) end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do if w == self then table.remove(UI.Windows, i) break end end
end

-- ============================================================
-- 	NOTIFICACIONES
-- ============================================================
-- Window:Notify("Listo") o Window:Notify({ Title = "...", Text = "...",
-- Duration = 3 }). Aparece abajo a la derecha de la pantalla, en una
-- tarjetita redondeada, se queda Duration segundos (3 por defecto) y
-- se va sola con un fundido. Si mandás varias, se apilan: la más
-- nueva queda pegada a la esquina y las anteriores se corren hacia
-- arriba. Es un fundido de entrada y uno de salida nada más — no
-- queda nada corriendo en bucle, así que no cuesta rendimiento.
function UI:Notify(config)
	if typeof(config) == "string" then config = { Text = config } end
	config = config or {}

	local ScreenGui = self.ScreenGui
	if not ScreenGui then
		warn("[AzucarDulce] Notify se llama sobre la ventana: Window:Notify(...).")
		return
	end

	local titleText = config.Title
	local bodyText = config.Text or config.Message or config.Content or ""
	local duration = config.Duration or 3
	local hasTitle = titleText ~= nil and tostring(titleText) ~= ""

	local Holder = self._notifyHolder
	if not Holder then
		Holder = new("Frame", {
			Name = "Notifications",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0, 260, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 100,
			Parent = ScreenGui,
		}, {
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		self._notifyHolder = Holder
		self._notifyCount = 0
	end

	self._notifyCount = (self._notifyCount or 0) + 1
	local cardH = hasTitle and 54 or 40

	-- CanvasGroup para que el fundido de entrada/salida mueva TODO junto
	-- (fondo, borde, barrita de acento y texto) con una sola propiedad.
	local Card = new("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, cardH),
		BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1, -- arranca invisible
		ClipsDescendants = true,
		LayoutOrder = self._notifyCount,
		ZIndex = 101,
		Parent = Holder,
	}, { corner(14), stroke(Theme.Border, 1.5) })

	new("Frame", {
		Size = UDim2.new(0, 4, 1, -14), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0),
		BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Card,
	}, { corner(2) })

	if hasTitle then
		new("TextLabel", {
			Text = tostring(titleText), Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 8), Size = UDim2.new(1, -28, 0, 16),
			Parent = Card,
		})
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 26), Size = UDim2.new(1, -28, 0, 22),
			Parent = Card,
		})
	else
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 0), Size = UDim2.new(1, -28, 1, 0),
			Parent = Card,
		})
	end

	tween(Card, { GroupTransparency = 0 }, 0.25)
	task.delay(duration, function()
		if not Card.Parent then return end
		tween(Card, { GroupTransparency = 1 }, 0.3)
		task.delay(0.3, function()
			if Card.Parent then Card:Destroy() end
		end)
	end)

	return Card
end

