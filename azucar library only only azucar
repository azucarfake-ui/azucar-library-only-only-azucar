		TextSize = 11 + FONT_BOOST,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = holder,
	})
	local underline = new("Frame", {
		Size = UDim2.new(0, 18, 0, 2),
		Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = holder,
	})
	onAccent(function()
		if underline.Parent then underline.BackgroundColor3 = Theme.Active end
	end)

	local controller = setmetatable({ Instance = label }, UI)
	function controller:Set(newText) label.Text = string.upper(tostring(newText)) end
	return controller
end
UI.CreateSectionLabel = UI.CreateSection

function UI:CreateDivider()
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	})
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Parent = holder,
	})
	return setmetatable({ Instance = holder }, UI)
end

function UI:CreateStat(config)
	config = config or {}
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 5, 10, 5, 10) })

	local ValueLabel = new("TextLabel", {
		Text = tostring(config.Value or "0"),
		Font = Theme.FontBold,
		TextSize = 18 + FONT_BOOST,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 19),
		Parent = holder,
	})
	onAccent(function()
		if ValueLabel.Parent then ValueLabel.TextColor3 = Theme.Active end
	end)

	new("TextLabel", {
		Text = config.Label or config.Text or config.Name or "",
		Font = Theme.Font,
		TextSize = 11 + FONT_BOOST,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 19),
		Size = UDim2.new(1, 0, 0, 11),
		Parent = holder,
	})

	local Stat = setmetatable({ Instance = ValueLabel, Value = config.Value or "0" }, UI)
	function Stat:Set(newValue)
		self.Value = newValue
		ValueLabel.Text = tostring(newValue)
	end
	registerFlag(config.Flag, Stat, config.Value)
	return Stat
end

-- ============================================================
-- 	GUARDAR / CARGAR CONFIGURACIÓN (Toggles, Sliders, Dropdowns, etc.)
-- ============================================================
-- Cualquier control creado con un Flag (config.Flag = "AutoFarm") queda
-- registrado en UI.Flags / UI.FlagValues. Estas funciones recorren eso
-- para guardar y volver a aplicar los valores.
--
-- Uso manual:
--   Window:SaveConfig("MiConfig")
--   Window:LoadConfig("MiConfig")
--   Window:ListConfigs() -> { "MiConfig", "default", ... }
--
-- Uso automático (recomendado, más simple): pasá
-- config.AutoSaveConfig = true (o un nombre) en CreateWindow y listo:
-- se guarda solo, AL INSTANTE, cada vez que tocás algo, y se recupera
-- solo al volver a entrar.
--
-- Usa las funciones del ejecutor (writefile/readfile/isfile/isfolder/
-- makefolder/listfiles). Si tu ejecutor no las tiene, avisa por
-- consola y no rompe nada del resto del script.

local function ensureConfigFolder()
	if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(UI.ConfigFolder) then
			pcall(makefolder, UI.ConfigFolder)
		end
	end
end

-- Solo guarda tipos "simples": booleanos, números y strings tal cual, y
-- los KeyCode como su nombre (ej. "F"), para poder reconstruirlos al
-- cargar. Cualquier otra cosa rara que hayas metido en una Flag (un
-- jugador, tu propia tabla) se ignora en vez de romper el guardado del
-- resto.
function UI:SaveConfig(name)
	name = name or "default"

	if typeof(writefile) ~= "function" then
		warn("[AzucarLegit] Tu ejecutor no tiene writefile — no se puede guardar la config.")
		return false
	end

	ensureConfigFolder()

	local data = {}
	for flag, value in pairs(UI.FlagValues) do
		if not isIgnoredFlag(flag) then
			local t = typeof(value)
			if t == "boolean" or t == "number" or t == "string" then
				data[flag] = value
			elseif t == "EnumItem" and value.Name then
				data[flag] = { __keycode = value.Name }
			end
		end
	end

	local okJson, encoded = pcall(function()
		return game:GetService("HttpService"):JSONEncode(data)
	end)
	if not okJson then
		warn("[AzucarLegit] No se pudo convertir la config a JSON.")
		return false
	end

	local okWrite, err = pcall(writefile, UI.ConfigFolder .. "/" .. name .. ".json", encoded)
	if not okWrite then
		warn("[AzucarLegit] No se pudo guardar la config: " .. tostring(err))
		return false
	end
	return true
end

-- Recorre la config guardada y llama a controller:Set(valor) por cada
-- Flag que coincida con un control que exista AHORA MISMO en la UI —
-- así no importa si guardaste con una versión de tu hub que tenía más
-- o menos controles que la que tenés cargada hoy.
-- `stagger` (segundos): si es mayor a 0, aplica los controles guardados
-- DE A UNO, con esa pausa entre cada uno, en vez de todos en el mismo
-- instante. Por defecto usa self._loadStagger (lo que hayas puesto en
-- config.AutoLoadStagger al crear la ventana); pasalo explícito acá
-- para pisar eso en una llamada puntual: Window:LoadConfig("x", 0.3).
function UI:LoadConfig(name, stagger)
	name = name or "default"
	if stagger == nil then stagger = self._loadStagger or 0 end

	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		warn("[AzucarLegit] Tu ejecutor no tiene readfile/isfile — no se puede cargar la config.")
		return false
	end

	local path = UI.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then
		return false -- primera vez: no hay nada guardado todavía, no es un error
	end

	local okRead, raw = pcall(readfile, path)
	if not okRead then
		warn("[AzucarLegit] No se pudo leer el archivo de config.")
		return false
	end

	local okJson, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(raw)
	end)
	if not okJson or typeof(data) ~= "table" then
		warn("[AzucarLegit] La config guardada está corrupta o vacía.")
		return false
	end

	-- Orden: primero los Flags cuya PRIMERA LETRA está en self._loadOrder
	-- (config.AutoLoadOrder, ej. {"M", "F"} → los que arrancan con M
	-- primero, después los que arrancan con F), y recién después todo
	-- lo demás. Dentro de un mismo grupo, alfabético, para que quede
	-- predecible entre una carga y la siguiente. La config guardada no
	-- recuerda en qué orden creaste los controles, así que esto es lo
	-- más parecido que se puede ofrecer a un orden elegido.
	local order = self._loadOrder
	local function priority(flag)
		if typeof(order) == "table" then
			local first = flag:sub(1, 1):upper()
			for i, letter in ipairs(order) do
				if typeof(letter) == "string" and first == letter:sub(1, 1):upper() then
					return i
				end
			end
		end
		return math.huge -- no está en la lista: va al final
	end

	local flags = {}
	for flag in pairs(data) do
		if not isIgnoredFlag(flag) then
			table.insert(flags, flag)
		end
	end
	table.sort(flags, function(a, b)
		local pa, pb = priority(a), priority(b)
		if pa ~= pb then return pa < pb end
		return a < b
	end)

	-- Mientras se aplican los valores guardados, ningún :Set() de acá
	-- adentro vuelve a disparar un guardado (ver setFlagValue). Se
	-- restaura SIEMPRE, incluso si algo de acá abajo tira error.
	loadingConfig = true
	local ok = pcall(function()
		for i, flag in ipairs(flags) do
			local value = data[flag]
			local controller = UI.Flags[flag]
			if controller and typeof(controller.Set) == "function" then
				if typeof(value) == "table" and value.__keycode then
					local okKey, keyCode = pcall(function()
						return Enum.KeyCode[value.__keycode]
					end)
					if okKey and keyCode then
						controller:Set(keyCode)
					end
				else
					pcall(function() controller:Set(value) end)
				end
			end
			-- Pausa DESPUÉS de cada uno, salvo el último (no tiene sentido
			-- esperar cuando ya no queda nada más por aplicar).
			if stagger > 0 and i < #flags then
				task.wait(stagger)
			end
		end
	end)
	loadingConfig = false
	if not ok then
		warn("[AzucarLegit] Ocurrió un error aplicando la config guardada.")
		return false
	end
	return true
end

-- Nombres de configs guardadas (sin ".json"), por ejemplo para armar un
-- Dropdown de "qué config cargar".
function UI:ListConfigs()
	if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" then
		return {}
	end
	if not isfolder(UI.ConfigFolder) then
		return {}
	end

	local names = {}
	local okList, files = pcall(listfiles, UI.ConfigFolder)
	if not okList then
		return names
	end

	for _, path in ipairs(files) do
		local fname = path:match("([^/\\]+)%.json$")
		if fname then
			table.insert(names, fname)
		end
	end
	return names
end

return UI
