-- ============================================================
--  AzucarUI Library
--  Tabs laterales izquierda, panel desplegable debajo
--  Hora Colombia (UTC-5), tema negro/rojo/blanco
-- ============================================================

local AzucarUI = {}
AzucarUI.__index = AzucarUI

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local CoreGui          = game:GetService("CoreGui")

-- Colores
local C = {
    BG        = Color3.fromRGB(10, 10, 10),
    BG2       = Color3.fromRGB(18, 18, 18),
    BG3       = Color3.fromRGB(25, 25, 25),
    Line      = Color3.fromRGB(180, 0, 0),
    LineHover = Color3.fromRGB(230, 30, 30),
    Accent    = Color3.fromRGB(200, 0, 0),
    AccentOff = Color3.fromRGB(60, 60, 60),
    Text      = Color3.fromRGB(255, 255, 255),
    TextDim   = Color3.fromRGB(160, 160, 160),
    Border    = Color3.fromRGB(35, 35, 35),
    Toggle_ON = Color3.fromRGB(200, 0, 0),
    Toggle_OFF= Color3.fromRGB(50, 50, 50),
}

local TWEEN_INFO  = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_FAST  = TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TAB_H       = 36   -- altura de cada tab-línea
local TAB_W_CLOSED= 160  -- ancho línea cerrada
local TAB_W_OPEN  = 220  -- ancho línea abierta (extended)
local PANEL_W     = 320  -- ancho panel de contenido
local HEADER_H    = 34   -- altura header superior
local ITEM_H      = 36   -- altura de cada item
local PADDING     = 10

-- Hora Colombia (UTC-5)
local function getColombiaTime()
    local utc   = os.time()
    local co    = utc - (5 * 3600)
    local h     = math.floor(co / 3600) % 24
    local m     = math.floor(co / 60) % 60
    local s     = co % 60
    local ampm  = h >= 12 and "PM" or "AM"
    h = h % 12; if h == 0 then h = 12 end
    return string.format("%02d:%02d:%02d %s", h, m, s, ampm)
end

-- Utilidades UI
local function makePart(parent, props)
    local f = Instance.new("Frame")
    f.BorderSizePixel = 0
    f.BackgroundColor3 = C.BG
    for k, v in pairs(props or {}) do f[k] = v end
    f.Parent = parent
    return f
end

local function makeLabel(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.TextColor3  = C.Text
    l.Font        = Enum.Font.GothamBold
    l.TextSize    = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    for k, v in pairs(props or {}) do l[k] = v end
    l.Parent = parent
    return l
end

local function makeButton(parent, props)
    local b = Instance.new("TextButton")
    b.BorderSizePixel = 0
    b.BackgroundColor3 = C.BG3
    b.TextColor3  = C.Text
    b.Font        = Enum.Font.Gotham
    b.TextSize    = 13
    b.AutoButtonColor = false
    for k, v in pairs(props or {}) do b[k] = v end
    b.Parent = parent
    return b
end

local function corner(inst, r)
    local c2 = Instance.new("UICorner")
    c2.CornerRadius = UDim.new(0, r or 4)
    c2.Parent = inst
    return c2
end

local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color     = color or C.Border
    s.Thickness = thickness or 1
    s.Parent    = inst
    return s
end

local function tween(inst, props, info)
    TweenService:Create(inst, info or TWEEN_INFO, props):Play()
end

-- Drag para frames
local function makeDraggable(handle, target)
    local dragging, dragInput, dragStart, startPos = false
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = i.Position
            startPos  = target.Position
        end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

-- ============================================================
--  CreateWindow
-- ============================================================
function AzucarUI:CreateWindow(opts)
    opts = opts or {}
    local title   = opts.Title   or "AzucarUI"
    local toggleK = opts.ToggleKey or Enum.KeyCode.RightShift

    -- Root ScreenGui
    local sg = Instance.new("ScreenGui")
    sg.Name            = "AzucarUI_" .. title
    sg.ResetOnSpawn    = false
    sg.IgnoreGuiInset  = true
    sg.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder    = 999
    pcall(function() sg.Parent = CoreGui end)

    -- Contenedor raíz (draggable)
    local root = makePart(sg, {
        BackgroundColor3 = C.BG,
        Position = UDim2.new(0, 30, 0, 60),
        Size     = UDim2.new(0, TAB_W_CLOSED, 0, HEADER_H),
        ClipsDescendants = false,
    })
    corner(root, 6)
    stroke(root, C.Border, 1)
    root.ZIndex = 2

    -- Header (hora + título)
    local header = makePart(root, {
        BackgroundColor3 = Color3.fromRGB(6, 6, 6),
        Size     = UDim2.new(1, 0, 0, HEADER_H),
        Position = UDim2.new(0, 0, 0, 0),
    })
    corner(header, 6)

    local titleLbl = makeLabel(header, {
        Text     = title,
        Size     = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, PADDING, 0, 0),
        TextSize = 12,
        Font     = Enum.Font.GothamBold,
        TextColor3 = C.Accent,
    })

    local timeLbl = makeLabel(header, {
        Text     = getColombiaTime(),
        Size     = UDim2.new(0.5, -PADDING, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 11,
        Font     = Enum.Font.RobotoMono,
        TextColor3 = C.TextDim,
    })

    -- Actualizar hora cada segundo
    RunService.Heartbeat:Connect(function()
        pcall(function() timeLbl.Text = getColombiaTime() end)
    end)

    -- Lista de tabs (scrollable)
    local tabList = Instance.new("Frame")
    tabList.Name                = "TabList"
    tabList.BackgroundTransparency = 1
    tabList.BorderSizePixel     = 0
    tabList.Position            = UDim2.new(0, 0, 0, HEADER_H + 4)
    tabList.Size                = UDim2.new(1, 0, 0, 0)
    tabList.ClipsDescendants    = false
    tabList.Parent              = root

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.SortOrder   = Enum.SortOrder.LayoutOrder
    tabLayout.Padding     = UDim.new(0, 3)
    tabLayout.Parent      = tabList

    makeDraggable(header, root)

    -- Toggle visibilidad
    local visible = true
    UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == toggleK then
            visible = not visible
            root.Visible = visible
        end
    end)

    -- Estado ventana
    local win = {
        _sg       = sg,
        _root     = root,
        _tabList  = tabList,
        _tabLayout= tabLayout,
        _tabs     = {},
        _openTab  = nil,
        _tabCount = 0,
    }

    -- Ajustar altura del contenedor según tabs
    local function refreshHeight()
        local maxH = math.min(win._tabCount * (TAB_H + 3), 500)
        tabList.Size         = UDim2.new(1, 0, 0, maxH)
        root.Size            = UDim2.new(0, TAB_W_CLOSED, 0, HEADER_H + 4 + maxH + 4)
    end
    win._refreshHeight = refreshHeight

    return setmetatable(win, {__index = AzucarUI})
end

-- ============================================================
--  CreateTab
-- ============================================================
function AzucarUI:CreateTab(opts)
    opts = opts or {}
    local name  = opts.Name or "Tab"
    self._tabCount = self._tabCount + 1

    -- Línea-tab
    local tabBtn = makeButton(self._tabList, {
        BackgroundColor3 = C.BG2,
        Size     = UDim2.new(1, 0, 0, TAB_H),
        Text     = "",
        LayoutOrder = self._tabCount,
    })
    corner(tabBtn, 4)

    -- Línea acento izquierda
    local accent = makePart(tabBtn, {
        BackgroundColor3 = C.AccentOff,
        Size     = UDim2.new(0, 3, 1, -8),
        Position = UDim2.new(0, 0, 0, 4),
    })
    corner(accent, 2)

    -- Nombre del tab
    local nameLbl = makeLabel(tabBtn, {
        Text     = name,
        Size     = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        TextSize = 13,
    })

    -- Flecha indicador
    local arrow = makeLabel(tabBtn, {
        Text     = "›",
        Size     = UDim2.new(0, 16, 1, 0),
        Position = UDim2.new(1, -18, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextSize = 16,
        TextColor3 = C.TextDim,
    })

    -- Panel de contenido (debajo del tab)
    local panel = makePart(self._root, {
        BackgroundColor3 = C.BG2,
        Position = UDim2.new(0, TAB_W_CLOSED + 6, 0, 0),
        Size     = UDim2.new(0, PANEL_W, 1, 0),
        ClipsDescendants = true,
        Visible  = false,
    })
    corner(panel, 6)
    stroke(panel, C.Border, 1)

    -- Header del panel
    local pHeader = makePart(panel, {
        BackgroundColor3 = Color3.fromRGB(6, 6, 6),
        Size     = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 0),
    })
    corner(pHeader, 6)
    makeLabel(pHeader, {
        Text     = name,
        Size     = UDim2.new(1, -PADDING*2, 1, 0),
        Position = UDim2.new(0, PADDING, 0, 0),
        TextSize = 12,
        TextColor3 = C.Accent,
    })

    -- ScrollingFrame del contenido
    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel     = 0
    scroll.Position            = UDim2.new(0, 0, 0, 34)
    scroll.Size                = UDim2.new(1, 0, 1, -34)
    scroll.CanvasSize          = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollBarThickness  = 2
    scroll.ScrollBarImageColor3 = C.Accent
    scroll.Parent              = panel

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding   = UDim.new(0, 2)
    layout.Parent    = scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft   = UDim.new(0, 8)
    pad.PaddingRight  = UDim.new(0, 8)
    pad.Parent        = scroll

    local itemCount = 0

    -- Lógica apertura/cierre
    local isOpen = false
    local function openTab()
        if self._openTab and self._openTab ~= tabBtn then
            self._openTab._close()
        end
        isOpen = true
        self._openTab = tabBtn
        tabBtn._close = function()
            isOpen = false
            panel.Visible = false
            tween(accent, {BackgroundColor3 = C.AccentOff})
            tabBtn.BackgroundColor3 = C.BG2
            tabBtn.BackgroundTransparency = 0
            arrow.Text = "›"
            self._openTab = nil
        end
        panel.Visible = true
        tween(accent, {BackgroundColor3 = Color3.fromRGB(255, 30, 30)})
        tabBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        tabBtn.BackgroundTransparency = 0.45
        arrow.Text = "‹"
        -- Posicionar el panel a la altura del tab
        local tabPos = tabBtn.AbsolutePosition
        local rootPos = self._root.AbsolutePosition
        local relY = tabPos.Y - rootPos.Y
        panel.Position = UDim2.new(0, TAB_W_CLOSED + 6, 0, relY)
        panel.Size = UDim2.new(0, PANEL_W, 0, math.max(200, math.min(itemCount * (ITEM_H + 2) + 60, 420)))
    end

    tabBtn.MouseButton1Click:Connect(function()
        if isOpen then
            tabBtn._close()
        else
            openTab()
        end
    end)

    tabBtn.MouseEnter:Connect(function()
        if not isOpen then
            tabBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            tabBtn.BackgroundTransparency = 0
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if not isOpen then
            tabBtn.BackgroundColor3 = C.BG2
            tabBtn.BackgroundTransparency = 0
        end
    end)

    self._refreshHeight()

    -- Objeto Tab
    local tab = {
        _panel    = panel,
        _scroll   = scroll,
        _itemCount = 0,
    }

    -- Helper para crear item base
    local function newItem(h)
        tab._itemCount = tab._itemCount + 1
        itemCount      = itemCount + 1
        local f = makePart(scroll, {
            BackgroundColor3 = C.BG3,
            BackgroundTransparency = 0.35,
            Size     = UDim2.new(1, 0, 0, h or ITEM_H),
            LayoutOrder = tab._itemCount,
        })
        corner(f, 4)
        return f
    end

    -- ── Sección Label ────────────────────────────────────────
    function tab:CreateSectionLabel(text)
        local f = newItem(22)
        f.BackgroundTransparency = 1
        f.Size = UDim2.new(1, 0, 0, 22)
        makeLabel(f, {
            Text     = text,
            Size     = UDim2.new(1, -8, 1, 0),
            Position = UDim2.new(0, 8, 0, 0),
            TextSize = 11,
            TextColor3 = C.Accent,
            Font     = Enum.Font.GothamBold,
        })
        local line = makePart(f, {
            BackgroundColor3 = C.Accent,
            Size     = UDim2.new(1, -8, 0, 1),
            Position = UDim2.new(0, 4, 1, -1),
        })
        line.BackgroundTransparency = 0.6
    end

    -- ── Toggle ───────────────────────────────────────────────
    function tab:CreateToggle(opts2)
        opts2 = opts2 or {}
        local f   = newItem(ITEM_H)
        local val = opts2.Default or false
        makeLabel(f, {
            Text     = opts2.Name or "Toggle",
            Size     = UDim2.new(1, -50, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            TextSize = 13,
        })
        -- Track (fondo toggle)
        local track = makePart(f, {
            BackgroundColor3 = val and C.Toggle_ON or C.Toggle_OFF,
            BackgroundTransparency = 0.2,
            Size     = UDim2.new(0, 36, 0, 18),
            Position = UDim2.new(1, -46, 0.5, -9),
        })
        corner(track, 9)
        -- Knob
        local knob = makePart(track, {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size     = UDim2.new(0, 12, 0, 12),
            Position = val and UDim2.new(0, 21, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
        })
        corner(knob, 6)
        local function setVal(v)
            val = v
            tween(track, {BackgroundColor3 = v and C.Toggle_ON or C.Toggle_OFF})
            tween(knob,  {Position = v and UDim2.new(0,21,0.5,-6) or UDim2.new(0,3,0.5,-6)})
            if opts2.Callback then pcall(opts2.Callback, v) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then setVal(not val) end
        end)
        f.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then setVal(not val) end
        end)
        -- API
        local obj = {}
        function obj:Set(v) setVal(v) end
        function obj:Get() return val end
        if opts2.Flag then _G["AZUI_" .. opts2.Flag] = obj end
        return obj
    end

    -- ── Slider ───────────────────────────────────────────────
    function tab:CreateSlider(opts2)
        opts2 = opts2 or {}
        local f      = newItem(ITEM_H + 16)
        local range  = opts2.Range or {0, 100}
        local incr   = opts2.Increment or 1
        local val    = opts2.CurrentValue or range[1]
        local minV, maxV = range[1], range[2]

        local nameLbl2 = makeLabel(f, {
            Text     = (opts2.Name or "Slider") .. ": " .. tostring(val),
            Size     = UDim2.new(1, -10, 0, 18),
            Position = UDim2.new(0, 10, 0, 4),
            TextSize = 12,
        })
        -- Track
        local track2 = makePart(f, {
            BackgroundColor3 = Color3.fromRGB(35, 35, 35),
            Size     = UDim2.new(1, -20, 0, 6),
            Position = UDim2.new(0, 10, 0, 28),
        })
        corner(track2, 3)
        -- Fill
        local fill = makePart(track2, {
            BackgroundColor3 = C.Accent,
            Size     = UDim2.new((val - minV) / (maxV - minV), 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
        })
        corner(fill, 3)
        -- Knob
        local knob2 = makePart(track2, {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size     = UDim2.new(0, 10, 0, 10),
            Position = UDim2.new((val - minV) / (maxV - minV), -5, 0.5, -5),
        })
        corner(knob2, 5)

        local sliding = false
        local function updateSlider(inputX)
            local abs  = track2.AbsolutePosition.X
            local absW = track2.AbsoluteSize.X
            local pct  = math.clamp((inputX - abs) / absW, 0, 1)
            local raw  = minV + pct * (maxV - minV)
            -- snap al increment
            local snapped = math.round(raw / incr) * incr
            snapped = math.clamp(snapped, minV, maxV)
            -- redondear a decimales del increment
            local dec = tostring(incr):find("%.") and #(tostring(incr):match("%.(.*)") or "") or 0
            val = tonumber(string.format("%." .. dec .. "f", snapped))
            local p = (val - minV) / (maxV - minV)
            fill.Size     = UDim2.new(p, 0, 1, 0)
            knob2.Position = UDim2.new(p, -5, 0.5, -5)
            nameLbl2.Text = (opts2.Name or "Slider") .. ": " .. tostring(val)
            if opts2.Callback then pcall(opts2.Callback, val) end
        end

        track2.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                sliding = true; updateSlider(i.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
        end)

        local obj = {}
        function obj:Set(v)
            val = math.clamp(v, minV, maxV)
            local p = (val - minV) / (maxV - minV)
            fill.Size      = UDim2.new(p, 0, 1, 0)
            knob2.Position  = UDim2.new(p, -5, 0.5, -5)
            nameLbl2.Text  = (opts2.Name or "Slider") .. ": " .. tostring(val)
            if opts2.Callback then pcall(opts2.Callback, val) end
        end
        function obj:Get() return val end
        if opts2.Flag then _G["AZUI_" .. opts2.Flag] = obj end
        return obj
    end

    -- ── Button ───────────────────────────────────────────────
    function tab:CreateButton(opts2)
        opts2 = opts2 or {}
        local f = newItem(ITEM_H)
        f.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        f.BackgroundTransparency = 0.6
        stroke(f, C.Accent, 1)
        local lbl = makeLabel(f, {
            Text     = opts2.Name or "Button",
            Size     = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            TextSize = 13,
        })
        local btn = makeButton(f, {
            BackgroundTransparency = 1,
            Size     = UDim2.new(1, 0, 1, 0),
            Text     = "",
        })
        btn.MouseEnter:Connect(function()
            f.BackgroundTransparency = 0.35
        end)
        btn.MouseLeave:Connect(function()
            f.BackgroundTransparency = 0.6
        end)
        btn.MouseButton1Click:Connect(function()
            if opts2.Callback then pcall(opts2.Callback) end
        end)
    end

    -- ── Dropdown ─────────────────────────────────────────────
    function tab:CreateDropdown(opts2)
        opts2 = opts2 or {}
        local options = opts2.Options or {}
        local multi   = opts2.Multi   or false
        local selected = {}
        if opts2.Default then
            if type(opts2.Default) == "table" then
                for _, v in ipairs(opts2.Default) do selected[v] = true end
            else selected[opts2.Default] = true end
        end

        local f = newItem(ITEM_H)
        f.ClipsDescendants = false

        local function selectedText()
            local t = {}
            for k in pairs(selected) do table.insert(t, k) end
            return #t > 0 and table.concat(t, ", ") or "Seleccionar"
        end

        makeLabel(f, {
            Text     = opts2.Name or "Dropdown",
            Size     = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            TextSize = 13,
        })
        local valLbl = makeLabel(f, {
            Text     = selectedText(),
            Size     = UDim2.new(0.45, 0, 1, 0),
            Position = UDim2.new(0.52, 0, 0, 0),
            TextSize = 12,
            TextColor3 = C.Accent,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
        local arrow2 = makeLabel(f, {
            Text     = "▾",
            Size     = UDim2.new(0, 16, 1, 0),
            Position = UDim2.new(1, -18, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            TextSize = 13,
            TextColor3 = C.TextDim,
        })

        -- Lista dropdown
        local list = makePart(f, {
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            Size     = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 1, 2),
            ClipsDescendants = true,
            ZIndex   = 10,
            Visible  = false,
        })
        corner(list, 4)
        stroke(list, C.Border, 1)

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Parent    = list

        local isOpen2 = false
        local function closeList()
            isOpen2 = false
            tween(list, {Size = UDim2.new(1, 0, 0, 0)}, TWEEN_FAST)
            task.wait(0.1); list.Visible = false
            arrow2.Text = "▾"
        end

        for _, opt in ipairs(options) do
            local row = makeButton(list, {
                BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                Size     = UDim2.new(1, 0, 0, 28),
                Text     = "",
                ZIndex   = 11,
            })
            local rowLbl = makeLabel(row, {
                Text     = opt,
                Size     = UDim2.new(1, -10, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                TextSize = 12,
                ZIndex   = 12,
                TextColor3 = selected[opt] and C.Accent or C.Text,
            })
            row.MouseButton1Click:Connect(function()
                if multi then
                    selected[opt] = not selected[opt]
                    rowLbl.TextColor3 = selected[opt] and C.Accent or C.Text
                else
                    selected = {[opt] = true}
                    for _, r in ipairs(list:GetChildren()) do
                        if r:IsA("TextButton") then
                            local l2 = r:FindFirstChildOfClass("TextLabel")
                            if l2 then l2.TextColor3 = C.Text end
                        end
                    end
                    rowLbl.TextColor3 = C.Accent
                    closeList()
                end
                valLbl.Text = selectedText()
                if opts2.Callback then
                    if multi then pcall(opts2.Callback, selected)
                    else pcall(opts2.Callback, opt) end
                end
            end)
            row.MouseEnter:Connect(function() tween(row, {BackgroundColor3 = Color3.fromRGB(30,30,30)}) end)
            row.MouseLeave:Connect(function() tween(row, {BackgroundColor3 = Color3.fromRGB(20,20,20)}) end)
        end

        f.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if isOpen2 then closeList()
            else
                isOpen2 = true; list.Visible = true
                local h = math.min(#options * 28, 140)
                tween(list, {Size = UDim2.new(1, 0, 0, h)}, TWEEN_FAST)
                arrow2.Text = "▴"
            end
        end)

        local obj = {}
        function obj:Set(v)
            if type(v) == "table" then selected = {}; for _, k in ipairs(v) do selected[k] = true end
            else selected = {[v] = true} end
            valLbl.Text = selectedText()
        end
        function obj:Get() return selected end
        if opts2.Flag then _G["AZUI_" .. opts2.Flag] = obj end
        return obj
    end

    -- ── Colorpicker (simple hex input) ───────────────────────
    function tab:CreateColorPicker(opts2)
        opts2   = opts2 or {}
        local f = newItem(ITEM_H)
        local val = opts2.Default or Color3.fromRGB(255, 0, 0)
        makeLabel(f, {
            Text     = opts2.Name or "Color",
            Size     = UDim2.new(0.6, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            TextSize = 13,
        })
        local preview = makePart(f, {
            BackgroundColor3 = val,
            Size     = UDim2.new(0, 26, 0, 20),
            Position = UDim2.new(1, -34, 0.5, -10),
        })
        corner(preview, 4)
        stroke(preview, C.Border, 1)
        local obj = {}
        function obj:Set(c) val = c; preview.BackgroundColor3 = c; if opts2.Callback then pcall(opts2.Callback, c) end end
        function obj:Get() return val end
        return obj
    end

    -- ── TextBox ──────────────────────────────────────────────
    function tab:CreateTextBox(opts2)
        opts2   = opts2 or {}
        local f = newItem(ITEM_H + 4)
        makeLabel(f, {
            Text     = opts2.Name or "Input",
            Size     = UDim2.new(0.4, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            TextSize = 12,
        })
        local box = Instance.new("TextBox")
        box.BackgroundColor3     = Color3.fromRGB(22, 22, 22)
        box.BorderSizePixel      = 0
        box.Size                 = UDim2.new(0.55, 0, 0, 24)
        box.Position             = UDim2.new(0.43, 0, 0.5, -12)
        box.Text                 = opts2.Default or ""
        box.PlaceholderText      = opts2.Placeholder or "..."
        box.TextColor3           = C.Text
        box.PlaceholderColor3    = C.TextDim
        box.Font                 = Enum.Font.Gotham
        box.TextSize             = 12
        box.ClearTextOnFocus     = opts2.ClearOnFocus ~= false
        box.Parent               = f
        corner(box, 4)
        stroke(box, C.Border, 1)
        box.FocusLost:Connect(function(enter)
            if enter and opts2.Callback then pcall(opts2.Callback, box.Text) end
        end)
        local obj = {}
        function obj:Set(v) box.Text = v end
        function obj:Get() return box.Text end
        return obj
    end

    -- ── Keybind ──────────────────────────────────────────────
    function tab:CreateKeybind(opts2)
        opts2   = opts2 or {}
        local f = newItem(ITEM_H)
        local key = opts2.Default or Enum.KeyCode.Unknown
        local listening = false
        makeLabel(f, {
            Text     = opts2.Name or "Keybind",
            Size     = UDim2.new(0.6, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            TextSize = 13,
        })
        local btn2 = makeButton(f, {
            BackgroundColor3 = Color3.fromRGB(22, 22, 22),
            Size     = UDim2.new(0, 80, 0, 22),
            Position = UDim2.new(1, -88, 0.5, -11),
            Text     = tostring(key.Name or key),
            TextColor3 = C.Accent,
            TextSize = 11,
        })
        corner(btn2, 4)
        stroke(btn2, C.Border, 1)
        btn2.MouseButton1Click:Connect(function()
            listening = true; btn2.Text = "..."
        end)
        UserInputService.InputBegan:Connect(function(i, gp)
            if not listening then return end
            if i.UserInputType == Enum.UserInputType.Keyboard then
                key = i.KeyCode; listening = false
                btn2.Text = tostring(key.Name)
                if opts2.Callback then pcall(opts2.Callback, key) end
            end
        end)
        local obj = {}
        function obj:Get() return key end
        return obj
    end

    -- ── Notify (método global) ────────────────────────────────
    function tab:Notify() end  -- placeholder, usar AzucarUI:Notify()

    return tab
end

-- ============================================================
--  Notify global
-- ============================================================
local _notifySG = nil
local _notifyList = nil

local function ensureNotify()
    if _notifySG then return end
    _notifySG = Instance.new("ScreenGui")
    _notifySG.Name           = "AzucarUI_Notify"
    _notifySG.ResetOnSpawn   = false
    _notifySG.IgnoreGuiInset = true
    _notifySG.DisplayOrder   = 1000
    pcall(function() _notifySG.Parent = CoreGui end)

    _notifyList = Instance.new("Frame")
    _notifyList.BackgroundTransparency = 1
    _notifyList.AnchorPoint = Vector2.new(1, 1)
    _notifyList.Position    = UDim2.new(1, -16, 1, -16)
    _notifyList.Size        = UDim2.new(0, 260, 1, 0)
    _notifyList.Parent      = _notifySG

    local nl = Instance.new("UIListLayout")
    nl.SortOrder         = Enum.SortOrder.LayoutOrder
    nl.VerticalAlignment = Enum.VerticalAlignment.Bottom
    nl.Padding           = UDim.new(0, 6)
    nl.Parent            = _notifyList
end

function AzucarUI:Notify(opts)
    opts = opts or {}
    ensureNotify()
    local title   = opts.Title   or "Azucar"
    local content = opts.Content or ""
    local dur     = opts.Duration or 3

    local card = makePart(_notifyList, {
        BackgroundColor3 = Color3.fromRGB(14, 14, 14),
        Size     = UDim2.new(1, 0, 0, 58),
        Position = UDim2.new(1, 0, 0, 0),
    })
    corner(card, 6)
    stroke(card, C.Border, 1)

    local bar = makePart(card, {
        BackgroundColor3 = C.Accent,
        Size     = UDim2.new(0, 3, 1, -8),
        Position = UDim2.new(0, 0, 0, 4),
    })
    corner(bar, 2)

    makeLabel(card, {
        Text     = title,
        Size     = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 14, 0, 6),
        TextSize = 12,
        Font     = Enum.Font.GothamBold,
        TextColor3 = C.Accent,
    })
    makeLabel(card, {
        Text     = content,
        Size     = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 14, 0, 28),
        TextSize = 11,
        Font     = Enum.Font.Gotham,
        TextColor3 = C.TextDim,
    })

    -- Progress bar
    local prog = makePart(card, {
        BackgroundColor3 = C.Accent,
        Size     = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
    })
    prog.BackgroundTransparency = 0.3

    tween(card, {Position = UDim2.new(0, 0, 0, 0)}, TWEEN_FAST)
    tween(prog, {Size = UDim2.new(0, 0, 0, 2)}, TweenInfo.new(dur, Enum.EasingStyle.Linear))

    task.delay(dur, function()
        tween(card, {Position = UDim2.new(1, 10, 0, 0)}, TWEEN_FAST)
        task.wait(0.2)
        card:Destroy()
    end)
end

return AzucarUI
