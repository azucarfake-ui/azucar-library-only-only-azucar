local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)
	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarLegit] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else
				warn("[AzucarLegit] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

-- Guarda el valor de una Flag sin reventar si el control no tiene Flag
-- (tabla[nil] = valor tira error en Lua y mataría el hilo ahí mismo).
-- `skipSave`: para el slider mientras arrastrás (ver CreateSlider). Sin
-- esto, escribir el archivo en cada pixel de un arrastre podía dejar el
-- valor guardado a medio camino o corrompido si el ejecutor no llegaba
-- a terminar una escritura antes de que empezara la siguiente.
local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	-- Guarda DE INMEDIATO, sin ningún temporizador de por medio (salvo
	-- que se pida lo contrario con skipSave). Antes había un retraso de
	-- 0.6s para no escribir el archivo en cada pixel de un arrastre,
	-- pero si volvías a ejecutar el script antes de ese medio segundo,
	-- muchos ejecutores matan esa espera pendiente y el guardado nunca
	-- llegaba a pasar. Ahora el archivo queda escrito ANTES de que esta
	-- función termine. (Salvo mientras se está CARGANDO una config: ahí
	-- no hace falta reescribir el mismo archivo que se acaba de leer.)
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do
			UI:SaveConfig(name)
		end
	end
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

-- Todas las filas (Toggle/Slider/Botón/...) se agregan adentro de
-- self.List — la columna de contenido que vive DENTRO del acordeón de
-- la pestaña. Si alguien crea un control directo sobre la ventana (sin
-- pasar por CreateTab), se avisa y se cuelga en la primera pestaña para
-- no perderlo.
local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		warn("[AzucarLegit] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	CREATE WINDOW  ← ÚNICA parte visual que cambió (ventana/cabecera)
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	-- config.Theme = "Negro" o "Blanco" (además del "Rojo" que ya
	-- tenías): elige el estilo completo ANTES de dibujar nada, así todo
	-- sale ya con esos colores desde el primer frame.
	if config.Theme ~= nil then
		UI:SetTheme(config.Theme)
	end

	local title      = config.Title or config.Name or "Azúcar Hub"
	local SIDEBAR_W  = config.Width or config.SidebarWidth or 175
	local HEADER_H   = 46
	local TOP_Y      = config.TopOffset or 0
	local BOTTOM_MARGIN = config.BottomMargin or 0
	local RADIUS     = 14

	-- La ventana con las lógicas ya NO es la línea estirada: es una
	-- tarjeta aparte, con esquinas redondas, que aparece cerca de las
	-- pestañas (ni pegada, ni al otro extremo de la pantalla) y
	-- centrada verticalmente.
	-- Ancho de la tarjeta: ocupa el espacio que hay hacia la derecha
	-- (hasta PANEL_MARGIN px del borde de la pantalla) pero con un TOPE
	-- de PANEL_WIDTH_PX (constante al principio del archivo), y se
	-- achica sola si la pantalla es más angosta.
	-- config.PanelWidth ya no fija el ancho: si tu script lo pasa, se
	-- ignora; usá config.PanelMaxWidth.
	local PANEL_MAX_W  = config.PanelMaxWidth or PANEL_WIDTH_PX
	local PANEL_MARGIN = config.PanelRightMargin or 20
	if config.PanelWidth ~= nil then
		warn("[AzucarLegit] PanelWidth ya no fija el ancho: la tarjeta ocupa todo el espacio "
			.. "hacia la derecha. Si querés un tope, usá PanelMaxWidth.")
	end
	local PANEL_H   = config.PanelHeight or 480
	local PANEL_GAP = config.PanelGap or 30
	local PANEL_X   = SIDEBAR_W + PANEL_GAP

	-- Por defecto la ventana se para POR ENCIMA de la barra superior de
	-- Roblox (más arriba en la pantalla). Si en algún juego te tapa
	-- algo, pasá config.IgnoreGuiInset = false para volver a respetarla.
	local ignoreInset = true
	if config.IgnoreGuiInset == false then
		ignoreInset = false
	end

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarLegit",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = ignoreInset,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("AzucarLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	-- ---------------- Cabecera: título + reloj (apilados, angosta) ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(0, SIDEBAR_W, 0, HEADER_H),
		Position = UDim2.new(0, 0, 0, TOP_Y),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(RADIUS), stroke(Theme.Border, 1) })

	local TitleLabel = new("TextLabel", {
		Text = title,
		Font = Theme.FontBold,
		TextSize = 13 + FONT_BOOST,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 4),
		Size = UDim2.new(1, -20, 0, 18),
		Parent = Header,
	})

	-- El reloj usa la hora de TU PC (os.date), así que ya sale en el
	-- horario de tu país sin tener que configurar ningún huso horario.
	local ClockLabel = new("TextLabel", {
		Name = "Clock",
		Text = os.date("%H:%M:%S"),
		Font = Theme.FontBold,
		TextSize = 13 + FONT_BOOST,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 22),
		Size = UDim2.new(1, -20, 0, 18),
		Parent = Header,
	})
	onAccent(function()
		if ClockLabel.Parent then ClockLabel.TextColor3 = Theme.Active end
	end)

	task.spawn(function()
		while ClockLabel.Parent do
			ClockLabel.Text = os.date("%H:%M:%S")
			task.wait(1)
		end
	end)

	-- ---------------- Lista de pestañas (las "líneas") ----------------
	-- ScrollingFrame SIN barra: si hay más pestañas de las que entran en
	-- la pantalla, bajás/subís con la rueda del mouse, arrastrando con el
	-- mouse, o con el dedo en el celular. La barrita está apagada.
	local SlideList = new("ScrollingFrame", {
		Name = "SlideList",
		Size = UDim2.new(0, SIDEBAR_W, 1, -(TOP_Y + HEADER_H + 8 + BOTTOM_MARGIN)),
		Position = UDim2.new(0, 0, 0, TOP_Y + HEADER_H + 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollBarImageTransparency = 1,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		Parent = Root,
	})

	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = SlideList,
	})

	-- Un poquito de margen para que el borde (UIStroke) de las pestañas
	-- no quede cortado por el recorte del scroll, y aire abajo para que
	-- la última pestaña se pueda subir bien.
	new("UIPadding", {
		-- 10px de margen a cada lado: ahí adentro entra la aurita de la
		-- pestaña sin que el recorte del scroll la corte.
		PaddingTop = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 14),
		PaddingLeft = UDim.new(0, 10),
		Parent = SlideList,
	})

	local EmptyHint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Sin pestañas todavía.\nUsá Window:CreateTab({ Name = \"...\" }).",
		Font = Theme.Font,
		TextSize = 12 + FONT_BOOST,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 70),
		Parent = SlideList,
	}, { corner(RADIUS), stroke(Theme.Border, 1), pad(10) })

	-- Desenfoque del mundo de atrás (BlurEffect en Lighting). Arranca en
	-- 0 y solo sube mientras hay una pestaña abierta. config.Blur = false
	-- lo desactiva; config.BlurSize cambia la fuerza.
	local blur = nil
	if config.Blur ~= false and (config.BlurSize or BLUR_SIZE) > 0 then
		pcall(function()
			local Lighting = game:GetService("Lighting")
			local old = Lighting:FindFirstChild("AzucarLegitBlur")
			if old then old:Destroy() end
			blur = Instance.new("BlurEffect")
			blur.Name = "AzucarLegitBlur"
			blur.Size = 0
			blur.Parent = Lighting
		end)
	end

	local Window = setmetatable({
		ScreenGui  = ScreenGui,
		Root       = Root,
		Header     = Header,
		TitleLabel = TitleLabel,
		ClockLabel = ClockLabel,
		SlideList  = SlideList,
		EmptyHint  = EmptyHint,
		SIDEBAR_W  = SIDEBAR_W,
		LIST_W     = SIDEBAR_W, -- alias por compatibilidad
		HEADER_H   = HEADER_H,
		TOP_Y      = TOP_Y,
		BOTTOM_MARGIN = BOTTOM_MARGIN,
		TAB_RADIUS = RADIUS,
		PANEL_MAX_W  = PANEL_MAX_W,
		PANEL_MARGIN = PANEL_MARGIN,
		PANEL_H    = PANEL_H,
		PANEL_X    = PANEL_X,
		_tabs        = {},
		_connections = {},
		_visible     = true,
		_loadId      = LOAD_ID,
		_configName  = nil, -- se completa abajo si config.AutoSaveConfig está activo
		_loadStagger = config.AutoLoadStagger or 0, -- pausa entre control y control al cargar
		_loadOrder   = config.AutoLoadOrder, -- ej. {"M", "F"}: esas letras primero, en ese orden
		_blur        = blur,
		_blurSize    = config.BlurSize or BLUR_SIZE,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- ---------------- Scroll de la lista de pestañas ----------------
	-- La rueda del mouse y el dedo (celular) ya scrollean solos. Esto
	-- agrega el arrastre con el MOUSE (mantener y mover hacia arriba o
	-- abajo) y marca cuándo un gesto fue arrastre para que, al soltar,
	-- no cuente como clic sobre la pestaña.
	local dragKind = nil
	local dragStartPos = Vector2.new(0, 0)
	local canvasStartY = 0
	Window._dragMoved = false

	function Window._beginDrag(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		Window._dragMoved = false
		dragKind = kind
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		canvasStartY = SlideList.CanvasPosition.Y
	end

	track(SlideList.InputBegan:Connect(function(input)
		Window._beginDrag(input)
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragKind then return end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then
			return
		end
		local dx = input.Position.X - dragStartPos.X
		local dy = input.Position.Y - dragStartPos.Y
		if math.abs(dx) + math.abs(dy) > 10 then
			Window._dragMoved = true
		end
		-- Con el dedo scrollea el propio ScrollingFrame; con el mouse lo movemos nosotros.
		if dragKind == Enum.UserInputType.MouseButton1 and Window._dragMoved then
			SlideList.CanvasPosition = Vector2.new(0, canvasStartY - dy)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragKind = nil
		end
	end))

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	-- Bucle de efectos animados: solo trabaja con la UI visible y solo
	-- sobre la pestaña que está abierta.
	track(RunService.Heartbeat:Connect(function()
		if not Window._visible then return end
		local now = os.clock()
		for _, tab in ipairs(Window._tabs) do
			if tab._isOpen and tab._fx then
				tab._fx(now)
			end
		end
	end))

	-- Palabras a ignorar del todo para guardar/cargar (ver isIgnoredFlag).
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do
			table.insert(autoSaveIgnore, word)
		end
	end

	-- ---------------- Guardado/carga de configuración ----------------
	-- config.AutoSaveConfig = true (usa el nombre "default") o un
	-- nombre propio ("MiConfig"): guarda solo cada vez que tocás algo
	-- con Flag, y carga esa config apenas termine de armarse toda la UI
	-- (task.defer: se ejecuta después de que tu script cree todas las
	-- pestañas y controles). Si preferís guardar/cargar vos mismo a
	-- mano, no pases esto y usá Window:SaveConfig("nombre") /
	-- Window:LoadConfig("nombre") cuando quieras.
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		Window._configName = autoName
		autoSaveTargets[autoName] = true

		-- config.AutoLoadConfig = false: solo AUTOGUARDA; la carga la
		-- hacés vos a mano (Window:LoadConfig("nombre")) cuando tu
		-- propio script ya esté listo (personaje, remotos, etc.). Útil
		-- si al cargar todo junto de una alguna lógica arranca a medias
		-- por depender de algo que todavía no existe.
		-- config.AutoLoadDelay = segundos: espera antes de aplicar la
		-- config cargada (por defecto 0). Con AutoLoadConfig en su
		-- valor por defecto (true), se sigue cargando sola, solo que
		-- podés darle un respiro antes de que dispare los Callbacks.
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait() -- deja que tu script termine de crear pestañas/controles
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	table.insert(UI.Windows, Window)

	-- Registro global: la próxima carga de la librería usa esta lista
	-- para destruir esta ventana si el script se vuelve a ejecutar.
	local registry = rawget(_G, "__AzucarLegitWindows")
	if typeof(registry) ~= "table" then
		registry = {}
		rawset(_G, "__AzucarLegitWindows", registry)
	end
	table.insert(registry, Window)

	return Window
end

-- Sube o baja el desenfoque del juego de atrás: solo hay desenfoque si
-- la UI está visible Y hay alguna pestaña abierta.
function UI:_updateBlur()
	local blur = self._blur
	if not blur or not blur.Parent then return end

	local anyOpen = false
	for _, tab in ipairs(self._tabs or {}) do
		if tab._isOpen then
			anyOpen = true
			break
		end
	end

	local target = (self._visible and anyOpen) and (self._blurSize or BLUR_SIZE) or 0
	TweenService:Create(blur, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = target }):Play()
end

function UI:Show()
	self.Root.Visible = true
	self._visible = true
	self:_updateBlur()
end

function UI:Hide()
	self.Root.Visible = false
	self._visible = false
	self:_updateBlur()
end

function UI:Toggle()
	if self._visible then self:Hide() else self:Show() end
end

function UI:SetTitle(text)
	if self.TitleLabel then self.TitleLabel.Text = tostring(text) end
end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	if self._blur then pcall(function() self._blur:Destroy() end) end
	for i, w in ipairs(UI.Windows) do
		if w == self then table.remove(UI.Windows, i) break end
	end
end

-- ============================================================
-- 	CREATE TAB  ← la OTRA parte visual que cambió (la pestaña en sí).
-- 	Todo lo de ADENTRO de cada pestaña (los Create... de controles,
-- 	más abajo en el archivo) es exactamente el original.
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))
	local radius = self.TAB_RADIUS or 14

	if self.EmptyHint then
		self.EmptyHint:Destroy()
		self.EmptyHint = nil
	end

	-- ---------------- La "línea": negro semi-transparente, con
	-- flechita (">" que se da vuelta a "<" al abrir) y el nombre
	-- siempre visible. Un poco más gordita y larga que antes. ----------------
	-- La pestaña vive dentro de un envoltorio invisible: la lista la
	-- ordena a él, y así la aurita puede dibujarse DETRÁS de la pestaña
	-- (como hermana de ella) sin tapar el texto.
	local Wrap = new("Frame", {
		Name = name .. "_Wrap",
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = #self._tabs + 1,
		Parent = self.SlideList,
	})

	local Pill = new("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Line,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 1,
		Parent = Wrap,
	}, { corner(radius), stroke(Theme.Border, 1) })

	local NameLabel = new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 14 + FONT_BOOST,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -46, 1, 0),
		Parent = Pill,
	})

	local Arrow = new("TextLabel", {
		Text = ">",
		Font = Theme.FontBold,
		TextSize = 16 + FONT_BOOST,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -28, 0, 0),
		Size = UDim2.new(0, 20, 1, 0),
		Parent = Pill,
	})

	-- (El hover de la pestaña se conecta MÁS ABAJO, después de crear
	-- `Tab`, para que pueda respetar si la pestaña está abierta. Antes
	-- se usaba hoverField(Pill, Theme.Line) acá, y ese hover le pisaba
	-- el rojo a la pestaña abierta cada vez que el mouse entraba o
	-- salía.)

	-- ---------------- AURITA de la pestaña (chica y suave) ----------------
	-- Mismo truco que el aura de la tarjeta (anillos cada vez más
	-- transparentes) pero más chico y más sutil. Se enciende con un
	-- destello corto al presionar y se queda tenue mientras la pestaña
	-- está abierta; se apaga al cerrarla o al abrir otra.
	local pillLayers = {}
	local PILL_N = math.max(PILL_AURA_LAYERS, 1)
	if PILL_AURA_SIZE_PX > 0 then
		local step = PILL_AURA_SIZE_PX / PILL_N
		for k = 1, PILL_N do
			local grow = k * step
			table.insert(pillLayers, new("Frame", {
				Name = "Aura",
				Size = UDim2.new(1, grow * 2, 1, grow * 2),
				Position = UDim2.new(0, -grow, 0, -grow),
				BackgroundColor3 = Theme.FX,
				BackgroundTransparency = 1, -- arranca apagada
				BorderSizePixel = 0,
				ZIndex = 0, -- detrás de la pestaña
				Parent = Wrap,
			}, { corner(radius + grow) }))
		end
	end
	onAccent(function()
		for _, l in ipairs(pillLayers) do
			if l.Parent then l.BackgroundColor3 = Theme.FX end
		end
	end)

	-- Transparencia TOTAL en el borde -> transparencia de cada capa
	-- (las capas se apilan, por eso se reparte con una raíz).
	local function pillLayerT(total)
		return math.clamp(total, 0, 1) ^ (1 / PILL_N)
	end

	-- Se guardan los tweens de la aurita para poder CANCELARLOS: así, al
	-- cerrar la pestaña o abrir otra, ninguna animación vieja que siga
	-- corriendo puede volver a encenderla.
	local pillTw = {}
	local function stopPillTweens()
		for i, tw in pairs(pillTw) do
			pcall(function() tw:Cancel() end)
			pillTw[i] = nil
		end
	end

	local function setPillAura(on)
		stopPillTweens()
		for i, l in ipairs(pillLayers) do
			if on then
				local tw = TweenService:Create(l, TweenInfo.new(0.25), { BackgroundTransparency = pillLayerT(PILL_AURA_TRANSPARENCY) })
				pillTw[i] = tw
				tw:Play()
			else
				l.BackgroundTransparency = 1 -- se apaga al instante, sin dejar rastro
			end
		end
	end

	-- Destello al presionar: arranca más densa y se acomoda al nivel tenue.
	local function pulsePillAura(stayOn)
		stopPillTweens()
		for i, l in ipairs(pillLayers) do
			l.BackgroundTransparency = pillLayerT(math.max(PILL_AURA_TRANSPARENCY - 0.3, 0.05))
			local tw = TweenService:Create(l, TweenInfo.new(0.45), {
				BackgroundTransparency = stayOn and pillLayerT(PILL_AURA_TRANSPARENCY) or 1,
			})
			pillTw[i] = tw
			tw:Play()
		end
	end

	-- Brillo: una franja de luz blanca que barre la pestaña abierta una y otra vez.
	local Shine = new("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Visible = false,
		Parent = Pill,
	}, { corner(radius) })
	local ShineGradient = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.38, 1),
			NumberSequenceKeypoint.new(0.5, 0.72),
			NumberSequenceKeypoint.new(0.62, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Parent = Shine,
	})

	-- ---------------- La ventana flotante con las lógicas: tarjeta
	-- redondeada aparte, cerca de las pestañas pero sin pegarse,
	-- centrada verticalmente, más grande. Semi-transparente (0.2) toda
	-- junta: fondo, botones, toggles, sliders, listas, etc. ----------------
	local PANEL_H, PANEL_X = self.PANEL_H, self.PANEL_X
	local PANEL_MAX_W  = self.PANEL_MAX_W or math.huge
	local PANEL_MARGIN = self.PANEL_MARGIN or 20

	-- CanvasGroup: dibuja la tarjeta ENTERA (fondo + filas + textos) en
	-- una sola capa y le aplica UNA transparencia al conjunto. Antes el
	-- fondo de la tarjeta (0.2) y el de cada fila (0.2) se apilaban, y
	-- como las filas quedaban encima de un fondo oscuro, se veían
	-- sólidas aunque tuvieran transparencia. Así todo se ve al mismo
	-- 0.2 contra el juego.
	local Panel = new("CanvasGroup", {
		Name = name .. "_Panel",
		-- Ancho: TODO lo que haya hasta el borde derecho de la pantalla
		-- (menos el margen), con tope opcional en PANEL_MAX_W.
		Size = UDim2.new(1, -(PANEL_X + PANEL_MARGIN), 0, PANEL_H),
		Position = UDim2.new(0, PANEL_X, 0.5, -PANEL_H / 2),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0,
		GroupTransparency = Theme.Alpha,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 2,
		Visible = false,
		Parent = self.Root,
	}, {
		corner(20),
		stroke(Theme.Border, 1),
		new("UISizeConstraint", { MaxSize = Vector2.new(PANEL_MAX_W, math.huge) }),
	})

	-- ---------------- NIEBLA ROJA alrededor de la tarjeta ----------------
	-- Vive DETRÁS de la tarjeta (ZIndex 0), como hermana de ella (no
	-- hija, porque la tarjeta recorta lo que se sale), y copia su
	-- tamaño, su aparición y su animación.
	local PanelStroke = Panel:FindFirstChildOfClass("UIStroke")
	if PanelStroke then
		PanelStroke.Color = Theme.FX
		PanelStroke.Transparency = 0.35
	end

	local Glow = new("Frame", {
		Name = name .. "_Glow",
		Size = Panel.Size,
		Position = Panel.Position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
		Visible = false,
		Parent = self.Root,
	})
	local GlowScale = new("UIScale", { Scale = 0.9, Parent = Glow })

	-- NIEBLA: capas RELLENAS, redondeadas y muy transparentes, apiladas de
	-- la más chica (pegada a la tarjeta) a la más grande. Donde se
	-- solapan muchas capas la niebla es densa y hacia afuera va quedando
	-- menos: sale un degradado continuo, sin anillos ni rayas. Cada capa
	-- lleva un UIGradient que gira, así hay una zona más densa que da
	-- vueltas alrededor de la tarjeta, como niebla que se arremolina.
	local glowLayers, glowGradients = {}, {}
	if AURA_SIZE_PX > 0 then
		local N = math.max(AURA_LAYERS, 1)
		local step = AURA_SIZE_PX / N
		for k = 1, N do
			local grow = k * step
			local layer = new("Frame", {
				Size = UDim2.new(1, grow * 2, 1, grow * 2),
				Position = UDim2.new(0, -grow, 0, -grow),
				BackgroundColor3 = Theme.FX,
				BackgroundTransparency = 1, -- arranca apagada; la enciende Tab._fx
				BorderSizePixel = 0,
				Parent = Glow,
			}, { corner(20 + grow) })
			table.insert(glowLayers, layer)
			table.insert(glowGradients, new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(0.5, 0.72),
					NumberSequenceKeypoint.new(1, 0),
				}),
				Parent = layer,
			}))
		end
	end

	-- Enciende/apaga toda la niebla de una vez. `strength`: 0 = apagada, 1 = normal.
	local function applyGlow(strength)
		local count = #glowLayers
		if count == 0 then return end
		local total = 1 - (1 - AURA_TRANSPARENCY) * strength -- transparencia total en el borde
		local perLayer = math.clamp(total, 0, 1) ^ (1 / count)
		for _, layer in ipairs(glowLayers) do
			layer.BackgroundTransparency = perLayer
		end
	end

	-- Borde de la tarjeta con una luz roja que da vueltas: un UIGradient
	-- sobre el borde (opaco en un extremo, casi transparente en el
	-- medio) al que se le va girando la rotación (ver Tab._fx).
	local BorderGradient = nil
	local function borderColors()
		-- La "cabeza" de la luz es rojo casi blanco (caliente) y se va
		-- enfriando a rojo oscuro en la cola.
		local hot = Theme.FX:Lerp(Color3.fromRGB(255, 255, 255), 0.7)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, hot),
			ColorSequenceKeypoint.new(0.2, Theme.FX),
			ColorSequenceKeypoint.new(0.5, Theme.FX),
			ColorSequenceKeypoint.new(0.8, Theme.FX),
			ColorSequenceKeypoint.new(1, hot),
		})
	end
	if PanelStroke then
		PanelStroke.Thickness = 2.5
		PanelStroke.Transparency = 0
		BorderGradient = new("UIGradient", {
			Color = borderColors(),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.5, 0.9),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Parent = PanelStroke,
		})
		onAccent(function()
			if BorderGradient.Parent then
				BorderGradient.Color = borderColors()
			end
		end)
	end

	-- ---------------- CHISPAS ----------------
	-- Puntitos rojos que nacen en el borde de la tarjeta, salen flotando
	-- hacia afuera y se apagan. Viven dentro de Glow (detrás de la tarjeta).
	local sparks = {}
	for i = 1, SPARKS_COUNT do
		local hot = (i % 2 == 0) -- la mitad son "calientes" (casi blancas)
		-- Halo: un círculo grande y tenue que es el contenedor de la chispa
		-- (para que cada una "brille"); el núcleo va adentro, encima.
		local halo = new("Frame", {
			Name = "Spark",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(SPARK_SIZE_PX * 3.2, SPARK_SIZE_PX * 3.2),
			BackgroundColor3 = Theme.FXSpark,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = Glow,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local dot = new("Frame", {
			Name = "Core",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1 / 3.2, 1 / 3.2),
			BackgroundColor3 = hot and Theme.FXSpark:Lerp(Color3.fromRGB(255, 255, 255), 0.65) or Theme.FXSpark,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = halo,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		table.insert(sparks, {
			dot = dot, halo = halo, hot = hot, born = nil, life = 2,
			x = 0, y = 0, vx = 0, vy = 0, size = SPARK_SIZE_PX, phase = math.random() * 6.28,
		})
	end
	onAccent(function()
		for _, sp in ipairs(sparks) do
			if sp.dot.Parent then
				sp.dot.BackgroundColor3 = sp.hot and Theme.FXSpark:Lerp(Color3.fromRGB(255, 255, 255), 0.65) or Theme.FXSpark
				sp.halo.BackgroundColor3 = Theme.FXSpark
			end
		end
	end)

	local function respawnSpark(sp, now, stagger)
		local W, H = Panel.Size.X.Offset, PANEL_H
		local r = math.random() * (2 * W + 2 * H)
		local nx, ny
		if r < W then
			sp.x, sp.y, nx, ny = r, 0, 0, -1
		elseif r < 2 * W then
			sp.x, sp.y, nx, ny = r - W, H, 0, 1
		elseif r < 2 * W + H then
			sp.x, sp.y, nx, ny = 0, r - 2 * W, -1, 0
		else
			sp.x, sp.y, nx, ny = W, r - 2 * W - H, 1, 0
		end
		local speed = 16 + math.random() * 34
		local drift = (math.random() - 0.5) * 22
		sp.vx = nx * speed + (ny ~= 0 and drift or 0)
		sp.vy = ny * speed + (nx ~= 0 and drift or 0) - 8 -- un poco hacia arriba, como brasas
		sp.life = 1.8 + math.random() * 1.8
		sp.size = SPARK_SIZE_PX * (0.6 + math.random() * 0.8)
		sp.born = now - (stagger and math.random() * sp.life or 0)
	end

	-- ---------------- BOCANADAS DE NIEBLA ----------------
	-- Manchas de niebla (cada una son 4 círculos apilados muy
	-- transparentes: el centro queda más denso y el borde se desvanece)
	-- que nacen en el borde de la tarjeta, se agrandan y se van flotando
	-- hacia afuera mientras se disuelven.
	local wisps = {}
	for _ = 1, FOG_WISPS do
		local root = new("Frame", {
			Name = "Wisp",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(40, 40),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = Glow,
		})
		local blobs = {}
		for j, frac in ipairs({ 1, 0.75, 0.5, 0.28 }) do
			blobs[j] = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(frac, frac),
				BackgroundColor3 = Theme.FX,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = root,
			}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		end
		table.insert(wisps, { root = root, blobs = blobs, born = nil, life = 4, x = 0, y = 0, vx = 0, vy = 0, size = 40 })
	end
	onAccent(function()
		for _, w in ipairs(wisps) do
			for _, b in ipairs(w.blobs) do
				if b.Parent then b.BackgroundColor3 = Theme.FX end
			end
		end
	end)

	local function respawnWisp(w, now, stagger)
		local W, H = Panel.Size.X.Offset, PANEL_H
		local r = math.random() * (2 * W + 2 * H)
		local nx, ny
		if r < W then
			w.x, w.y, nx, ny = r, 0, 0, -1
		elseif r < 2 * W then
			w.x, w.y, nx, ny = r - W, H, 0, 1
		elseif r < 2 * W + H then
			w.x, w.y, nx, ny = 0, r - 2 * W, -1, 0
		else
			w.x, w.y, nx, ny = W, r - 2 * W - H, 1, 0
		end
		local speed = 4 + math.random() * 9
		w.vx = nx * speed + (ny ~= 0 and (math.random() - 0.5) * 8 or 0)
		w.vy = ny * speed + (nx ~= 0 and (math.random() - 0.5) * 8 or 0) - 3 -- sube apenas, como humo
		w.life = 3.6 + math.random() * 2.6
		w.size = 24 + math.random() * 20
		w.born = now - (stagger and math.random() * w.life or 0)
	end

	Panel:GetPropertyChangedSignal("Visible"):Connect(function()
		Glow.Visible = Panel.Visible
	end)
	onAccent(function()
		if not Glow.Parent then return end
		for _, layer in ipairs(glowLayers) do layer.BackgroundColor3 = Theme.FX end
		if PanelStroke then PanelStroke.Color = Theme.FX end
	end)

	-- El ancho se calcula EXPLÍCITAMENTE en píxeles y se recalcula si
	-- cambia el tamaño de la pantalla: lo que quede libre a la derecha
	-- (menos el margen), sin pasarse del tope PANEL_MAX_W.
	local function fitPanel()
		local screenW = self.Root.AbsoluteSize.X
		if screenW <= 0 then
			local cam = workspace.CurrentCamera
			screenW = cam and cam.ViewportSize.X or 1280
		end
		local avail = screenW - (PANEL_X + PANEL_MARGIN)
		local w = math.max(math.min(avail, PANEL_MAX_W), 240)
		Panel.Size = UDim2.new(0, w, 0, PANEL_H)
		Glow.Size = Panel.Size
	end
	fitPanel()
	self.Root:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitPanel)
	-- Si algo de afuera le cambia el tamaño a la tarjeta, se vuelve a
	-- fijar solo (poner el mismo valor no dispara el evento otra vez,
	-- así que no hay bucle).
	Panel:GetPropertyChangedSignal("Size"):Connect(fitPanel)

	local PanelScale = new("UIScale", { Scale = 0.9, Parent = Panel })

	local PanelHeader = new("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		Parent = Panel,
	})

	local PanelTitleLabel = new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 15 + FONT_BOOST,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Parent = PanelHeader,
	})

	-- Brillo rojo que recorre el título de izquierda a derecha (el texto
	-- es blanco y el degradado le pinta una franja roja que se desliza).
	local function titleColors()
		local white = Color3.fromRGB(255, 255, 255)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, white),
			ColorSequenceKeypoint.new(0.4, white),
			ColorSequenceKeypoint.new(0.5, Theme.Active),
			ColorSequenceKeypoint.new(0.6, white),
			ColorSequenceKeypoint.new(1, white),
		})
	end
	local TitleGradient = new("UIGradient", {
		Color = titleColors(),
		Offset = Vector2.new(-1, 0),
		Parent = PanelTitleLabel,
	})
	onAccent(function()
		if TitleGradient.Parent then TitleGradient.Color = titleColors() end
	end)

	new("Frame", {
		Position = UDim2.new(0, 14, 0, 42),
		Size = UDim2.new(1, -28, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Parent = Panel,
	})

	local PanelScroll = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Active,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Panel,
	})

	local List = new("Frame", {
		Name = "List",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = PanelScroll,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 10, 14, 14, 14),
	})

	local Tab = setmetatable({
		Window  = self,
		Pill    = Pill,
		Arrow   = Arrow,
		Panel   = Panel,
		List    = List,
		Name    = name,
		_isOpen = false,
		_rowCount = 0,
	}, UI)

	-- ---------------- Color de la pestaña (rojo persistente) ----------------
	-- UNA sola función decide cómo se ve la línea según su estado:
	--   · abierta  → rojo, y se queda rojo pase lo que pase con el mouse
	--   · cerrada  → negro (o un poco más claro si el mouse está encima)
	-- Se usa tween sobre las MISMAS propiedades, así un tween de hover
	-- que todavía esté corriendo nunca le pisa el rojo al terminar.
	local hovering = false

	local function paintPill()
		if Tab._isOpen then
			tween(Pill, { BackgroundColor3 = Theme.FX, BackgroundTransparency = 0.35 }, 0.15)
		else
			tween(Pill, {
				BackgroundColor3 = hovering and Theme.LineOpen or Theme.Line,
				BackgroundTransparency = 0.2,
			}, 0.15)
		end
	end
	Tab._paint = paintPill
	Tab._auraOff = function()
		setPillAura(false)
		Shine.Visible = false
		Glow.Visible = false
	end

	-- Efectos animados de la tarjeta abierta (los llama el bucle Heartbeat
	-- de la ventana): el aura "respira" y la luz del borde gira.
	Tab._appearAt = 0
	Tab._fx = function(now)
		local appear = math.clamp((now - Tab._appearAt) / 0.35, 0, 1)

		-- Niebla: respira (un poco más o menos densa). Sin animación queda fija.
		local strength = appear
		if ANIMATED_FX then
			strength = (0.6 + 0.4 * (0.5 + 0.5 * math.sin(now * 1.6))) * appear
		end
		applyGlow(strength)
		if not ANIMATED_FX then return end

		-- Luz cometa que gira por el borde y por el aura.
		local rot = (now * 75) % 360
		for _, g in ipairs(glowGradients) do g.Rotation = rot end
		if BorderGradient then BorderGradient.Rotation = rot end

		-- Brillo que recorre el título (cada ~3.6 s) y la pestaña (cada ~2.2 s).
		TitleGradient.Offset = Vector2.new(-1 + 2 * ((now % 3.6) / 3.6), 0)
		ShineGradient.Offset = Vector2.new(-1 + 2 * ((now % 2.2) / 2.2), 0)

		-- Chispas.
		for _, sp in ipairs(sparks) do
			if sp.born == nil then
				respawnSpark(sp, now, true)
			elseif now - sp.born >= sp.life then
				respawnSpark(sp, now, false)
			end
			local age = now - sp.born
			local t = math.clamp(age / sp.life, 0, 1)
			local sz = sp.size * (1 - 0.6 * t)
			sp.halo.Position = UDim2.fromOffset(sp.x + sp.vx * age, sp.y + sp.vy * age)
			sp.halo.Size = UDim2.fromOffset(sz * 3.2, sz * 3.2)
			-- Aparece, brilla y se apaga; además titila un poco (parpadeo).
			local twinkle = 0.82 + 0.18 * math.sin(now * 12 + sp.phase)
			local vis = math.sin(t * math.pi) * appear * twinkle
			sp.dot.BackgroundTransparency = 1 - vis
			sp.halo.BackgroundTransparency = 1 - 0.34 * vis
		end

		-- Bocanadas de niebla.
		for _, w in ipairs(wisps) do
			if w.born == nil then
				respawnWisp(w, now, true)
			elseif now - w.born >= w.life then
				respawnWisp(w, now, false)
			end
			local age = now - w.born
			local t = math.clamp(age / w.life, 0, 1)
			local sz = w.size * (0.7 + 0.9 * t) -- se agranda como el humo
			w.root.Position = UDim2.fromOffset(w.x + w.vx * age, w.y + w.vy * age)
			w.root.Size = UDim2.fromOffset(sz, sz)
			local a = math.sin(t * math.pi) * 0.10 * appear -- densidad de cada círculo
			for _, b in ipairs(w.blobs) do
				b.BackgroundTransparency = 1 - a
			end
		end
	end

	Pill.MouseEnter:Connect(function()
		hovering = true
		paintPill()
	end)
	Pill.MouseLeave:Connect(function()
		hovering = false
		paintPill()
	end)

	Pill.InputBegan:Connect(function(input)
		if self._beginDrag then self._beginDrag(input) end
	end)

	-- Abre esta tarjeta y cierra la de cualquier otra pestaña que haya
	-- quedado abierta (solo una ventana de lógicas a la vez). La
	-- pestaña activa se pone roja y se queda así hasta que cambies de
	-- pestaña o la cierres; las demás vuelven a negro.
	local function setOpen(open)
		if open then
			for _, other in ipairs(self._tabs) do
				if other ~= Tab and other._isOpen then
					other._isOpen = false
					other.Panel.Visible = false
					if other._paint then other._paint() end
					if other._auraOff then other._auraOff() end
					tween(other.Arrow, { Rotation = 0 }, 0.15)
				end
			end

			Tab._isOpen = true
			paintPill()
			pulsePillAura(true)
			Shine.Visible = true
			for _, sp in ipairs(sparks) do sp.born = nil end -- las chispas arrancan de nuevo
			for _, w in ipairs(wisps) do w.born = nil end -- y la niebla también
			tween(Arrow, { Rotation = 180 }, 0.15)
			fitPanel() -- reafirma el ancho cada vez que se abre
			Panel.Visible = true
			Glow.Visible = true
			-- Aparece con fundido (de invisible a su 0.2 normal).
			Tab._appearAt = os.clock()
			Panel.GroupTransparency = 1
			tween(Panel, { GroupTransparency = Theme.Alpha }, 0.28)
			PanelScale.Scale = 0.9
			tween(PanelScale, { Scale = 1 }, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			GlowScale.Scale = 0.9
			tween(GlowScale, { Scale = 1 }, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		else
			Tab._isOpen = false
			paintPill()
			setPillAura(false)
			Shine.Visible = false
			Glow.Visible = false
			tween(Arrow, { Rotation = 0 }, 0.15)
			Panel.Visible = false
		end
		self:_updateBlur()
	end
	onAccent(function()
		if Pill.Parent and Tab._isOpen then Pill.BackgroundColor3 = Theme.FX end
	end)

	table.insert(self._connections, Pill.MouseButton1Click:Connect(function()
		if self._dragMoved then return end -- fue un arrastre (scroll), no un clic
		setOpen(not Tab._isOpen)
	end))

	table.insert(self._tabs, Tab)

	-- La primera pestaña que se crea arranca ya abierta, para que no
	-- entres a un panel completamente vacío la primera vez.
	if #self._tabs == 1 then
		task.defer(function()
			setOpen(true)
		end)
	end

	return Tab
end

