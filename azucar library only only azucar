function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
	local text = config.Text or config.Name or config.Title or "Botón"
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Btn = new("TextButton", {
		Text = text, Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26), LayoutOrder = nextOrder(owner), Parent = list,
	}, { corner(8) })
	hoverField(Btn, Theme.Field)

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)
	function Button:Set(...)
		-- Destello rosa de fondo que se apaga solo.
		Btn.BackgroundColor3 = Theme.ActiveDim
		tween(Btn, { BackgroundColor3 = Theme.LineOpen }, 0.3)
		Btn.TextColor3 = Theme.Active
		task.delay(0.15, function()
			if Btn.Parent then Btn.TextColor3 = Theme.Text end
		end)
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set
	function Button:Stop() stopAllThreads(self) end
	table.insert(window._connections, Btn.MouseButton1Click:Connect(function() Button:Set() end))
	registerFlag(config.Flag, Button, nil)
	return Button
end

function UI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end
	state = not not state
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Field, BorderSizePixel = 0, LayoutOrder = nextOrder(owner), Parent = list }, { corner(8) })
	hoverField(Row, Theme.Field)
	new("TextLabel", {
		Text = config.Text or config.Name or "Opción", Font = Theme.Font, TextSize = 11, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -36, 1, 0), Parent = Row,
	})
	-- Apagado: caja clara con bordecito rosa fino para saber dónde
	-- tocar. Prendido: caja rellena de rosa fuerte, con un saltito y un
	-- brillo suave al cambiar.
	local Box = new("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -20, 0.5, -6), BackgroundColor3 = state and Theme.Active or Theme.Field, BorderSizePixel = 0, Parent = Row }, { corner(4) })
	local BoxPop = new("UIScale", { Scale = 1, Parent = Box })
	local BoxGlow = new("UIStroke", { Color = Theme.Active, Thickness = state and 1.6 or 1.3, Transparency = 0, Parent = Box })

	local Toggle = setmetatable({ Box = Box, Value = state, Callback = callback, _threads = {} }, UI)
	onAccent(function()
		if Box.Parent then
			Box.BackgroundColor3 = Toggle.Value and Theme.Active or Theme.Field
			BoxGlow.Color = Theme.Active
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		tween(Box, { BackgroundColor3 = newState and Theme.Active or Theme.Field })
		tween(BoxGlow, { Thickness = newState and 1.6 or 1.3 }, 0.18)
		BoxPop.Scale = 1.4
		tween(BoxPop, { Scale = 1 }, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end
	function Toggle:Get() return self.Value end
	function Toggle:Stop() stopAllThreads(self) end
	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })
	table.insert(window._connections, Click.MouseButton1Click:Connect(function() Toggle:Set(not Toggle.Value) end))
	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)
	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then rangeMin = rangeMin or config.Range[1] rangeMax = rangeMax or config.Range[2] end
	local min, max = rangeMin or 0, rangeMax or 100
	if max <= min then max = min + 1 end
	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end
	local decimals = 0
	if step < 1 then decimals = math.min(#tostring(step):gsub("^%d*%.?", ""), 3) end
	local function snap(v) v = math.clamp(v, min, max) return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max) end
	local function show(v) if decimals > 0 then return string.format("%." .. decimals .. "f", v) end return tostring(math.floor(v + 0.5)) end
	local value = snap(config.Default or config.CurrentValue or min)

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Field, BorderSizePixel = 0, LayoutOrder = nextOrder(owner), Parent = list }, { corner(8), pad(0, 5, 8, 5, 8) })
	new("TextLabel", {
		Text = config.Text or config.Name or "Valor", Font = Theme.Font, TextSize = 11, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Size = UDim2.new(1, -46, 0, 14), Parent = Row,
	})
	local ValueLabel = new("TextLabel", {
		Text = show(value), Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.Active, TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1, Size = UDim2.new(0, 42, 0, 14), Position = UDim2.new(1, -42, 0, 0), Parent = Row,
	})
	onAccent(function() if ValueLabel.Parent then ValueLabel.TextColor3 = Theme.Active end end)
	-- Track claro (sin rosa fuerte) + Fill rosa: contraste claro, como un slider normal.
	local Track = new("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 1, -8), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = Row }, { stroke(Theme.Border, 1), corner(2) })
	local function ratio(v) return (v - min) / (max - min) end
	local Fill = new("Frame", { Size = UDim2.new(ratio(value), 0, 1, 0), BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Track }, { corner(2) })
	onAccent(function() if Fill.Parent then Fill.BackgroundColor3 = Theme.Active end end)
	local Knob = new("Frame", { Size = UDim2.new(0, 9, 0, 9), Position = UDim2.new(ratio(value), -4, 0.5, -4), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Parent = Track }, { corner(4), stroke(Theme.Border, 1) })
	local KnobPop = new("UIScale", { Scale = 1, Parent = Knob })

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value, Min = min, Max = max, Callback = callback, _threads = {} }, UI)
	local function repaint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -4, 0.5, -4)
		ValueLabel.Text = show(v)
	end
	function Slider:Set(newValue, whileDragging)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		setFlagValue(config.Flag, newValue, whileDragging)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + relative * (max - min), dragging)
	end
	table.insert(window._connections, Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(KnobPop, { Scale = 1.5 }, 0.1)
			setFromX(input.Position.X)
		end
	end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
			dragging = false
			tween(KnobPop, { Scale = 1 }, 0.12)
			setFlagValue(config.Flag, Slider.Value)
		end
	end))
	registerFlag(config.Flag, Slider, value)
	return Slider
end

function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}
	local function display(v) if typeof(v) == "Instance" then return v.Name end if typeof(v) == "table" and v.Name then return tostring(v.Name) end return tostring(v) end
	local function isValid(v) for _, o in ipairs(options) do if o == v then return true end end return false end
	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if wanted ~= nil and isValid(wanted) then selected = wanted end

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = nextOrder(owner), Parent = list }, { corner(8) })
	new("TextLabel", { Text = config.Text or config.Name or "Opciones", Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0.45, 0, 0, 26), Parent = Row })
	local SelectedLabel = new("TextLabel", { Text = selected ~= nil and display(selected) or "-", Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.Active, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1, Position = UDim2.new(0.45, 0, 0, 0), Size = UDim2.new(0.55, -20, 0, 26), Parent = Row })
	onAccent(function() if SelectedLabel.Parent then SelectedLabel.TextColor3 = Theme.Active end end)
	local Arrow = new("TextLabel", { Text = "+", Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.TextDim, BackgroundTransparency = 1, Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0, 14, 0, 26), Parent = Row })
	local ROW_H = 26
	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, -12, 0, math.min(math.max(#options, 1), 5) * 20 + 6), Position = UDim2.new(0, 6, 0, ROW_H),
		BackgroundColor3 = Theme.Line, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Row,
	}, { stroke(Theme.Border, 1), pad(3), new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local Dropdown = setmetatable({ Value = selected, Options = options, Callback = callback, _threads = {} }, UI)
	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = display(option)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end

	local setOpen
	local function buildOptions()
		for _, child in ipairs(ListFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
		for index, optionValue in ipairs(Dropdown.Options) do
			local OptionBtn = new("TextButton", {
				Text = display(optionValue), Font = Theme.Font, TextSize = 10, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 18), LayoutOrder = index, Parent = ListFrame,
			}, { corner(5), pad(0, 0, 4, 0, 4) })
			OptionBtn.MouseEnter:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.LineOpen }) end)
			OptionBtn.MouseLeave:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.Field }) end)
			table.insert(window._connections, OptionBtn.MouseButton1Click:Connect(function()
				Dropdown:Set(optionValue)
				if setOpen then setOpen(false) end
			end))
		end
	end
	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		buildOptions()
		ListFrame.Size = UDim2.new(1, -12, 0, math.min(math.max(#self.Options, 1), 5) * 20 + 6)
		if not keepSelection then
			self.Value = self.Options[1]
			SelectedLabel.Text = self.Value ~= nil and display(self.Value) or "-"
		end
	end
	Dropdown.SetOptions = Dropdown.Refresh
	buildOptions()
	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ROW_H), Parent = Row })
	function setOpen(open)
		local h = math.min(math.max(#Dropdown.Options, 1), 5) * 20 + 6
		Row.Size = UDim2.new(1, 0, 0, open and (ROW_H + h + 2) or ROW_H)
		Arrow.Text = open and "-" or "+"
	end
	table.insert(window._connections, Click.MouseButton1Click:Connect(function() setOpen(Row.Size.Y.Offset <= ROW_H) end))
	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

