function UI:Notify(config)
	if typeof(config) == "string" then config = { Text = config } end
	config = config or {}
	local holder = self._notes
	if not holder then return end
	local titleText = config.Title
	local bodyText = config.Text or config.Message or config.Content or ""
	local hasTitle = titleText ~= nil and tostring(titleText) ~= ""
	local h = hasTitle and 40 or 26
	self._notifyCount = (self._notifyCount or 0) + 1
	local card = new("Frame", {
		BackgroundColor3 = Theme.Title, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, h), LayoutOrder = self._notifyCount, Parent = holder,
	}, { stroke(Theme.Border, 1) })
	new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0), Parent = card })
	if hasTitle then
		label({ Text = tostring(titleText), TextColor3 = Theme.Active, Position = UDim2.new(0, 10, 0, 2), Size = UDim2.new(1, -14, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
		label({ Text = tostring(bodyText), TextColor3 = Theme.TextDim, Position = UDim2.new(0, 10, 0, 20), Size = UDim2.new(1, -14, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	else
		label({ Text = tostring(bodyText), Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -14, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	end
	local duration = config.Duration or 3
	local timer = new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 2), Parent = card })
	TweenService:Create(timer, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
	task.delay(duration, function() if card.Parent then card:Destroy() end end)
end

-- Lista de activos pegada al borde derecho: una etiqueta por pestaña con opciones activas.
function UI:SetActiveList(on)
	self._activeOn = not not on
	if self._activeGui then self._activeGui.Enabled = self._activeOn end
	self:_activeRefresh()
end

function UI:_activeRefresh()
	if self._activePending then return end
	self._activePending = true
	task.defer(function()
		self._activePending = false
		local gui, box = self._activeGui, self._activeBox
		if not gui or not box or not gui.Parent then return end
		for _, c in ipairs(box:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		if not self._activeOn then return end
		local rows = {}
		for _, t in ipairs(self._tabs) do
			local n, total = 0, #t._opts
			for _, o in ipairs(t._opts) do if o.Active then n = n + 1 end end
			if n > 0 then table.insert(rows, { tab = t, n = n, total = total }) end
		end
		table.sort(rows, function(a, b) if a.n ~= b.n then return a.n > b.n end return a.tab.Name < b.tab.Name end)
		for i, r in ipairs(rows) do
			local open = (self._current == r.tab) and self._visible
			local item = new("TextButton", {
				Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Title, BackgroundTransparency = 0.1, BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 17), LayoutOrder = i, Parent = box,
			}, { pad(8, 0, 6, 0) })
			new("Frame", { BackgroundColor3 = open and Theme.Active or Theme.Border, BorderSizePixel = 0, Position = UDim2.new(0, -8, 0, 0), Size = UDim2.new(0, 2, 1, 0), Parent = item })
			label({
				Text = r.tab.Name .. "  " .. r.n .. "/" .. r.total, TextSize = 12, TextColor3 = open and Theme.Active or Theme.Text,
				AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Parent = item,
			})
			item.MouseButton1Click:Connect(function()
				if self._visible and self._current == r.tab then self:Hide() else self:Show() self:SelectTab(r.tab) end
			end)
		end
	end)
end

function UI:Destroy()
	for _, c in ipairs(self._connections or {}) do pcall(function() c:Disconnect() end) end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	if self._activeGui then pcall(function() self._activeGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do if w == self then table.remove(UI.Windows, i) break end end
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) == "table" then
		for i, w in ipairs(registry) do if w == self then table.remove(registry, i) break end end
	end
end

function UI:CreateWindow(config)
	config = config or {}
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)

	if config.Theme ~= nil then UI:SetAccentColor(config.Theme) end
	if config.TextSize then Theme.TextSize = config.TextSize end

	local size = config.Size or Vector2.new(360, 420)
	local scale = config.Scale or 1
	local title = tostring(config.Title or config.Name or "Azúcar Square")
	local badge = config.Badge and tostring(config.Badge) or ""
	local serverName = config.ServerName and tostring(config.ServerName) or ""

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarDulce", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = config.IgnoreGuiInset ~= false, DisplayOrder = 10,
	})
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(ScreenGui) end end)
	ScreenGui:SetAttribute("AzucarLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	local Main = new("Frame", {
		Name = "Main", BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Size = UDim2.new(0, size.X, 0, size.Y),
		Position = UDim2.new(0, 70, 0.5, -size.Y / 2), Parent = ScreenGui,
	}, { stroke(Theme.Border, 1) })
	if scale ~= 1 then new("UIScale", { Scale = scale, Parent = Main }) end

	local window = setmetatable({
		ScreenGui = ScreenGui, Container = Main, _tabs = {}, _connections = {}, _visible = true, _loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0, _loadOrder = config.AutoLoadOrder, _activeOn = config.ActiveList ~= false,
	}, UI)

	-- Barra de título limpia: título a la izquierda, Badge a la derecha, línea de acento abajo.
	local titlebar = new("Frame", { BackgroundColor3 = Theme.Title, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 24), Parent = Main })
	local titleIcon = nil
	if config.Icon ~= false then titleIcon = makeIcon(titlebar, config.Icon or "diamond") end
	if titleIcon then titleIcon.paint(Theme.Active) end
	label({ Text = title, Position = UDim2.new(0, titleIcon and 22 or 8, 0, 0), Size = UDim2.new(1, titleIcon and -144 or -130, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = titlebar })
	label({ Text = badge, TextColor3 = Theme.Active, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -128, 0, 0), Size = UDim2.new(0, 120, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = titlebar })
	new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), Parent = titlebar })

	-- La ventana está FIJA. Con Draggable = true se mueve arrastrando la barra de título.
	if config.Draggable == true then
	local dragging, dragStart, startPos = false, nil, nil
	table.insert(window._connections, titlebar.InputBegan:Connect(function(i)
		if isClick(i) then dragging, dragStart, startPos = true, i.Position, Main.Position end
	end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			local d = i.Position - dragStart
			Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(i) if isClick(i) then dragging = false end end))
	end

	window._tabbar = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 30), Size = UDim2.new(1, -12, 0, 22), Parent = Main,
	})
	window._content = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 60), Size = UDim2.new(1, -12, 1, -86), Parent = Main,
	})

	local toggleKey = config.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.K end
	local footer = new("Frame", { BackgroundColor3 = Theme.Title, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 20), Parent = Main })
	new("Frame", { BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Parent = footer })
	label({ Text = toggleKey and ("[" .. toggleKey.Name .. "] mostrar / ocultar") or "", TextColor3 = Theme.TextDim, TextSize = 11, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0.55, 0, 1, 0), Parent = footer })
	label({ Text = serverName, TextColor3 = Theme.Active, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0.4, 0, 0, 0), Size = UDim2.new(0.6, -8, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = footer })
	local clock = label({ Text = os.date("%H:%M:%S"), TextColor3 = Theme.TextDim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 64, 1, 0), Parent = footer })
	task.spawn(function() while clock.Parent do clock.Text = os.date("%H:%M:%S") task.wait(1) end end)

	window._notes = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.new(0, 240, 0, 240), ZIndex = 50, Parent = ScreenGui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })

	local activeGui = new("ScreenGui", {
		Name = "AzucarActiveList", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 997,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Enabled = window._activeOn, Parent = guiParent,
	})
	activeGui:SetAttribute("AzucarLoadId", LOAD_ID)
	window._activeGui = activeGui
	window._activeBox = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 44),
		AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(0, 0, 0, 0), Parent = activeGui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }) })

	if toggleKey then
		table.insert(window._connections, UserInputService.InputBegan:Connect(function(input)
			if input.KeyCode == toggleKey and not UserInputService:GetFocusedTextBox() then
				local ok, err = pcall(function() window:Toggle() window:_activeRefresh() end)
				if not ok then warn("[AzucarSquare] Error al abrir/cerrar: " .. tostring(err)) end
			end
		end))
	end

	table.insert(UI.Windows, window)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) ~= "table" then registry = {} rawset(_G, "__AzucarDulceWindows", registry) end
	table.insert(registry, window)

	-- Guardado/carga de configuración
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do table.insert(autoSaveIgnore, word) end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				window:LoadConfig(autoName)
			end)
		end
	end

	return window
end

-- ============================================================
-- 	GUARDAR / CARGAR CONFIGURACION
-- ============================================================
local function ensureConfigFolder()
	if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(UI.ConfigFolder) then pcall(makefolder, UI.ConfigFolder) end
	end
end

function UI:SaveConfig(name)
	name = name or "default"
	if typeof(writefile) ~= "function" then
		warn("[AzucarSquare] Tu ejecutor no tiene writefile — no se puede guardar la config.")
		return false
	end
	ensureConfigFolder()
	local data = {}
	for flag, value in pairs(UI.FlagValues) do
		if not isIgnoredFlag(flag) then
			local t = typeof(value)
			if t == "boolean" or t == "number" or t == "string" then data[flag] = value
			elseif t == "EnumItem" and value.Name then data[flag] = { __keycode = value.Name } end
		end
	end
	local okJson, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not okJson then warn("[AzucarSquare] No se pudo convertir la config a JSON.") return false end
	local okWrite, err = pcall(writefile, UI.ConfigFolder .. "/" .. name .. ".json", encoded)
	if not okWrite then warn("[AzucarSquare] No se pudo guardar la config: " .. tostring(err)) return false end
	return true
end

function UI:LoadConfig(name, stagger)
	name = name or "default"
	if stagger == nil then stagger = self._loadStagger or 0 end
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		warn("[AzucarSquare] Tu ejecutor no tiene readfile/isfile — no se puede cargar la config.")
		return false
	end
	local path = UI.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then return false end
	local okRead, raw = pcall(readfile, path)
	if not okRead then warn("[AzucarSquare] No se pudo leer el archivo de config.") return false end
	local okJson, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okJson or typeof(data) ~= "table" then warn("[AzucarSquare] La config guardada está corrupta o vacía.") return false end

	local order = self._loadOrder
	local function priority(flag)
		if typeof(order) == "table" then
			local first = flag:sub(1, 1):upper()
			for i, letter in ipairs(order) do
				if typeof(letter) == "string" and first == letter:sub(1, 1):upper() then return i end
			end
		end
		return math.huge
	end
	local flags = {}
	for flag in pairs(data) do if not isIgnoredFlag(flag) then table.insert(flags, flag) end end
	table.sort(flags, function(a, b)
		local pa, pb = priority(a), priority(b)
		if pa ~= pb then return pa < pb end
		return a < b
	end)

	loadingConfig = true
	local ok = pcall(function()
		for i, flag in ipairs(flags) do
			local value = data[flag]
			local controller = UI.Flags[flag]
			if controller and typeof(controller.Set) == "function" then
				if typeof(value) == "table" and value.__keycode then
					local okKey, keyCode = pcall(function() return Enum.KeyCode[value.__keycode] end)
					if okKey and keyCode then controller:Set(keyCode) end
				else
					pcall(function() controller:Set(value) end)
				end
			end
			if stagger > 0 and i < #flags then task.wait(stagger) end
		end
	end)
	loadingConfig = false
	if not ok then warn("[AzucarSquare] Ocurrió un error aplicando la config guardada.") return false end
	return true
end

function UI:ListConfigs()
	if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" then return {} end
	if not isfolder(UI.ConfigFolder) then return {} end
	local names = {}
	local okList, files = pcall(listfiles, UI.ConfigFolder)
	if not okList then return names end
	for _, path in ipairs(files) do
		local fname = path:match("([^/\\]+)%.json$")
		if fname then table.insert(names, fname) end
	end
	return names
end

return UI
