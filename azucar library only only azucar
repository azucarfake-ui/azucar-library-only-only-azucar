function UI:CreateTab(config)
	if typeof(config) == "string" then config = { Name = config } end
	config = config or {}
	local name = config.Text or config.Name or config.Title or ("Tab " .. (#self._tabs + 1))
	if self.EmptyHint then self.EmptyHint:Destroy() self.EmptyHint = nil end

	local collapsedW = math.clamp(#name * 6 + 16, 36, 96)
	local Pill = new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Field, BackgroundTransparency = 0,
		Size = UDim2.new(0, collapsedW, 0, 22), Position = UDim2.new(0, self._tabX, 0, 3),
		ZIndex = 4, Parent = self.TabStrip,
	}, { corner(10), stroke(Theme.Border, 1) })
	self._tabX = self._tabX + collapsedW + 6
	self.TabStrip.CanvasSize = UDim2.new(0, self._tabX + 8, 0, 0)

	new("TextLabel", {
		Text = name, Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1, Size = UDim2.new(1, -6, 1, 0), Position = UDim2.new(0, 3, 0, 0), ZIndex = 5, Parent = Pill,
	})

	local List = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Visible = false, Parent = self.ContentScroll,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local Tab = setmetatable({ Window = self, Pill = Pill, List = List, Name = name, _isOpen = false, _rowCount = 0 }, UI)

	local hovering = false
	local function paintPill()
		if Tab._isOpen then
			tween(Pill, { BackgroundColor3 = Theme.Border, BackgroundTransparency = 0.12 }, 0.12)
		else
			tween(Pill, { BackgroundColor3 = hovering and Theme.LineOpen or Theme.Field, BackgroundTransparency = 0 }, 0.12)
		end
	end
	onAccent(function() if Pill.Parent and Tab._isOpen then Pill.BackgroundColor3 = Theme.Border end end)
	Pill.MouseEnter:Connect(function() hovering = true paintPill() end)
	Pill.MouseLeave:Connect(function() hovering = false paintPill() end)

	local function setOpen(open)
		if open then
			for _, other in ipairs(self._tabs) do
				if other ~= Tab and other._isOpen then
					other._isOpen = false
					other.List.Visible = false
					if other._paint then other._paint() end
				end
			end
			Tab._isOpen = true
			List.Visible = true
			paintPill()
		else
			Tab._isOpen = false
			List.Visible = false
			paintPill()
		end
	end
	Tab._paint = paintPill

	Pill.MouseButton1Click:Connect(function()
		if self._dragMoved then return end
		setOpen(not Tab._isOpen)
	end)

	table.insert(self._tabs, Tab)
	if #self._tabs == 1 then task.defer(function() setOpen(true) end) end
	return Tab
end

