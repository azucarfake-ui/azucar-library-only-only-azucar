--[[
	AzucarLegit  v1.3.10
	====================
	(Antes: AzucarSlideUI / AzucarHackerUI)

	CAMBIOS RECIENTES (hasta v1.3.10):
	  1. TRANSPARENCIA REAL. La tarjeta que abre cada pestaña ahora es
	     un CanvasGroup: fondo, botones, toggles, sliders, listas,
	     inputs, keybinds y stats se dibujan juntos y el conjunto se
	     ve al 0.2 (Theme.Alpha). Antes cada fila tenía su propia
	     transparencia encima de un fondo oscuro, y se apilaban: por
	     eso las filas se veían sólidas.
	  2. SCROLL EN LA LISTA DE PESTAÑAS, SIN BARRA. Si hay más
	     pestañas de las que entran en pantalla, bajás/subís con la
	     rueda del mouse, arrastrando con el mouse o con el dedo.
	  3. (v1.3.1) La pestaña abierta mantiene el rojo hasta que
	     cambies de pestaña o la cierres.
	  4. TARJETA ANCHA que crece hacia la derecha hasta un tope de
	     500px (config.PanelMaxWidth) y se achica sola en pantallas
	     angostas. Margen derecho: config.PanelRightMargin.

	IMPORTANTE: la lógica interna de cada control (CreateButton,
	CreateToggle, CreateSlider, CreateDropdown, CreateInput,
	CreateKeybind, CreateLabel, CreateSection, CreateDivider,
	CreateStat) es la misma de siempre. Tus Callbacks/Flags
	funcionan igual.

	Concepto de pestaña: una línea angosta pegada a la izquierda, con
	el nombre siempre visible. Al tocarla NO se estira — en vez de
	eso, aparece una tarjeta aparte de esquinas redondas, cerca de las
	pestañas pero sin pegarse, centrada verticalmente en la pantalla,
	con las lógicas (sliders/toggles/etc.) adentro. Solo una tarjeta
	puede estar abierta a la vez; tocar otra pestaña cierra la
	anterior. Arriba, la hora exacta de tu reloj (la pone tu PC).
	Tema: negro muy oscuro con rojo vivo como color de acento.

	Uso (idéntico a antes):

		local UI = loadstring(game:HttpGet("...AzucarLegit.lua"))()
		local Window = UI:CreateWindow({ Title = "Azúcar Hub" })
		local Combate = Window:CreateTab({ Name = "Combate" })
		Combate:CreateToggle({ Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state) ... end })
		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) ... end })
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = {}

UI.Version    = "1.3.10"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}

-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarLegit] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

