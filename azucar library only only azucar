-- 	CAJAS (groupbox) dentro de cada pestaña
-- ============================================================
-- La caja usa el MISMO fondo que la ventana (transparente), así el
-- título que corta el borde queda limpio.
local function newGroup(tab, title)
	local hL, hR = tab._heights[1], tab._heights[2]
	local col = (hL <= hR) and 1 or 2
	local column = tab._cols[col]
	local frame = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = #column:GetChildren(), Parent = column,
	}, { stroke(Theme.Border, 1) })
	-- Esquinitas de acento (detalle retro).
	for _, c in ipairs({ { 0, -1, 0, -1 }, { 1, -2, 0, -1 }, { 0, -1, 1, -2 }, { 1, -2, 1, -2 } }) do
		new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Position = UDim2.new(c[1], c[2], c[3], c[4]), Size = UDim2.new(0, 3, 0, 3), ZIndex = 4, Parent = frame })
	end
	local titleLabel
	if title then
		titleLabel = label({
			Text = "  " .. tostring(title) .. " ", TextColor3 = Theme.Active, BackgroundTransparency = 0, BackgroundColor3 = Theme.Background,
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 14), Position = UDim2.new(0, 8, 0, -8), ZIndex = 5, Parent = frame,
		})
		new("Frame", { BackgroundColor3 = Theme.Active, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 5, 0.5, 0), Size = UDim2.new(0, 5, 0, 5), Parent = titleLabel })
	end
	local body = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = frame,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), pad(8, title and 12 or 8, 8, 8) })
	tab._heights[col] = tab._heights[col] + (title and 28 or 20)
	local grp = { body = body, col = col, frame = frame, title = titleLabel }
	tab._grp = grp
	return grp
end

local function tabBody(tab, height)
	local grp = tab._grp or newGroup(tab, nil)
	tab._heights[grp.col] = tab._heights[grp.col] + (height or 20) + 4
	return grp.body
end

local function makeOption(tab)
	local opt = { Active = false }
	function opt.SetActive(active)
		opt.Active = not not active
		tab.Window:_activeRefresh()
	end
	function opt.SetOpen() end
	table.insert(tab._opts, opt)
	tab.Window:_activeRefresh()
	return opt
end

local function rowFrame(parent, height, order)
	return new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), LayoutOrder = order, Parent = parent,
	})
end

