-- Tema oscuro: negro con un toque del color del sabor (fondo, filas, bordes).
local function darkTheme(accent)
	local black, white = Color3.new(0, 0, 0), Color3.new(1, 1, 1)
	return {
		Background = black:Lerp(accent, 0.05),
		Panel      = black:Lerp(accent, 0.09),
		Field      = black:Lerp(accent, 0.12),
		RowIdle    = black:Lerp(accent, 0.07),
		Line       = black:Lerp(accent, 0.11),
		LineOpen   = black:Lerp(accent, 0.2),
		Border     = black:Lerp(accent, 0.8),
		Text       = white:Lerp(accent, 0.08),
		TextDim    = Color3.fromRGB(150, 150, 158):Lerp(accent, 0.25),
		Active     = accent,
	}
end

