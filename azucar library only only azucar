function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
	local text = config.Text or config.Name or config.Title or "Botón"

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Btn = new("TextButton", {
		Text = text,
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 0, 10, 0, 10) })
	hoverRow(Btn)

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)

	function Button:Set(...)
		Btn.TextColor3 = Theme.Active
		task.delay(0.15, function()
			if Btn.Parent then Btn.TextColor3 = Theme.Text end
		end)
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set

	function Button:Stop()
		stopAllThreads(self)
	end

	table.insert(window._connections, Btn.MouseButton1Click:Connect(function()
		Button:Set()
	end))

	registerFlag(config.Flag, Button, nil)
	return Button
end

-- ============================================================
--  TOGGLE
-- ============================================================
function UI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)

	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end
	state = not not state

	local Row, window = baseRow(self, 30)
	if not Row then return setmetatable({}, Stub) end
	hoverRow(Row)

	rowLabel(Row, config.Text or config.Name or "Opción", 26)

	local Box = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(1, -14, 0.5, -7),
		BackgroundColor3 = state and Theme.Active or Theme.PanelAlt,
		BorderSizePixel = 0,
		Parent = Row,
	}, { corner(3), stroke(Theme.Border, 1) })

	local Toggle = setmetatable({ Box = Box, Value = state, Callback = callback, _threads = {} }, UI)

	onAccent(function()
		if Box.Parent then
			Box.BackgroundColor3 = Toggle.Value and Theme.Active or Theme.PanelAlt
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		tween(Box, { BackgroundColor3 = newState and Theme.Active or Theme.PanelAlt })
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end

	function Toggle:Get()
		return self.Value
	end

	function Toggle:Stop()
		stopAllThreads(self)
	end

	local Click = clickLayer(Row)
	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end))

	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

-- ============================================================
--  SLIDER
-- ============================================================
function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)

	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then
		rangeMin = rangeMin or config.Range[1]
		rangeMax = rangeMax or config.Range[2]
	end
	local min = rangeMin or 0
	local max = rangeMax or 100
	if max <= min then max = min + 1 end

	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end

	local decimals = 0
	if step < 1 then
		decimals = #tostring(step):gsub("^%d*%.?", "")
		if decimals > 3 then decimals
