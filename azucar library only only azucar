end

-- ============================================================
--  CREATE TAB  (línea que se alarga y despliega hacia abajo)
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))

	if self.EmptyHint then
		self.EmptyHint:Destroy()
		self.EmptyHint = nil
	end

	-- ---- Bloque de la pestaña: Line (barra) + Panel (desplegable) ----
	local TabBlock = new("Frame", {
		Name = name .. "Block",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		LayoutOrder = #self._tabs + 1,
		Parent = self.Body,
	}, { corner(4), stroke(Theme.Border, 1) })

	local Line = new("TextButton", {
		Name = name .. "Line",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = TabBlock,
	}, { corner(4) })

	-- Barrita de acento: visible cuando la pestaña está abierta.
	local TabMark = new("Frame", {
		Name = "Mark",
		Size = UDim2.new(0, 3, 0, 18),
		Position = UDim2.new(0, 0, 0.5, -9),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = Line,
	}, { corner(2) })
	onAccent(function()
		if TabMark.Parent then
			TabMark.BackgroundColor3 = Theme.Active
		end
	end)

	-- Ícono: letra/emoji o imagen (rbxassetid://...).
	local icon = config.Icon
	local iconIsImage = false
	local iconImage = icon
	if typeof(icon) == "string" then
		if icon:match("^rbxassetid://") or icon:match("^http") then
			iconIsImage = true
		elseif icon:match("^%d+$") then
			iconIsImage = true
			iconImage = "rbxassetid://" .. icon
		end
	elseif typeof(icon) == "number" then
		iconIsImage = true
		iconImage = "rbxassetid://" .. tostring(icon)
	end

	local IconBox
	if iconIsImage then
		IconBox = new("ImageLabel", {
			Name = "Icon",
			Image = iconImage,
			ScaleType = Enum.ScaleType.Fit,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(0, 8, 0.5, -10),
			Parent = Line,
		})
	else
		IconBox = new("TextLabel", {
			Name = "Icon",
			Text = (typeof(icon) == "string" and icon ~= "" and icon)
				or string.upper(string.sub(name, 1, 1)),
			Font = Theme.FontBold,
			TextSize = 12,
			TextColor3 = Theme.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ClipsDescendants = true,
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(0, 8, 0.5, -10),
			Parent = Line,
		})
	end

	local TabName = new("TextLabel", {
		Name = "TabName",
		Text = name,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ClipsDescendants = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 34, 0, 0),
		Size = UDim2.new(1, -52, 1, 0),
		Parent = Line,
	})

	local Arrow = new("TextLabel", {
		Name = "Arrow",
		Text = "▸",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -20, 0, 0),
		Size = UDim2.new(0, 16, 1, 0),
		Parent = Line,
	})

	-- ---- Panel desplegable (oculto hasta que se presiona la línea) ----
	local Panel = new("Frame", {
		Name = name .. "Panel",
		Size = UDim2.new(1, 0, 0, self.PANEL_H),
		Position = UDim2.new(0, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		Parent = TabBlock,
	})

	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 0),
		Parent = Panel,
	})

	local PanelTitle = new("TextLabel", {
		Name = "PanelTitle",
		Text = string.upper(name),
		Font = Theme.FontBold,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = Panel,
	}, { pad(0, 0, 10, 0, 10) })

	local List = new("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -24),
		Position = UDim2.new(0, 0, 0, 24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Panel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 4, 0, 8, 0),
	})

	local Tab = setmetatable({
		Window       = self,
		Block        = TabBlock,
		Button       = Line,
		Mark         = TabMark,
		IconBox      = IconBox,
		NameLabel    = TabName,
		Arrow        = Arrow,
		IconIsImage  = iconIsImage,
		Panel        = Panel,
		PanelTitle   = PanelTitle,
		List         = List,
		Name         = name,
		_rowCount    = 0,
		_groupPanels = {},
	}, UI)

	-- Animación de la línea: al abrir, se alarga (crece el bloque).
	local function setOpen(open)
		local targetH = open and (30 + self.PANEL_H) or 30
		Panel.Visible = open
		tween(TabBlock, { Size = UDim2.new(1, 0, 0, targetH) }, 0.16)
		TabMark.BackgroundTransparency = open and 0 or 1
		Arrow.Text = open and "▾" or "▸"
		Arrow.TextColor3 = open and Theme.Active or Theme.TextDim
		TabName.TextColor3 = open and Theme.Active or Theme.Text
		if not open and not Tab.IconIsImage then
			IconBox.TextColor3 = Theme.TextDim
		end
		-- Llevar el bloque a la vista dentro del scroll del cuerpo.
		if open then
			task.defer(function()
				pcall(function()
					local dy = TabBlock.AbsolutePosition.Y - self.Body.AbsolutePosition.Y
					local targetY = math.max(dy - 4, 0)
					tween(self.Body, { CanvasPosition = Vector2.new(0, targetY) }, 0.2)
				end)
			end)
		end
	end

	Line.MouseEnter:Connect(function()
		if not Panel.Visible then
			tween(Line, { BackgroundColor3 = Theme.PanelAlt })
		end
	end)
	Line.MouseLeave:Connect(function()
		if not Panel.Visible then
			tween(Line, { BackgroundColor3 = Theme.Row })
		end
	end)

	table.insert(self._connections, Line.MouseButton1Click:Connect(function()
		if Panel.Visible then
			self:SelectTab(nil)
		else
			self:SelectTab(name)
		end
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

-- Abre UNA pestaña y cierra las demás (acordeón de una sola abierta).
function UI:SelectTab(name)
	for _, tab in ipairs(self._tabs or {}) do
		local open = (name ~= nil and tab.Name == name)
		if tab.Panel.Visible ~= open then
			local targetH = open and (30 + self.PANEL_H) or 30
			tab.Panel.Visible = open
			tween(tab.Block, { Size = UDim2.new(1, 0, 0, targetH) }, 0.16)
			tab.Mark.BackgroundTransparency = open and 0 or 1
			tab.Arrow.Text = open and "▾" or "▸"
			tab.Arrow.TextColor3 = open and Theme.Active or Theme.TextDim
			tab.NameLabel.TextColor3 = open and Theme.Active or Theme.Text
			if not tab.IconIsImage then
				tab.IconBox.TextColor3 = Theme.TextDim
			end
		end
	end
	if name ~= nil then
		task.defer(function()
			pcall(function()
				for _, tab in ipairs(self._tabs or {}) do
					if tab.Name == name and tab.Block.Parent then
						local dy = tab.Block.AbsolutePosition.Y - self.Body.AbsolutePosition.Y
						tween(self.Body, { CanvasPosition = Vector2.new(0, math.max(dy - 4, 0)) }, 0.2)
						break
					end
				end
			end)
		end)
	end
end

