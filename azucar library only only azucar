-- Todo lo que se pinta con el color de acento se anota acá con la
-- función exacta que necesita para repintarse. SetAccentColor recorre la
-- lista con un pcall por entrada: si un elemento ya fue destruido, el
-- resto de la interfaz igual se repinta entera.
local accentListeners = {}

local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

-- Bordes CUADRADOS en el resto de la interfaz. Se controla desde acá:
-- dejando Theme.CornerRadius en 0, todas las esquinas quedan rectas sin
-- tener que tocar una por una las decenas de llamadas a corner() que
-- hay repartidas por el archivo. Si algún día querés volver a
-- redondear TODO, cambiás ese único número. Las pestañas del riel usan
-- roundCorner() en vez de esta, para tener SU PROPIO radio fijo sin
-- afectar al resto.
local function corner(radius)
	local r = Theme.CornerRadius or 0
	if r <= 0 then
		return new("UICorner", { CornerRadius = UDim.new(0, 0) })
	end
	return new("UICorner", { CornerRadius = UDim.new(0, radius or r) })
end

-- Radio fijo, IGNORA Theme.CornerRadius. Solo para las pestañas del
-- riel, que van redondeadas aunque el resto del panel sea cuadrado.
local function roundCorner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.12), props):Play()
	return inst
end

-- Hover que lee el color EN EL MOMENTO del evento (no el que tenía
-- cuando se creó el elemento), así nunca se queda pegado con el acento
-- viejo después de un cambio de paleta.
local function hoverRow(obj)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.PanelAlt })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Row })
	end)
end

local function hoverAccent(obj)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.ActiveDim })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Active })
	end)
end

-- Desliza un elemento desde fuera de pantalla (a la izquierda) hasta su
-- posición real. "restingPos" es la posición final (la que ya tenía el
-- elemento armado); esta función lo manda afuera un instante y lo hace
-- entrar con una curva que arranca rápido y frena suave.
local function slideInFromLeft(inst, distance, duration)
	if not inst or not inst.Parent then return end
	local restingPos = inst.Position
	inst.Position = UDim2.new(restingPos.X.Scale, restingPos.X.Offset - (distance or 260), restingPos.Y.Scale, restingPos.Y.Offset)
	TweenService:Create(inst, TweenInfo.new(duration or 0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = restingPos,
	}):Play()
end

function UI:SetAccentColor(paletteName)
	local palette = Palettes[paletteName]
	if not palette then
		warn("[AzucarHackerUI] Paleta desconocida: " .. tostring(paletteName))
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Active    = palette.Active
	Theme.ActiveDim = palette.ActiveDim
	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES (SIN LÍMITE)
-- ============================================================
-- Cada disparo de un callback vive en su propio hilo y se anota en el
-- CONJUNTO controller._threads. Podés disparar el mismo control muchas
-- veces seguidas, o varios controles a la vez: ninguna lógica pisa a
-- otra, ninguna congela la interfaz, y :Stop() las corta TODAS.
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)

	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarHackerUI] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then
		return
	end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

-- Acepta Callback = function(...), o Logic = tabla con
-- :Enable/:Disable/:Toggle/:Set/:Run, o una función suelta.
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end

	local logic = config.Logic
	if logic == nil then
		return function() end
	end
	if typeof(logic) == "function" then
		return logic
	end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then
					logic.Enable()
					return
				end
				if not value and typeof(logic.Disable) == "function" then
					logic.Disable()
					return
				end
			end
			if typeof(logic.Toggle) == "function" then
				logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then
				logic.Set(value)
			elseif typeof(logic.Run) == "function" then
				logic.Run(value)
			else
				warn("[AzucarHackerUI] La tabla pasada en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then
		return
	end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

-- Guardar el valor de una flag SIN reventar cuando el control no tiene
-- Flag. En Lua, "tabla[nil] = valor" lanza "table index is nil" y mata
-- el hilo ahí mismo: cualquier Toggle/Slider/Dropdown creado sin Flag
-- (o sea, la mayoría) se rompía apenas lo tocabas.
local function setFlagValue(flagName, value)
	if flagName == nil then
		return
	end
	UI.FlagValues[flagName] = value
end

-- Devuelve el contenedor donde va la fila y la ventana dueña, sin
-- importar si el método se llamó sobre un Tab, sobre un Grupo, o por
-- error sobre la propia ventana.
local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		local firstTab = self._tabs[1]
		warn("[AzucarHackerUI] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return firstTab.List, self, firstTab
	end
	return nil, (self.Window or self), self
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

local function baseRow(self, height)
	local list, window, owner = host(self)
	if not list then
		return nil, window, owner
	end

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 30),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 0, 10, 0, 10) })

	return row, window, owner
end

local function rowLabel(row, text, rightGap)
	return new("TextLabel", {
		Text = tostring(text),
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(rightGap or 0), 1, 0),
		Parent = row,
	})
end

local function clickLayer(row)
	return new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = row,
	})
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title = config.Title or config.Name or "Azúcar Hub"

	-- Ancho de cada botón de pestaña (sueltos, no forman un bloque).
	local TAB_W = config.TabWidth or 130
	local TAB_H = config.TabHeight or 48
	local TAB_GAP = config.TabGap or 10
	local TABS_X = config.TabsX or 16
	local TABS_Y = config.TabsY or 16

	-- La ventana que aparece al centro con la lógica: más cuadrada que
	-- una columna larga, no una franja pegada al costado.
	local PANEL_W = config.PanelWidth or 380
	local PANEL_H = config.PanelHeight or 320

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarHackerUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = false,
	})

	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end
	ScreenGui.Parent = getGuiParent()

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	-- ---------------- Columna de tabs SUELTOS ----------------
	-- Sin fondo ni borde propio: solo un contenedor invisible que
	-- acomoda los botones en fila, cada uno separado del resto por
	-- TAB_GAP. Ninguno queda "pegado" a otro.
	local TabsHolder = new("Frame", {
		Name = "TabsHolder",
		Size = UDim2.new(0, TAB_W, 1, -(TABS_Y * 2)),
		Position = UDim2.new(0, TABS_X, 0, TABS_Y),
		BackgroundTransparency = 1,
		Parent = Root,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, TAB_GAP), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- ---------------- Notificaciones ----------------
	local NotifyHolder = new("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, 250, 1, -20),
		Position = UDim2.new(1, -262, 0, 10),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local Window = setmetatable({
		ScreenGui    = ScreenGui,
		Root         = Root,
		TabsHolder   = TabsHolder,
		NotifyHolder = NotifyHolder,
		Title        = title,
		TAB_W        = TAB_W,
		TAB_H        = TAB_H,
		PANEL_W      = PANEL_W,
		PANEL_H      = PANEL_H,
		_tabs        = {},
		_connections = {},
		_visible     = true,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- ---------------- Tecla para abrir/cerrar TODO ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	slideInFromLeft(TabsHolder, 200, 0.3)

	table.insert(UI.Windows, Window)
	return Window
end

-- ============================================================
-- 	MÉTODOS DE VENTANA
-- ============================================================
function UI:MoveTo(offsetX, offsetY)
	self.TabsHolder.Position = UDim2.new(0, offsetX, 0, offsetY)
end

function UI:SetTitle(text)
	self.Title = tostring(text)
end

function UI:Show()
	self.Root.Visible = true
	self._visible = true

	slideInFromLeft(self.TabsHolder, 200, 0.3)
	for _, tab in ipairs(self._tabs or {}) do
		if tab.Panel.Visible then
			slideInFromLeft(tab.Panel, 260, 0.35)
		end
		for _, group in pairs(tab._groupPanels) do
			if group.Instance.Visible then
				slideInFromLeft(group.Instance, 260, 0.4)
			end
		end
	end
end

function UI:Hide()
	self.Root.Visible = false
	self._visible = false
end

function UI:Toggle()
	if self._visible then
		self:Hide()
	else
		self:Show()
	end
end

function UI:Notify(config)
	config = config or {}
	local holder = self.NotifyHolder
	if not holder then return end

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(4), stroke(Theme.Border, 1), pad(8) })

	new("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.new(0, -8, 0, -8),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = card,
	})

	new("TextLabel", {
		Text = config.Title or "Aviso",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 15),
		Parent = card,
	})

	new("TextLabel", {
		Text = config.Content or config.Text or "",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 17),
		Size = UDim2.new(1, 0, 1, -17),
		Parent = card,
	})

	task.delay(config.Duration or 3, function()
		pcall(function() card:Destroy() end)
	end)
	return card
end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then
		pcall(function() self.ScreenGui:Destroy() end)
	end
	for i, w in ipairs(UI.Windows) do
		if w == self then
			table.remove(UI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	CREATE TAB — botón suelto (redondo, negro brilloso) + ventana
-- 	centrada al tocarlo
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))

	-- Botón SUELTO: su propio fondo, su propio borde, separado del resto
	-- por el espacio real que deja TabsHolder (UIListLayout + TabGap).
	-- No hay ningún panel detrás que los una a todos. Redondeado y con
	-- un degradado + franja de brillo para que se lea "negro brilloso"
	-- en vez de un rectángulo chato.
	local TabBtn = new("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.TabIdle,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, self.TAB_H),
		LayoutOrder = #self._tabs,
		Parent = self.TabsHolder,
	}, {
