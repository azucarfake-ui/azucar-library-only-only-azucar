--[[
	AzucarHackerUI  v2.1.0  "Acordeón"
	=====================================
	Pestañas verticales separadas (acordeón). Al presionar una:

	  1. La línea se ALARGA con su barra de acento, SIN romper ni
	     borrar las demás: solo se corren para dejarle espacio.
	  2. El panel se despliega HACIA ABAJO con todas sus funciones
	     (Toggle, Slider, Dropdown, Button, Input, Keybind, Stat...).
	  3. Con muchas pestañas el cuerpo scrollea: arrastrás hacia
	     abajo y encontrás las que quedaron fuera.

	Reloj de COLOMBIA (UTC-5) en la cabecera.
	Otro país: config.UtcOffset = +2, -3, etc. en CreateWindow.

	Uso:

		local UI = loadstring(game:HttpGet("...AzucarHackerUI.lua"))()

		local Window = UI:CreateWindow({ Title = "Azúcar Hub", Subtitle = "v2.1" })

		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })

		Combate:CreateToggle({
			Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state)
				while state and UI.FlagValues["AutoFarm"] do
					task.wait(0.1)
				end
			end,
		})

		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200},
			Default = 16, Callback = function(v) print(v) end })

		UI:SetAccentColor("Rojo")   -- "Rojo" | "Azul" | "Verde" | "Blanco" | "Rainbow"
]]

local TweenService      = game:GetService("TweenService")
local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")

local UI = {}

UI.Version    = "2.1.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}

-- ============================================================
--  RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarHackerUI] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
--  DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

