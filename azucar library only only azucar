-- ============================================================
-- 	SLIDER
-- ============================================================
function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)

	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then
		rangeMin = rangeMin or config.Range[1]
		rangeMax = rangeMax or config.Range[2]
	end
	local min = rangeMin or 0
	local max = rangeMax or 100
	if max <= min then max = min + 1 end

	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end

	local decimals = 0
	if step < 1 then
		decimals = #tostring(step):gsub("^%d*%.?", "")
		if decimals > 3 then decimals = 3 end
	end

	local function snap(v)
		v = math.clamp(v, min, max)
		local snapped = min + math.floor((v - min) / step + 0.5) * step
		return math.clamp(snapped, min, max)
	end

	local function show(v)
		if decimals > 0 then
			return string.format("%." .. decimals .. "f", v)
		end
		return tostring(math.floor(v + 0.5))
	end

	local value = snap(config.Default or config.CurrentValue or min)

	local Row, window = baseRow(self, 42)
	if not Row then return setmetatable({}, Stub) end

	-- El slider es más alto que una fila normal, así que necesita su
	-- propio margen vertical. Se cambia el padding con cuidado: si por lo
	-- que sea la fila no trajera uno, no se revienta acá.
	local oldPad = Row:FindFirstChildOfClass("UIPadding")
	if oldPad then
		oldPad:Destroy()
	end
	pad(0, 6, 10, 6, 10).Parent = Row

	new("TextLabel", {
		Text = config.Text or config.Name or "Valor",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -52, 0, 15),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = show(value),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 50, 0, 15),
		Position = UDim2.new(1, -50, 0, 0),
		Parent = Row,
	})
	onAccent(function()
		if ValueLabel.Parent then
			ValueLabel.TextColor3 = Theme.Active
		end
	end)

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0, 22),
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Parent = Row,
	}, { corner(2) })

	local function ratio(v)
		return (v - min) / (max - min)
	end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Track,
	}, { corner(2) })
	onAccent(function()
		if Fill.Parent then
			Fill.BackgroundColor3 = Theme.Active
		end
	end)

	local Knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10),
		Position = UDim2.new(ratio(value), -5, 0.5, -5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = Track,
	}, { corner(5) })

	local Slider = setmetatable({
		Track = Track, Fill = Fill, Knob = Knob,
		Value = value, Min = min, Max = max,
		Callback = callback, _threads = {},
	}, UI)

	local function repaint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -5, 0.5, -5)
		ValueLabel.Text = show(v)
	end

	function Slider:Set(newValue)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		setFlagValue(config.Flag, newValue)
		return safeCall(self, self.Callback, newValue)
	end

	function Slider:Get()
		return self.Value
	end

	function Slider:Stop()
		stopAllThreads(self)
	end

	-- Arrastre aislado: el listener de movimiento es global, así que cada
	-- slider comprueba que el mouse esté sobre SU propio riel antes de
	-- moverse. Y el fin del arrastre se detecta con InputEnded (que
	-- siempre dispara), nunca con input.Changed.
	local dragging = false

	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + relative * (max - min))
	end

	local function mouseIsOnThisTrack()
		local ok, mousePos = pcall(function()
			return UserInputService:GetMouseLocation()
		end)
		if not ok then return true end
		local tPos, tSize = Track.AbsolutePosition, Track.AbsoluteSize
		return mousePos.Y >= tPos.Y - 22 and mousePos.Y <= tPos.Y + tSize.Y + 22
	end

	table.insert(window._connections, Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end))

	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if mouseIsOnThisTrack() then
			setFromX(input.Position.X)
		end
	end))

	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	registerFlag(config.Flag, Slider, value)
	return Slider
end

-- ============================================================
-- 	DROPDOWN
-- ============================================================
function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}

	local function display(value)
		if typeof(value) == "Instance" then
			return value.Name
		end
		if typeof(value) == "table" and value.Name then
			return tostring(value.Name)
		end
		return tostring(value)
	end

	local function isValid(value)
		for _, opt in ipairs(options) do
			if opt == value then return true end
		end
		return false
	end

	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if wanted ~= nil and isValid(wanted) then
		selected = wanted
	end

	local Row, window = baseRow(self, 30)
	if not Row then return setmetatable({}, Stub) end
	Row.ClipsDescendants = true
	Row.ZIndex = 2

	-- Caja compartida para que listHeight() lea siempre las opciones
	-- actuales, incluso después de un :Refresh().
	local Dropdown_Options_Ref = { options }

	new("TextLabel", {
		Text = config.Text or config.Name or "Opciones",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.45, 0, 0, 30),
		ZIndex = 2,
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = selected ~= nil and display(selected) or "-",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.45, 8, 0, 0),
		Size = UDim2.new(0.55, -22, 0, 30),
		ZIndex = 2,
		Parent = Row,
	})

	-- Indicador de abierto/cerrado del acordeón.
	local Arrow = new("TextLabel", {
		Text = "+",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -12, 0, 0),
		Size = UDim2.new(0, 12, 0, 30),
		ZIndex = 2,
		Parent = Row,
	})
	onAccent(function()
		if SelectedLabel.Parent then
			SelectedLabel.TextColor3 = Theme.Active
		end
	end)

	-- ACORDEÓN, no lista flotante: al abrirse, la fila CRECE y la lista
	-- vive adentro. Una lista flotante quedaba cortada por el panel con
	-- scroll y no se podían ver las últimas opciones.
	local ROW_H = 30
	local function listHeight()
		local count = math.min(math.max(#Dropdown_Options_Ref[1], 1), 6)
		return count * 24 + 8
	end

	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, 20, 0, math.min(math.max(#options, 1), 6) * 24 + 8),
		Position = UDim2.new(0, -10, 0, ROW_H),
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		stroke(Theme.Border, 1),
		pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = setmetatable({
		Value = selected, Options = options,
		Callback = callback, _threads = {},
	}, UI)

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = display(option)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end

	function Dropdown:Get()
		return self.Value
	end

	function Dropdown:Stop()
		stopAllThreads(self)
	end

	-- Declarada acá arriba para que el clic de cada opción pueda cerrar
	-- el acordeón (se define más abajo, cuando ya existe todo lo que usa).
	local setOpen

	local function buildOptions()
		for _, child in ipairs(ListFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		if #Dropdown.Options == 0 then
			new("TextLabel", {
				Text = "(vacío)",
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.TextDim,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 22),
				ZIndex = 21,
				Parent = ListFrame,
			})
			return
		end

		for index, optionValue in ipairs(Dropdown.Options) do
			local OptionBtn = new("TextButton", {
				Text = display(optionValue),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				BackgroundColor3 = Theme.Panel,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 22),
				LayoutOrder = index,
				ZIndex = 21,
				Parent = ListFrame,
			}, { corner(3), pad(0, 0, 6, 0, 6) })

			OptionBtn.MouseEnter:Connect(function()
				tween(OptionBtn, { BackgroundColor3 = Theme.Row })
			end)
			OptionBtn.MouseLeave:Connect(function()
				tween(OptionBtn, { BackgroundColor3 = Theme.Panel })
			end)

			table.insert(window._connections, OptionBtn.MouseButton1Click:Connect(function()
				Dropdown:Set(optionValue)
				-- Cerrar el acordeón COMPLETO. Antes solo se ocultaba la
				-- lista, pero la fila quedaba estirada y dejaba un hueco
				-- vacío enorme en el panel. Esto pasaba siempre, pero se
				-- notaba sobre todo en las listas de jugadores.
				if setOpen then
					setOpen(false)
				else
					ListFrame.Visible = false
				end
			end))
		end
	end

	-- Refrescar opciones en caliente (ej: lista de jugadores del servidor).
	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		Dropdown_Options_Ref[1] = self.Options
		buildOptions()
		local h = listHeight()
		ListFrame.Size = UDim2.new(1, 20, 0, h)
		Row.Size = UDim2.new(1, 0, 0, ListFrame.Visible and (ROW_H + h + 4) or ROW_H)
		if not keepSelection then
			self.Value = self.Options[1]
			SelectedLabel.Text = self.Value ~= nil and display(self.Value) or "-"
		end
	end
	Dropdown.SetOptions = Dropdown.Refresh

	buildOptions()

	local Click = clickLayer(Row)
	Click.ZIndex = 3
	Click.Size = UDim2.new(1, 0, 0, ROW_H)

	function setOpen(open)
		ListFrame.Visible = open
		local h = listHeight()
		ListFrame.Size = UDim2.new(1, 20, 0, h)
		Row.Size = UDim2.new(1, 0, 0, open and (ROW_H + h + 4) or ROW_H)
		Arrow.Text = open and "-" or "+"
	end

	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		setOpen(not ListFrame.Visible)
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

