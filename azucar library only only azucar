-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarLegit] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

-- ============================================================
-- 	LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
-- Si volvés a ejecutar el script sin cerrar la UI, la ventana vieja
-- quedaba DEBAJO de la nueva, con su pestaña abierta, su aura y su color
-- rojo: tocabas la ventana nueva y la vieja seguía igual (parecía que
-- "no se quitaban" el color ni los anillos). Ahora, cada vez que se
-- crea una ventana, se destruyen las de cargas anteriores.
local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local STALE_NAMES = { AzucarLegit = true, AzucarSlideUI = true, AzucarHackerUI = true }

local function cleanupOldWindows(guiParent)
	-- 1) Ventanas registradas por cargas anteriores (esto también les
	--    desconecta los eventos globales).
	local registry = rawget(_G, "__AzucarLegitWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end

	-- 2) Cualquier ScreenGui viejo con nuestro nombre que sea de otra carga
	--    (incluye versiones anteriores de la librería, que no se registraban).
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then
		table.insert(places, plr.PlayerGui)
	end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		pcall(function() table.insert(places, getHui()) end)
	end
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and STALE_NAMES[child.Name]
					and child:GetAttribute("AzucarLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

