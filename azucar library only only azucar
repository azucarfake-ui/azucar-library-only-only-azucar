--[[
	AzucarMood  v1.0.0
	==================
	Mismo motor que tu otra librería (Callbacks en hilos independientes,
	Flags/FlagValues, guardado/carga automática de config, limpieza de
	ejecuciones viejas) — CreateButton, CreateToggle, CreateSlider,
	CreateDropdown, CreateInput, CreateKeybind, CreateLabel, CreateSection,
	CreateDivider, CreateStat, SaveConfig/LoadConfig/ListConfigs son
	EXACTAMENTE los mismos de siempre.

	Lo que cambia es la VENTANA:

	· Volvió al formato chico de antes: UN SOLO rectángulo compacto (riel
	  angosto de íconos a la izquierda + el contenido de la pestaña
	  adentro del mismo rectángulo), nada de tarjeta flotante aparte.

	· Tiene DOS ESTADOS DE ÁNIMO, vos elegís cuándo cambia:
		- "Ira"   → rojo intenso, el borde pulsa rápido, el panel
		            tiembla apenas, salen chispas rojas nerviosas.
		- "Calma" → celeste sereno, el borde respira lento, nada
		            tiembla, unas pocas brasas suben despacio.

	Uso:

		local UI = loadstring(game:HttpGet("...AzucarMood.lua"))()
		local Window = UI:CreateWindow({ Title = "Azúcar Hub", Mood = "Calma" })
		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })
		Combate:CreateToggle({ Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state) ... end })

		-- Cuando tu propio script detecta que fallaste o ganaste:
		UI:Fail()  -- pasa a modo Ira
		UI:Win()   -- pasa a modo Calma
		-- o directo: UI:SetMood("Ira") / UI:SetMood("Calma")
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")

local UI = {}

UI.Version    = "1.0.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}
UI.ConfigFolder = "AzucarMood"

local autoSaveTargets = {}
local loadingConfig = false
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

