	return new("UICorner", { CornerRadius = UDim.new(1, 0) })
end
function UI:SetCornerStyle(mode)
	if mode ~= "Round" and mode ~= "Sharp" then
		warn("[AzucarDulce] Modo de esquina desconocido: " .. tostring(mode) .. ". Usá \"Round\" o \"Sharp\".")
		return
	end
	CornerMode = mode
	for _, fn in ipairs(cornerListeners) do pcall(fn) end
end
local function stroke(color, thickness) return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 }) end
local function accentStroke(thickness)
	local s = stroke(Theme.Border, thickness)
	onAccent(function() if s.Parent then s.Color = Theme.Border end end)
	return s
end
local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top or all or 0), PaddingRight = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0), PaddingLeft = UDim.new(0, left or all or 0),
	})
end
local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end
local function textW(text, size, font)
	local ok, w = pcall(function() return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100)).X end)
	if ok and w then return w end
	return #text * size * 0.6
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES + FLAGS
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end
	local args = table.pack(...)
	if controller then controller._threads = controller._threads or {} end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then controller._threads[thisThread] = true end
		local ok, err = pcall(function() fn(table.unpack(args, 1, args.n)) end)
		if not ok then
			warn("[AzucarDulce] Error en tu callback: " .. tostring(err))
		end
		if controller and controller._threads then controller._threads[thisThread] = nil end
	end)
end
local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do pcall(task.cancel, th) end
	controller._threads = {}
end
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then return config.Callback end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else warn("[AzucarDulce] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.") end
		end
	end
	return function() end
end
local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end
local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do UI:SaveConfig(name) end
	end
end
local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end
local function host(self)
	if self.List then return self.List, (self.Window or self), self end
	if self._tabs and self._tabs[1] then
		warn("[AzucarDulce] Creaste un control sobre la ventana en vez de sobre una pestaña. Se agregó a la primera pestaña.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	DÓNDE COLGAR LA UI + LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then return hui end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then
		if pcall(function() local p = Instance.new("Folder") p.Parent = coreGui p:Destroy() end) then
			return coreGui
		end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then table.insert(places, plr.PlayerGui) end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and (child.Name == "AzucarDulce" or child.Name == "AzucarActiveList")
					and child:GetAttribute("AzucarLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

-- ============================================================
-- 	SCROLL SIN BARRA
-- ============================================================
-- Las tarjetas están fijas. Se desplaza:
--   • la fila de pestañas (horizontal): arrastrando una cabecera con
--     el click apretado / el dedo (la rueda solo si WheelScroll = true);
--   • la lista de opciones de cada pestaña (vertical): rueda normal,
--     dedo, o click apretado arrastrando sobre la lista.
-- Ninguna de las dos muestra barra de scroll.
local function setScrollX(window, x)
	local maxX = math.max(0, window._canvasW - window.Clip.AbsoluteSize.X)
	window._scrollX = math.clamp(x, 0, maxX)
	window.Holder.Position = UDim2.new(0, -window._scrollX, 0, 0)
end

local function beginDrag(window, kind, tab, input, onClick)
	window._drag = {
		kind = kind, tab = tab, onClick = onClick, moved = false,
		start = Vector2.new(input.Position.X, input.Position.Y),
		scrollX = window._scrollX,
		canvasY = tab and tab.List.CanvasPosition.Y or 0,
	}
end

local function pointerInGui(window)
	local p = UserInputService:GetMouseLocation()
	if not window.ScreenGui.IgnoreGuiInset then
		p = p - GuiService:GetGuiInset()
	end
	return p
end
local function pointInside(frame, p)
	local a, s = frame.AbsolutePosition, frame.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end
local function listOverflows(tab)
	return tab.List.CanvasSize.Y.Offset > tab.List.AbsoluteSize.Y + 1
end

-- Trae una pestaña a la vista: desplaza la fila de pestañas (con una
-- animación corta) hasta que la tarjeta y el espacio de sus píldoras
-- queden dentro de la pantalla.
local function tabSpan(window, tab)
	local left = tab.Root.Position.X.Offset - TAB_PAD
	return left, left + tab._openW
end
local function tabInView(window, tab)
	local left, right = tabSpan(window, tab)
	local viewL = window._scrollX
	local viewR = viewL + window.Clip.AbsoluteSize.X
	return left >= viewL - 1 and right <= viewR + 1
end
local function revealTab(window, tab)
	local clipW = window.Clip.AbsoluteSize.X
	local left, right = tabSpan(window, tab)
	right = right + window._sideW + TAB_PAD -- deja lugar para sus píldoras
	local target = window._scrollX
	if right - left > clipW then
		target = left                        -- no entra todo: que se vea al menos la tarjeta
	elseif left < target then
		target = left
	elseif right > target + clipW then
		target = right - clipW
	end
	target = math.clamp(target, 0, math.max(0, window._canvasW - clipW))
	window._scrollX = target
	tween(window.Holder, { Position = UDim2.new(0, -target, 0, 0) }, 0.25)
end

-- Se llama una vez por ventana: engancha el arrastre (y la rueda
-- sobre la fila, si WheelScroll = true).
local function hookScrolling(window)
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		local kind = input.UserInputType

		-- La rueda sobre una lista la maneja el ScrollingFrame solo.
		-- Acá solo mueve la fila de pestañas, si WheelScroll = true.
		if kind == Enum.UserInputType.MouseWheel then
			if not window._visible or not window._wheel then return end
			local p = pointerInGui(window)
			for _, tab in ipairs(window._tabs) do
				if tab._isOpen and listOverflows(tab) and pointInside(tab.List, p) then return end
			end
			if pointInside(window.Clip, p) then
				setScrollX(window, window._scrollX - input.Position.Z * 70)
			end
			return
		end

		local d = window._drag
		if not d then return end
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then return end
		-- El scroll vertical con el dedo ya lo hace el ScrollingFrame.
		if d.kind == "y" and kind == Enum.UserInputType.Touch then return end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - d.start
		if not d.moved and delta.Magnitude > 6 then d.moved = true end
		if d.moved then
			if d.kind == "x" then
				setScrollX(window, d.scrollX - delta.X)
			else
				d.tab.List.CanvasPosition = Vector2.new(0, d.canvasY - delta.Y)
			end
		end
	end))

	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		local d = window._drag
		if not d then return end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		window._drag = nil
		if d.moved then
			-- Frenó un arrastre: que el click de soltar no active nada.
			window._dragMoved = true
			task.delay(0.15, function() window._dragMoved = false end)
		elseif d.onClick then
			d.onClick()
		end
	end))
end

-- ============================================================
-- 	CREATE WINDOW — las tarjetas flotantes
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	if config.CornerStyle ~= nil then UI:SetCornerStyle(config.CornerStyle) end
	if config.Theme ~= nil then UI:SetAccentColor(config.Theme) end

	local title = config.Title or config.Name or "Azúcar Dulce"
	local cardW = config.TabWidth or CARD_W
	local sideW = config.SideWidth or SIDE_W

	local startX, startY = START_X, START_Y
	if typeof(config.Position) == "UDim2" then
		startX, startY = config.Position.X.Offset, config.Position.Y.Offset
	end

	local subtitleParts = {}
	if config.Badge and tostring(config.Badge) ~= "" then table.insert(subtitleParts, tostring(config.Badge)) end
	if config.ServerName and tostring(config.ServerName) ~= "" then table.insert(subtitleParts, tostring(config.ServerName)) end
	local subtitleText = table.concat(subtitleParts, "  •  ")
	local showBrand = config.ShowBrand ~= false
	local brandW = config.BrandWidth or 150
	local brandH = (subtitleText ~= "" and 40) or 28

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarDulce", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999, IgnoreGuiInset = config.IgnoreGuiInset ~= false,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("AzucarLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	-- Contenedor de todas las tarjetas (para mostrar/ocultar de una).
	-- No tapa el juego: es transparente y no recibe clicks.
	local Container = new("Frame", {
		Name = "Container", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = ScreenGui,
	})

	-- Franja de pestañas: UNA sola fila arriba. Es un marco que recorta y
	-- adentro un "Holder" que se desplaza de costado (sin barra).
	local maxH = config.MaxListHeight -- nil = la lista usa todo el alto disponible de la pantalla
	local stripX = startX + (showBrand and (brandW + 10) or 0)
	local bandH = maxH and (HEADER_H + maxH + 10 + TAB_PAD * 2 + 6) or nil
	local Clip = new("Frame", {
		Name = "Strip", Position = UDim2.new(0, stripX, 0, startY - TAB_PAD), Size = bandH and UDim2.new(1, -(stripX + startX), 0, bandH) or UDim2.new(1, -(stripX + startX), 1, -(startY - TAB_PAD)),
		BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Parent = Container,
	})
	local Holder = new("Frame", { Name = "Holder", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Clip })

	local Window = setmetatable({
		ScreenGui = ScreenGui, Container = Container, Clip = Clip, Holder = Holder,
		_tabs = {}, _connections = {}, _visible = true, _loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0, _loadOrder = config.AutoLoadOrder,
		_cardW = cardW, _sideW = sideW, _pitch = cardW + sideW + TAB_GAP, _maxH = maxH, _minH = config.MinListHeight or 0, _wheel = config.WheelScroll == true, _startY = startY, _activeExtra = config.ActiveListLength or ACTIVE_LIST_EXTRA,
		_scrollX = 0, _canvasW = 0, _dragMoved = false,
	}, UI)
	hookScrolling(Window)

	-- Tarjetita de marca: título + Badge/ServerName + reloj. Fija, no se mueve.
	if showBrand then
		local Brand = new("Frame", {
			Name = "Brand", Size = UDim2.new(0, brandW, 0, brandH), Position = UDim2.new(0, startX, 0, startY),
			BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.Alpha, BorderSizePixel = 0,
			ZIndex = 5, Parent = Container,
		}, { corner(14), accentStroke(1.5) })
		new("TextLabel", {
			Text = title, Font = Theme.FontTitle, TextSize = 13, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 5), Size = UDim2.new(1, -66, 0, 16), Parent = Brand,
		})
		if subtitleText ~= "" then
			new("TextLabel", {
				Text = subtitleText, Font = Theme.Font, TextSize = 10, TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 22), Size = UDim2.new(1, -20, 0, 14), Parent = Brand,
			})
		end
		local ClockLabel = new("TextLabel", {
			Text = os.date("%H:%M:%S"), Font = Theme.FontMono, TextSize = 11, TextColor3 = Theme.Active,
			TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, BackgroundTransparency = 1,
			Position = UDim2.new(1, -58, 0, 6), Size = UDim2.new(0, 50, 0, 14), Parent = Brand,
		})
		onAccent(function() if ClockLabel.Parent then ClockLabel.TextColor3 = Theme.Active end end)
		task.spawn(function() while ClockLabel.Parent do ClockLabel.Text = os.date("%H:%M:%S") task.wait(1) end end)
	end

	-- Mostrar/ocultar con una tecla. config.ToggleKey = false/nil desactiva el atajo.
	local toggleKey = config.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.K end
	if toggleKey then
		table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == toggleKey then
				local ok, err = pcall(function() Window:Toggle() end)
				if not ok then
					warn("[AzucarDulce] Error al abrir/cerrar con " .. tostring(toggleKey) .. ": " .. tostring(err))
				end
			end
		end))
	end

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) ~= "table" then registry = {} rawset(_G, "__AzucarDulceWindows", registry) end
	table.insert(registry, Window)

	-- ---------------- Guardado/carga de configuración ----------------
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do table.insert(autoSaveIgnore, word) end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	if config.ActiveList ~= false then Window:SetActiveList(true) end

	return Window
end

function UI:Show()
	self.Container.Visible = true
	self._visible = true
end
function UI:Hide()
	self.Container.Visible = false
	self._visible = false
end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
-- ============================================================
-- 	LISTA DE ACTIVOS (pegada al borde derecho de la pantalla)
-- ============================================================
-- Window:SetActiveList(true/false). Tocás una etiqueta y esa pestaña se
-- ABRE (y la fila se desplaza hasta dejarla a la vista; si ya estaba
-- abierta y a la vista, el toque la cierra). Una etiquetita por pestaña, pegada
-- al borde derecho: arriba la que más opciones activas tiene y abajo la
-- que menos. Cada una mide lo que mide su nombre, así la de nombre más
-- largo sobresale más. Cuando la pestaña está abierta, toda su etiqueta
-- (nombre, flechita, número, borde) se pone del color del tema (openColor; si querés un color
-- fijo, ACTIVE_LIST_COLOR arriba del archivo). Viene prendida por defecto; CreateWindow({ ActiveList = false }) la apaga.
function UI:SetActiveList(on)
	local window = self
	on = not not on
	if window._activeGui then
		window._activeGui.Enabled = on
		if on and window._activeRefresh then window._activeRefresh() end
		return
	end
	if not on then return end

	local OVER, TAG_H = 12, 20 -- OVER: parte de la etiqueta escondida fuera de la pantalla (así no se ve redondeada contra el borde)
	local gui = new("ScreenGui", {
		Name = "AzucarActiveList", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 997,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = window.ScreenGui.Parent,
	})
	window._activeGui = gui
	gui:SetAttribute("AzucarLoadId", LOAD_ID)
	local holder = new("Frame", {
		Name = "List", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, OVER, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }),
	})

	local rows = {}
	local function getRow(i)
		if rows[i] then return rows[i] end
		local tag = new("Frame", {
			Size = UDim2.new(0, 60, 0, TAG_H), BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.Alpha,
			BorderSizePixel = 0, LayoutOrder = i, Parent = holder,
		}, { corner(8), accentStroke(1.2) })
		local nm = new("TextLabel", {
			BackgroundTransparency = 1, Font = Theme.FontBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -20, 1, 0), Parent = tag,
		})
		local ct = new("TextLabel", {
			BackgroundTransparency = 1, Font = Theme.FontMono, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -OVER - 6, 0, 0), Size = UDim2.new(0, 22, 1, 0), Parent = tag,
			TextStrokeColor3 = openColor(), TextStrokeTransparency = 0.6,
		})
		local ar = new("TextLabel", {
			Text = ">", BackgroundTransparency = 1, Font = Theme.FontBold, TextSize = 12,
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.new(0, 12, 1, 0), Parent = tag,
			TextStrokeColor3 = openColor(), TextStrokeTransparency = 0.6,
		})
		local r = { tag = tag, nm = nm, ct = ct, ar = ar, glow = false }
		local btn = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5, Parent = tag })
		btn.MouseButton1Click:Connect(function()
			local tb = r.tab
			if not tb then return end
			if not window._visible then window:Show() end
			-- Abre la pestaña y la trae a la vista (por si estaba fuera de
			-- pantalla). Si ya estaba abierta y a la vista, la cierra.
			if tb._isOpen and tabInView(window, tb) then
				tb:SetOpen(false)
			else
				tb:SetOpen(true)
				revealTab(window, tb)
			end
		end)
		rows[i] = r
		return r
	end

	local function refresh()
		if not gui.Parent then return end
		local list = {}
		for _, tab in ipairs(window._tabs) do
			local a = 0
			for _, o in ipairs(tab._opts) do if o.Active then a = a + 1 end end
			list[#list + 1] = { name = tab.Name, a = a, tab = tab }
		end
		table.sort(list, function(x, y) if x.a ~= y.a then return x.a > y.a end return x.name < y.name end)
		for i, d in ipairs(list) do
			local r = getRow(i)
			r.tab = d.tab
			r.tag.Visible = true; r.tag.LayoutOrder = i
			r.tag.BackgroundColor3 = Theme.Background
			local open = d.tab._isOpen
			r.nm.Text = d.name
			r.ar.Text = open and "<" or ">"
			r.ct.Text = tostring(d.a)
			if open then
				-- Pestaña abierta: toda la etiqueta del color del tema.
				r.nm.TextColor3 = openColor()
				r.ar.TextColor3 = openColor()
				r.ct.TextColor3 = openColor()
				r.ar.TextStrokeColor3 = openColor()
				r.ct.TextStrokeColor3 = openColor()
			else
				r.nm.TextColor3 = d.a > 0 and Theme.Text or Theme.TextDim
				r.ar.TextColor3 = Theme.TextDim
				r.ct.TextColor3 = d.a > 0 and Theme.Active or Theme.TextDim
			end
			local tagStroke = r.tag:FindFirstChildOfClass("UIStroke")
			if tagStroke then tagStroke.Color = open and openColor() or Theme.Border end
			r.glow = open
			if not open then
				r.ar.TextStrokeTransparency = 1
				r.ct.TextStrokeTransparency = 1
			end
			r.tag.Size = UDim2.new(0, math.ceil(textW(d.name, 11, Theme.FontBold)) + 20 + 22 + OVER + 12 + (window._activeExtra or ACTIVE_LIST_EXTRA), 0, TAG_H)
		end
		for i = #list + 1, #rows do rows[i].tag.Visible = false end
	end
	window._activeRefresh = refresh
	onAccent(function() pcall(refresh) end)
	refresh()

	-- Brillo: el halo naranja de la flechita y del número late despacito.
	task.spawn(function()
		local bright = true
		while gui.Parent do
			local goal = bright and 0.1 or 0.5
			for _, r in ipairs(rows) do
				if r.tag.Visible and r.glow then
					tween(r.ar, { TextStrokeTransparency = goal }, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
					tween(r.ct, { TextStrokeTransparency = goal }, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				end
			end
			bright = not bright
			task.wait(0.9)
		end
	end)
end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do pcall(function() conn:Disconnect() end) end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	if self._activeGui then pcall(function() self._activeGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do if w == self then table.remove(UI.Windows, i) break end end
end

-- ============================================================
-- 	NOTIFICACIONES
-- ============================================================
-- Window:Notify("Listo") o Window:Notify({ Title = "...", Text = "...",
-- Duration = 3 }). Aparece abajo a la derecha, en una tarjetita
-- redondeada, se queda Duration segundos (3 por defecto) y se va sola
-- con un fundido. Si mandás varias, se apilan.
function UI:Notify(config)
	if typeof(config) == "string" then config = { Text = config } end
	config = config or {}

	local ScreenGui = self.ScreenGui
	if not ScreenGui then
		warn("[AzucarDulce] Notify se llama sobre la ventana: Window:Notify(...).")
		return
	end

	local titleText = config.Title
	local bodyText = config.Text or config.Message or config.Content or ""
	local duration = config.Duration or 3
	local hasTitle = titleText ~= nil and tostring(titleText) ~= ""

	local Holder = self._notifyHolder
	if not Holder then
		Holder = new("Frame", {
			Name = "Notifications",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0, 260, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 100,
			Parent = ScreenGui,
		}, {
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		self._notifyHolder = Holder
		self._notifyCount = 0
	end

	self._notifyCount = (self._notifyCount or 0) + 1
	local cardH = hasTitle and 54 or 40

	local Card = new("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, cardH),
		BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = self._notifyCount,
		ZIndex = 101,
		Parent = Holder,
	}, { corner(14), stroke(Theme.Border, 1.5) })

	new("Frame", {
		Size = UDim2.new(0, 4, 1, -14), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0),
		BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Card,
	}, { corner(2) })

	if hasTitle then
		new("TextLabel", {
			Text = tostring(titleText), Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 8), Size = UDim2.new(1, -28, 0, 16),
			Parent = Card,
		})
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 26), Size = UDim2.new(1, -28, 0, 22),
			Parent = Card,
		})
	else
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 0), Size = UDim2.new(1, -28, 1, 0),
			Parent = Card,
		})
	end

	tween(Card, { GroupTransparency = 0 }, 0.25)
	task.delay(duration, function()
		if not Card.Parent then return end
		tween(Card, { GroupTransparency = 1 }, 0.3)
		task.delay(0.3, function()
			if Card.Parent then Card:Destroy() end
		end)
	end)

	return Card
end

-- ============================================================
-- 	ÍCONOS DE PESTAÑA
-- ============================================================
-- CreateTab({ Name = "Combat", Icon = "Swords" }) o CreateTab("Combat", "Swords").
-- Los íconos se dibujan con formas (no dependen de ninguna letra) y toman
-- el color del tema.
-- Nombres: Swords, Eye, Book, Rings, Heart, Diamond, Moon, Skull, Star
-- (también valen Sword, Target, Circles, Gem). Icon también acepta:
--   • un id de imagen (número o "rbxassetid://123") -> imagen propia;
--   • cualquier otro texto o emoji ("★", "🔥") -> se muestra tal cual.
-- Después de crear la pestaña: Tab:SetIcon("Eye") (o nil para quitarlo).
--
-- Tamaño: ICON_SIZE (px). Todo el dibujo está en una cuadrícula de 20x20
-- y se escala solo; si lo cambiás, poné ICON_W = ICON_SIZE + 5.
local ICON_SIZE, ICON_W = 20, 25
local GRID = 20
local Icons = {}
UI.Icons = Icons

-- Una pieza del dibujo: centro (cx, cy) y tamaño (w, h), en unidades de la
-- cuadrícula. Todo va en ESCALA (no en píxeles sueltos), así no se pierden
-- los decimales. fill = relleno del color del tema; stroke = solo contorno
-- (grosor); cut = "agujero" (pinta del color del fondo); round = esquinas
-- (true = círculo, número = radio); rot = giro en grados.
local function part(root, st, cx, cy, w, h, o)
	o = o or {}
	local fr = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx / GRID, cy / GRID),
		Size = UDim2.fromScale(w / GRID, h / GRID),
		Rotation = o.rot or 0,
		BorderSizePixel = 0,
		BackgroundTransparency = (o.fill or o.cut) and 0 or 1,
		Parent = root,
	})
	if o.round ~= nil then
		local r = 0.5
		if o.round ~= true then r = math.clamp(o.round / math.min(w, h), 0, 0.5) end
		new("UICorner", { CornerRadius = UDim.new(r, 0), Parent = fr })
	end
	if o.fill then table.insert(st.fills, fr) end
	if o.cut then table.insert(st.cuts, fr) end
	if o.stroke then
		table.insert(st.strokes, new("UIStroke", {
			Thickness = o.stroke * ICON_SIZE / GRID, Color = Theme.Active, Parent = fr,
		}))
	end
	return fr
end

-- Trazo con puntas redondas entre dos puntos de la cuadrícula.
local function line(root, st, x1, y1, x2, y2, thick)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	local fr = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale((x1 + x2) / 2 / GRID, (y1 + y2) / 2 / GRID),
		Size = UDim2.fromScale((len + thick) / GRID, thick / GRID),
		Rotation = math.deg(math.atan2(dy, dx)),
		BorderSizePixel = 0,
		Parent = root,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = fr })
	table.insert(st.fills, fr)
	return fr
end

