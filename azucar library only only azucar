-- CONTIENE la palabra, sin importar mayúsculas/minúsculas — así no
-- importa si tu Flag es "MiniPekka", "mini_pekka_toggle", etc.
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

