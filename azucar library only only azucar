local accentListeners = {}

local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

-- ============================================================
--  HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	local r = Theme.CornerRadius or 0
	if r <= 0 then
		return new("UICorner", { CornerRadius = UDim.new(0, 0) })
	end
	return new("UICorner", { CornerRadius = UDim.new(0, radius or r) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.12), props):Play()
	return inst
end

local function hoverRow(obj)
	local mark = new("Frame", {
		Name = "HoverMark",
		Size = UDim2.new(0, 2, 1, -10),
		Position = UDim2.new(0, 0, 0, 5),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = obj,
	})
	onAccent(function()
		if mark.Parent then
			mark.BackgroundColor3 = Theme.Active
		end
	end)

	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.PanelAlt })
		tween(mark, { BackgroundTransparency = 0 })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Row })
		tween(mark, { BackgroundTransparency = 1 })
	end)
end

local function hoverAccent(obj)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.ActiveDim })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Active })
	end)
end

local rainbowThread = nil

function UI:SetAccentColor(paletteName)
	if rainbowThread then
		pcall(task.cancel, rainbowThread)
		rainbowThread = nil
	end

	if paletteName == "Rainbow" or paletteName == "RGB" then
		UI.CurrentPalette = "Rainbow"
		rainbowThread = task.spawn(function()
			local hue = 0
			while true do
				hue = (hue + 0.006) % 1
				Theme.Active = Color3.fromHSV(hue, 0.85, 1)
				Theme.ActiveDim = Color3.fromHSV(hue, 0.85, 0.62)
				for _, listener in ipairs(accentListeners) do
					pcall(listener)
				end
				task.wait(0.03)
			end
		end)
		return
	end

	local palette = Palettes[paletteName]
	if not palette then
		warn("[AzucarHackerUI] Paleta desconocida: " .. tostring(paletteName))
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Active    = palette.Active
	Theme.ActiveDim = palette.ActiveDim
	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end

-- ============================================================
--  NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)

	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarHackerUI] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then
		return
	end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end

	local logic = config.Logic
	if logic == nil then
		return function() end
	end
	if typeof(logic) == "function" then
		return logic
	end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then
					logic.Enable()
					return
				end
				if not value and typeof(logic.Disable) == "function" then
					logic.Disable()
					return
				end
			end
			if typeof(logic.Toggle) == "function" then
				logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then
				logic.Set(value)
			elseif typeof(logic.Run) == "function" then
				logic.Run(value)
			else
				warn("[AzucarHackerUI] La tabla pasada en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then
		return
	end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

local function setFlagValue(flagName, value)
	if flagName == nil then
		return
	end
	UI.FlagValues[flagName] = value
end

local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		local firstTab = self._tabs[1]
		warn("[AzucarHackerUI] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return firstTab.List, self, firstTab
	end
	return nil, (self.Window or self), self
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

local function baseRow(self, height)
	local list, window, owner = host(self)
	if not list then
		return nil, window, owner
	end

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 30),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 0, 10, 0, 10) })

	return row, window, owner
end

local function rowLabel(row, text, rightGap)
	return new("TextLabel", {
		Text = tostring(text),
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(rightGap or 0), 1, 0),
		Parent = row,
	})
end

local function clickLayer(row)
	return new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = row,
	})
end

-- ============================================================
--  CREATE WINDOW  (acordeón vertical + reloj de Colombia)
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title    = config.Title or config.Name or "Azúcar Hub"
	local subtitle = config.Subtitle or config.SubTitle or ""
	local WIDTH    = config.Width or 264
	local HEADER_H = 46
	local PANEL_H  = config.PanelHeight or 230
	local TOP_X    = config.Position and config.Position[1] or 12
	local TOP_Y    = config.Position and config.Position[2] or 12
	-- Reloj: Colombia = UTC-5. Otro país: config.UtcOffset = +2, -3, ...
	local utcOffset  = config.UtcOffset or -5
	local countryTag = config.CountryTag or "COL"

	-- Altura total del cuerpo: que quepa en pantalla.
	local maxH = math.huge
	local okCam, cam = pcall(function()
		return workspace.CurrentCamera
	end)
	if okCam and cam then
		maxH = math.max(cam.ViewportSize.Y - TOP_Y - 24, 120)
	end
	local BODY_H = math.min(config.Height or 340, maxH)

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarHackerUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = false,
	})

	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end
	ScreenGui.Parent = getGuiParent()

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	local Shell = new("Frame", {
		Name = "Shell",
		Size = UDim2.new(0, WIDTH, 0, HEADER_H + BODY_H),
		Position = UDim2.new(0, TOP_X, 0, TOP_Y),
		BackgroundTransparency = 1,
		Parent = Root,
	})

	-- ---------------- Cabecera: título + reloj COL ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Shell,
	}, { corner(6), stroke(Theme.Border, 1) })

	local HeaderUnderline = new("Frame", {
		Name = "HeaderUnderline",
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = Header,
	})
	onAccent(function()
		if HeaderUnderline.Parent then
			HeaderUnderline.BackgroundColor3 = Theme.Active
		end
	end)

	local AccentBar = new("Frame", {
		Name = "AccentBar",
		Size = UDim2.new(0, 3, 0, 18),
		Position = UDim2.new(0, 8, 0.5, -9),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Header,
	}, { corner(2) })
	onAccent(function()
		if AccentBar.Parent then
			AccentBar.BackgroundColor3 = Theme.Active
		end
	end)

	local TitleLabel = new("TextLabel", {
		Name = "Title",
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 4),
		Size = UDim2.new(1, -90, 0, 18),
		Parent = Header,
	})

	if subtitle ~= "" then
		new("TextLabel", {
			Text = subtitle,
			Font = Theme.Font,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 18, 0, 23),
			Size = UDim2.new(1, -90, 0, 14),
			Parent = Header,
		})
	end

	-- Reloj de Colombia (UTC-5), actualizado solo.
	local ClockLabel = new("TextLabel", {
		Name = "Clock",
		Text = "COL --:--:--",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, 86, 0, 16),
		Parent = Header,
	})
	onAccent(function()
		if ClockLabel.Parent then
			ClockLabel.TextColor3 = Theme.Active
		end
	end)

	task.spawn(function()
		while ClockLabel.Parent do
			local okDate, t = pcall(os.time)
			if okDate then
				local utc = os.date("!*t", t + utcOffset * 3600)
				local function p2(n)
					return (n < 10 and "0" or "") .. tostring(n)
				end
				ClockLabel.Text = string.format("%s %s:%s:%s", countryTag,
					p2(utc.hour), p2(utc.min), p2(utc.sec))
			end
			task.wait(0.5)
		end
	end)

	-- ---------------- Cuerpo: lista vertical de pestañas ----------------
	local Body = new("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, BODY_H),
		Position = UDim2.new(0, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Shell,
	}, { corner(6), stroke(Theme.Border, 1) })

	local TabList = new("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = Body,
	})

	new("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 6),
		Parent = Body,
	})

	-- ---------------- Aviso "sin pestañas" ----------------
	local EmptyHint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Sin pestañas.\nRevisá la consola (F9):\nalgo cortó tu script\nantes de crearlas.",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -12, 0, 90),
		Parent = Body,
	})

	-- ---------------- Notificaciones ----------------
	local NotifyHolder = new("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, 250, 1, -20),
		Position = UDim2.new(1, -262, 0, 10),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local Window = setmetatable({
		ScreenGui    = ScreenGui,
		Root         = Root,
		Shell        = Shell,
		Header       = Header,
		TitleLabel   = TitleLabel,
		ClockLabel   = ClockLabel,
		Body         = Body,
		TabList      = TabList,
		EmptyHint    = EmptyHint,
		NotifyHolder = NotifyHolder,
		WIDTH        = WIDTH,
		HEADER_H     = HEADER_H,
		PANEL_H      = PANEL_H,
		TOP_X        = TOP_X,
		TOP_Y        = TOP_Y,
		_originX     = TOP_X,
		_originY     = TOP_Y,
		_tabs        = {},
		_connections = {},
		_visible     = true,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- ---------------- Tecla para abrir/cerrar ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(UI.Windows, Window)
	Window:Show()
	return Window
end

-- ============================================================
--  MÉTODOS DE VENTANA
-- ============================================================
local function slideOffscreenX(self)
	return -(self.WIDTH + 60)
end

function UI:Show()
	self._visible = true
	self.Root.Visible = true
	local x = self._originX or 0
	local y = self._originY or 0
	self.Shell.Position = UDim2.new(0, slideOffscreenX(self), 0, y)
	tween(self.Shell, { Position = UDim2.new(0, x, 0, y) }, 0.32)
end

function UI:Hide()
	if not self._visible then
		return
	end
	self._visible = false
	local x = self._originX or 0
	local y = self._originY or 0
	local outTween = TweenService:Create(
		self.Shell,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.new(0, slideOffscreenX(self), 0, y) }
	)
	outTween.Completed:Connect(function()
		if self._visible then return end
		self.Root.Visible = false
		self.Shell.Position = UDim2.new(0, x, 0, y)
	end)
	outTween:Play()
end

function UI:Toggle()
	if self._visible then
		self:Hide()
	else
		self:Show()
	end
end

function UI:MoveTo(x, y)
	self._originX = x
	self._originY = y
	self.Shell.Position = UDim2.new(0, x, 0, y)
end

function UI:SetTitle(text)
	if self.TitleLabel then
		self.TitleLabel.Text = tostring(text)
	end
end

function UI:Notify(config)
	config = config or {}
	local holder = self.NotifyHolder
	if not holder then return end

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(4), stroke(Theme.Border, 1), pad(8) })

	new("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.new(0, -8, 0, -8),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = card,
	})

	new("TextLabel", {
		Text = config.Title or "Aviso",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 15),
		Parent = card,
	})

	new("TextLabel", {
		Text = config.Content or config.Text or "",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 17),
		Size = UDim2.new(1, 0, 1, -17),
		Parent = card,
	})

	task.delay(config.Duration or 3, function()
		pcall(function() card:Destroy() end)
	end)
	return card
end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then
		pcall(function() self.ScreenGui:Destroy() end)
	end
	for i, w in ipairs(UI.Windows) do
		if w == self then
			table.remove(UI.Windows, i)
			break
		end
