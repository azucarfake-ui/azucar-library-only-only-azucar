-- Paleta: cambia SOLO el acento, no el fondo. Se elige con
-- config.Theme al crear la ventana o en caliente con UI:SetAccentColor(...).
local Palettes = {
	Fresa  = Color3.fromRGB(255, 105, 150),
	Chicle = Color3.fromRGB(255, 153, 204),
	Uva    = Color3.fromRGB(186, 130, 230),
	Menta  = Color3.fromRGB(110, 210, 180),
}
UI.Palettes = Palettes
UI.CurrentPalette = "Fresa"

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

function UI:SetAccentColor(paletteName)
	local color = Palettes[paletteName]
	if not color then
		warn("[AzucarDulce] Sabor desconocido: " .. tostring(paletteName) .. ". Usá Fresa, Chicle, Uva o Menta.")
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Border, Theme.Active = color, color
	Theme.ActiveDim = color:Lerp(Color3.new(0, 0, 0), 0.22)
	for _, fn in ipairs(accentListeners) do pcall(fn) end
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do inst[prop] = value end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	return inst
end

-- Modo de esquinas: "Round" (redonditas) o "Sharp" (sin radio).
local CornerMode = "Round"
local cornerListeners = {}
local function onCornerChange(fn) table.insert(cornerListeners, fn) return fn end
local function corner(radius)
	radius = radius or 0
	local inst = new("UICorner", { CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) })
	onCornerChange(function() inst.CornerRadius = UDim.new(0, CornerMode == "Round" and radius or 0) end)
	return inst
end
-- Círculo perfecto (puntitos, perillas, botoncitos): siempre redondo.
local function circle()
	return new("UICorner", { CornerRadius = UDim.new(1, 0) })
end
function UI:SetCornerStyle(mode)
	if mode ~= "Round" and mode ~= "Sharp" then
		warn("[AzucarDulce] Modo de esquina desconocido: " .. tostring(mode) .. ". Usá \"Round\" o \"Sharp\".")
		return
	end
	CornerMode = mode
	for _, fn in ipairs(cornerListeners) do pcall(fn) end
end
local function stroke(color, thickness) return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 }) end
local function accentStroke(thickness)
	local s = stroke(Theme.Border, thickness)
	onAccent(function() if s.Parent then s.Color = Theme.Border end end)
	return s
end
local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top or all or 0), PaddingRight = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0), PaddingLeft = UDim.new(0, left or all or 0),
	})
end
local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end
local function textW(text, size, font)
	local ok, w = pcall(function() return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100)).X end)
	if ok and w then return w end
	return #text * size * 0.6
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES + FLAGS
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end
	local args = table.pack(...)
	if controller then controller._threads = controller._threads or {} end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then controller._threads[thisThread] = true end
		local ok, err = pcall(function() fn(table.unpack(args, 1, args.n)) end)
		if not ok then
			warn("[AzucarDulce] Error en tu callback: " .. tostring(err))
		end
		if controller and controller._threads then controller._threads[thisThread] = nil end
	end)
end
local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do pcall(task.cancel, th) end
	controller._threads = {}
end
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then return config.Callback end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else warn("[AzucarDulce] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.") end
		end
	end
	return function() end
end
local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end
local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do UI:SaveConfig(name) end
	end
end
local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end
local function host(self)
	if self.List then return self.List, (self.Window or self), self end
	if self._tabs and self._tabs[1] then
		warn("[AzucarDulce] Creaste un control sobre la ventana en vez de sobre una pestaña. Se agregó a la primera pestaña.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	DÓNDE COLGAR LA UI + LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then return hui end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then
		if pcall(function() local p = Instance.new("Folder") p.Parent = coreGui p:Destroy() end) then
			return coreGui
		end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then table.insert(places, plr.PlayerGui) end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and child.Name == "AzucarDulce"
					and child:GetAttribute("AzucarLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

-- ============================================================
-- 	ARRASTRAR TARJETAS
-- ============================================================
-- handle = lo que recibe el toque; target = lo que se mueve.
-- Si el dedo/mouse casi no se movió, cuenta como click (onClick).
local function makeDraggable(window, handle, target, onClick, onPress)
	local dragging, moved = false, false
	local startInput, startPos
	table.insert(window._connections, handle.InputBegan:Connect(function(input)
		local k = input.UserInputType
		if k ~= Enum.UserInputType.MouseButton1 and k ~= Enum.UserInputType.Touch then return end
		dragging, moved = true, false
		startInput = Vector2.new(input.Position.X, input.Position.Y)
		startPos = target.Position
		if onPress then onPress() end
	end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local k = input.UserInputType
		if k ~= Enum.UserInputType.MouseMovement and k ~= Enum.UserInputType.Touch then return end
		local d = Vector2.new(input.Position.X, input.Position.Y) - startInput
		if not moved and d.Magnitude > 5 then moved = true end
		if moved then
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		if not dragging then return end
		local k = input.UserInputType
		if k == Enum.UserInputType.MouseButton1 or k == Enum.UserInputType.Touch then
			dragging = false
			if not moved and onClick then onClick() end
		end
	end))
end

-- ============================================================
-- 	CREATE WINDOW — las tarjetas flotantes
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	if config.CornerStyle ~= nil then UI:SetCornerStyle(config.CornerStyle) end
	if config.Theme ~= nil then UI:SetAccentColor(config.Theme) end

	local title = config.Title or config.Name or "Azúcar Dulce"
	local cardW = config.TabWidth or CARD_W
	local sideW = config.SideWidth or SIDE_W

	local startX, startY = START_X, START_Y
	if typeof(config.Position) == "UDim2" then
		startX, startY = config.Position.X.Offset, config.Position.Y.Offset
	end

	local subtitleParts = {}
	if config.Badge and tostring(config.Badge) ~= "" then table.insert(subtitleParts, tostring(config.Badge)) end
	if config.ServerName and tostring(config.ServerName) ~= "" then table.insert(subtitleParts, tostring(config.ServerName)) end
	local subtitleText = table.concat(subtitleParts, "  •  ")
	local showBrand = config.ShowBrand ~= false
	local brandW = config.BrandWidth or 150
	local brandH = (subtitleText ~= "" and 40) or 28

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarDulce", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999, IgnoreGuiInset = config.IgnoreGuiInset ~= false,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("AzucarLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	-- Contenedor de todas las tarjetas (para mostrar/ocultar de una).
	-- No tapa el juego: es transparente y no recibe clicks.
	local Container = new("Frame", {
		Name = "Container", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = ScreenGui,
	})

	local Window = setmetatable({
		ScreenGui = ScreenGui, Container = Container,
		_tabs = {}, _connections = {}, _visible = true, _loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0, _loadOrder = config.AutoLoadOrder,
		_cardW = cardW, _sideW = sideW, _pitch = cardW + sideW + TAB_GAP,
		_startX = startX + (showBrand and (brandW + 10) or 0), _startY = startY,
		_cursorX = startX + (showBrand and (brandW + 10) or 0), _cursorY = startY,
		_rowPitch = config.RowPitch or ROW_PITCH, _z = 10,
	}, UI)

	-- Tarjetita de marca: título + Badge/ServerName + reloj. Se puede arrastrar.
	if showBrand then
		local Brand = new("Frame", {
			Name = "Brand", Size = UDim2.new(0, brandW, 0, brandH), Position = UDim2.new(0, startX, 0, startY),
			BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.Alpha, BorderSizePixel = 0,
			ZIndex = 5, Parent = Container,
		}, { corner(14), accentStroke(1.5) })
		new("TextLabel", {
			Text = title, Font = Theme.FontTitle, TextSize = 13, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 5), Size = UDim2.new(1, -66, 0, 16), Parent = Brand,
		})
		if subtitleText ~= "" then
			new("TextLabel", {
				Text = subtitleText, Font = Theme.Font, TextSize = 10, TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 22), Size = UDim2.new(1, -20, 0, 14), Parent = Brand,
			})
		end
		local ClockLabel = new("TextLabel", {
			Text = os.date("%H:%M:%S"), Font = Theme.FontMono, TextSize = 11, TextColor3 = Theme.Active,
			TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, BackgroundTransparency = 1,
			Position = UDim2.new(1, -58, 0, 6), Size = UDim2.new(0, 50, 0, 14), Parent = Brand,
		})
		onAccent(function() if ClockLabel.Parent then ClockLabel.TextColor3 = Theme.Active end end)
		task.spawn(function() while ClockLabel.Parent do ClockLabel.Text = os.date("%H:%M:%S") task.wait(1) end end)
		makeDraggable(Window, Brand, Brand, nil, nil)
	end

	-- Mostrar/ocultar con una tecla. config.ToggleKey = false/nil desactiva el atajo.
	local toggleKey = config.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.K end
	if toggleKey then
		table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == toggleKey then
				local ok, err = pcall(function() Window:Toggle() end)
				if not ok then
					warn("[AzucarDulce] Error al abrir/cerrar con " .. tostring(toggleKey) .. ": " .. tostring(err))
				end
			end
		end))
	end

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) ~= "table" then registry = {} rawset(_G, "__AzucarDulceWindows", registry) end
	table.insert(registry, Window)

	-- ---------------- Guardado/carga de configuración ----------------
	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do table.insert(autoSaveIgnore, word) end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	return Window
end

function UI:Show()
	self.Container.Visible = true
	self._visible = true
end
function UI:Hide()
	self.Container.Visible = false
	self._visible = false
end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do pcall(function() conn:Disconnect() end) end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do if w == self then table.remove(UI.Windows, i) break end end
end

-- ============================================================
-- 	NOTIFICACIONES
-- ============================================================
-- Window:Notify("Listo") o Window:Notify({ Title = "...", Text = "...",
-- Duration = 3 }). Aparece abajo a la derecha, en una tarjetita
-- redondeada, se queda Duration segundos (3 por defecto) y se va sola
-- con un fundido. Si mandás varias, se apilan.
function UI:Notify(config)
	if typeof(config) == "string" then config = { Text = config } end
	config = config or {}

	local ScreenGui = self.ScreenGui
	if not ScreenGui then
		warn("[AzucarDulce] Notify se llama sobre la ventana: Window:Notify(...).")
		return
	end

	local titleText = config.Title
	local bodyText = config.Text or config.Message or config.Content or ""
	local duration = config.Duration or 3
	local hasTitle = titleText ~= nil and tostring(titleText) ~= ""

	local Holder = self._notifyHolder
	if not Holder then
		Holder = new("Frame", {
			Name = "Notifications",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0, 260, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 100,
			Parent = ScreenGui,
		}, {
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		self._notifyHolder = Holder
		self._notifyCount = 0
	end

	self._notifyCount = (self._notifyCount or 0) + 1
	local cardH = hasTitle and 54 or 40

	local Card = new("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, cardH),
		BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = self._notifyCount,
		ZIndex = 101,
		Parent = Holder,
	}, { corner(14), stroke(Theme.Border, 1.5) })

	new("Frame", {
		Size = UDim2.new(0, 4, 1, -14), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0),
		BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Card,
	}, { corner(2) })

	if hasTitle then
		new("TextLabel", {
			Text = tostring(titleText), Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 8), Size = UDim2.new(1, -28, 0, 16),
			Parent = Card,
		})
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 26), Size = UDim2.new(1, -28, 0, 22),
			Parent = Card,
		})
	else
		new("TextLabel", {
			Text = tostring(bodyText), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 0), Size = UDim2.new(1, -28, 1, 0),
			Parent = Card,
		})
	end

	tween(Card, { GroupTransparency = 0 }, 0.25)
	task.delay(duration, function()
		if not Card.Parent then return end
		tween(Card, { GroupTransparency = 1 }, 0.3)
		task.delay(0.3, function()
			if Card.Parent then Card:Destroy() end
		end)
	end)

	return Card
end

-- ============================================================
-- 	CREATE TAB — la tarjeta flotante con su lista
-- ============================================================
function UI:CreateTab(config)
	if typeof(config) == "string" then config = { Name = config } end
	config = config or {}
	local window = self
	local name = tostring(config.Text or config.Name or config.Title or ("Tab " .. (#self._tabs + 1)))

	local openW = self._cardW
	local titleW = textW(name, 12, Theme.FontTitle)
	local closedW = math.clamp(math.ceil(titleW) + 62, 70, openW)

	-- Posición automática: en fila, cada una con su espacio para las
	-- píldoras. Si no entra otra en la pantalla, baja a una fila nueva.
	local x, y = self._cursorX, self._cursorY
	local cam = workspace.CurrentCamera
	local vpX = cam and cam.ViewportSize.X or 1280
	if x > self._startX and x + openW + self._sideW > vpX - 6 then
		x = self._startX
		y = y + self._rowPitch
	end
	self._cursorX = x + self._pitch
	self._cursorY = y

	local shouldOpen = config.Open
	if shouldOpen == nil then shouldOpen = (#self._tabs == 0) end

	self._z = self._z + 1
	-- Root: punto de anclaje que se arrastra. Nada recorta a nada, así
	-- las píldoras pueden salirse por el costado de la tarjeta.
	local Root = new("Frame", {
		Name = "Tab_" .. name, Size = UDim2.new(0, 0, 0, 0), Position = config.Position or UDim2.new(0, x, 0, y),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = self._z, Parent = self.Container,
	})

	local Card = new("Frame", {
		Name = "Card", Size = UDim2.new(0, closedW, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.Alpha, BorderSizePixel = 0, Parent = Root,
	}, {
		corner(14), accentStroke(1.5),
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) }),
	})

	local Header = new("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Card })
	local Title = new("TextLabel", {
		Text = name, Font = Theme.FontTitle, TextSize = 12, TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -60, 1, 0), Parent = Header,
	})
	onAccent(function() if Title.Parent then Title.TextColor3 = Theme.Active end end)
	local Counter = new("TextLabel", {
		Text = "0 / 0", Font = Theme.FontMono, TextSize = 9, TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -9, 0, 0), Size = UDim2.new(0, 42, 1, 0), Parent = Header,
	})
	local HeaderBtn = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Header })

	local List = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		LayoutOrder = 2, Visible = false, Parent = Card,
	}, {
		pad(0, 2, 6, 8, 6),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Tab = setmetatable({
		Window = self, Root = Root, Card = Card, List = List, Name = name,
		_isOpen = false, _rowCount = 0, _opts = {},
	}, UI)

	Tab._recount = function()
		local active = 0
		for _, o in ipairs(Tab._opts) do if o.Active then active = active + 1 end end
		Counter.Text = string.format("%d / %d", active, #Tab._opts)
	end
	-- Trae esta tarjeta al frente (para que sus píldoras tapen a las vecinas).
	Tab._front = function()
		window._z = window._z + 1
		Root.ZIndex = window._z
	end

	local function setOpen(open)
		Tab._isOpen = open
		List.Visible = open
		tween(Card, { Size = UDim2.new(0, open and openW or closedW, 0, 0) }, 0.14)
		if open then Tab._front() end
	end
	Tab.Open = function() setOpen(true) end
	Tab.Close = function() setOpen(false) end
	Tab.SetOpen = function(_, open) setOpen(not not open) end

	-- Click en la cabecera abre/cierra; arrastrarla mueve la tarjeta.
	makeDraggable(self, HeaderBtn, Root, function() setOpen(not Tab._isOpen) end, Tab._front)

	table.insert(self._tabs, Tab)
	setOpen(shouldOpen)
	return Tab
end

-- ============================================================
-- 	OPCIÓN = fila en la lista + píldora lateral
-- ============================================================
-- Crea la fila (puntito, nombre, flechita) y la píldora vacía que se
-- despliega al costado. Cada control llena la píldora a su manera.
local function makeOption(tab, labelText, pillW)
	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = Theme.RowIdle, BorderSizePixel = 0,
		LayoutOrder = nextOrder(tab), Parent = tab.List,
	}, { corner(9) })

	local Dot = new("Frame", {
		Size = UDim2.new(0, 7, 0, 7), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
		BackgroundColor3 = Theme.Active, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Row,
	}, { circle() })
	local DotStroke = new("UIStroke", { Color = Theme.Active, Thickness = 1.2, Parent = Dot })
	onAccent(function() if Dot.Parent then Dot.BackgroundColor3 = Theme.Active DotStroke.Color = Theme.Active end end)

	new("TextLabel", {
		Text = tostring(labelText), Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 23, 0, 0), Size = UDim2.new(1, -50, 1, 0), Parent = Row,
	})

	local Chev = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -5, 0.5, 0),
		BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Parent = Row,
	}, { circle(), accentStroke(1) })
	local ChevText = new("TextLabel", {
		Text = "›", Font = Theme.FontBold, TextSize = 14, TextColor3 = Theme.Active, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, -1), Parent = Chev,
	})

	-- La píldora es hija de la fila pero se dibuja afuera de la tarjeta.
	local Pill = new("Frame", {
		Name = "Pill", Visible = false, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, 4, 0.5, 0),
		Size = UDim2.new(0, pillW, 0, PILL_H), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Parent = Row,
	}, { corner(PILL_H / 2), accentStroke(1.5) })
	local PillScale = new("UIScale", { Scale = 1, Parent = Pill })

	local Click = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local opt = { Row = Row, Pill = Pill, Open = false, Active = false }
	local hovering = false

	local function paintRow()
		local color = (opt.Open and Theme.LineOpen) or (hovering and Theme.Field) or Theme.RowIdle
		tween(Row, { BackgroundColor3 = color }, 0.12)
		if opt.Open then
			tween(Chev, { BackgroundColor3 = Theme.Active }, 0.12)
			ChevText.Text = "‹"
			ChevText.TextColor3 = Color3.new(1, 1, 1)
		else
			tween(Chev, { BackgroundColor3 = Theme.Background }, 0.12)
			ChevText.Text = "›"
			ChevText.TextColor3 = Theme.Active
		end
	end
	onAccent(function()
		if not Row.Parent then return end
		if opt.Open then Chev.BackgroundColor3 = Theme.Active else ChevText.TextColor3 = Theme.Active end
	end)

	function opt.SetActive(active)
		active = not not active
		opt.Active = active
		tween(Dot, { BackgroundTransparency = active and 0 or 1 }, 0.12)
		tab._recount()
	end
	function opt.Flash()
		Dot.BackgroundTransparency = 0
		tween(Dot, { BackgroundTransparency = opt.Active and 0 or 1 }, 0.4)
	end
	function opt.SetOpen(open)
		opt.Open = open
		Pill.Visible = open
		if open then
			PillScale.Scale = 0.7
			tween(PillScale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tab._front()
		end
		paintRow()
	end

	Click.MouseEnter:Connect(function() hovering = true paintRow() end)
	Click.MouseLeave:Connect(function() hovering = false paintRow() end)
	Click.MouseButton1Click:Connect(function() opt.SetOpen(not opt.Open) end)

	table.insert(tab._opts, opt)
	tab._recount()
	return opt
end

-- Botoncito redondo con flecha, para dentro de las píldoras (‹ ›).
local function stepButton(parent, text, x)
	local b = new("TextButton", {
		Text = text, Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Active, AutoButtonColor = false,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Size = UDim2.new(0, 15, 0, 15),
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x, 0.5, 0), Parent = parent,
	}, { circle(), accentStroke(1) })
	onAccent(function() if b.Parent then b.TextColor3 = Theme.Active end end)
	b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = Theme.LineOpen }, 0.1) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = Theme.Field }, 0.1) end)
	return b
end

