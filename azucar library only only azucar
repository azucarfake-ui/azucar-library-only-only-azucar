--[[
	AzucarUI  v1.1.0
	================
	Librería de interfaz ORIGINAL para Roblox (Luau), pensada para correr
	en un LocalScript normal (StarterPlayerScripts, StarterGui, o un
	Plugin de Studio). No usa ninguna API de executor (nada de gethui,
	protectgui, writefile, etc.) — solo servicios estándar de Roblox.

	DISEÑO (v1.1):
	--------------
	Cada pestaña del sidebar tiene una posición FIJA — nunca se mueve,
	sin importar qué otra pestaña esté abierta o cerrada. Al presionar
	una pestaña:
		1. Su línea se resalta con el color de acento.
		2. Se despliega un panel hacia ABAJO, como una capa flotante que
		   queda POR ENCIMA de las pestañas siguientes (no las empuja,
		   no las reordena, no cambia su posición para nada).
	Si hay muchas pestañas y algunas quedan fuera de la pantalla, el
	sidebar entero es un ScrollingFrame con scroll normal.

	Arriba hay una cabecera con el título y un RELOJ EN VIVO que muestra
	la hora local del dispositivo del jugador (se actualiza cada
	segundo con os.date). Esto SOLO funciona corriendo dentro de Roblox
	real (Studio o el juego) — un visor/previsualizador genérico de
	imágenes o HTML no puede ejecutar Luau.

	CAMBIOS INTERNOS relevantes v1.0 → v1.1:
	- Ventana, Pestaña y Controles ahora usan METATABLAS SEPARADAS
	  (antes compartían una sola, lo que hacía que llamar a un método
	  desde el objeto equivocado fallara silenciosamente y solo la
	  primera pestaña terminara funcionando bien).
	- El contenido desplegable de cada pestaña ya NO participa del
	  layout que ordena las líneas del sidebar: es un overlay aparte,
	  posicionado a mano justo debajo de su propia línea.

	USO BÁSICO:
	-----------
		local AzucarUI = require(path.to.AzucarUI)

		local Window = AzucarUI:CreateWindow({ Title = "Mi Hub" })

		local Combate = Window:CreateTab({ Text = "Combate" })

		Combate:CreateToggle({
			Text = "Activar cosa",
			Flag = "ActivarCosa",
			Default = false,
			Callback = function(state)
				print("Toggle:", state)
			end,
		})

		Combate:CreateSlider({
			Text = "Velocidad", Min = 0, Max = 100, Default = 16,
			Callback = function(value) print("Slider:", value) end,
		})

		Window:SetAccentColor("Azul") -- "Rojo" | "Azul" | "Verde" | "Blanco"
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local AzucarUI = {}
AzucarUI.Version    = "1.1.0"
AzucarUI.Windows    = {}
AzucarUI.Flags      = {}
AzucarUI.FlagValues = {}

-- Metatablas SEPARADAS: esto es lo que evita que un método de Ventana
-- se cuele en una Pestaña (o viceversa) y rompa todo silenciosamente.
local WindowMT = { __index = {} }
local TabMT    = { __index = {} }
local Win      = WindowMT.__index
local Tab      = TabMT.__index

-- ============================================================
-- 	TEMA
-- ============================================================
local Theme = {
	Sidebar   = Color3.fromRGB(18, 18, 22),
	Header    = Color3.fromRGB(22, 22, 27),
	Line      = Color3.fromRGB(27, 27, 33),
	LineHover = Color3.fromRGB(34, 34, 41),
	Content   = Color3.fromRGB(25, 25, 31),
	Row       = Color3.fromRGB(30, 30, 37),
	Border    = Color3.fromRGB(45, 45, 53),
	Text      = Color3.fromRGB(235, 235, 240),
	TextDim   = Color3.fromRGB(140, 140, 150),
	Active    = Color3.fromRGB(90, 130, 240),
	ActiveDim = Color3.fromRGB(58, 90, 176),
	Font      = Enum.Font.Gotham,
	FontBold  = Enum.Font.GothamBold,
}

local Palettes = {
	Rojo   = { Active = Color3.fromRGB(224, 68, 68),  ActiveDim = Color3.fromRGB(150, 40, 40) },
	Azul   = { Active = Color3.fromRGB(90, 130, 240), ActiveDim = Color3.fromRGB(58, 90, 176) },
	Verde  = { Active = Color3.fromRGB(66, 199, 120), ActiveDim = Color3.fromRGB(38, 132, 78) },
	Blanco = { Active = Color3.fromRGB(230, 230, 236), ActiveDim = Color3.fromRGB(160, 160, 168) },
}

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	fn()
	return fn
end
local function repaintAccent()
	for _, fn in ipairs(accentListeners) do
		pcall(fn)
	end
end

-- ============================================================
-- 	HELPERS
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time)
	return TweenService:Create(inst, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad), props)
end

-- Callbacks en hilos independientes: nunca se congelan entre sí ni
-- congelan la interfaz. Cada control (Toggle/Slider/Botón/Dropdown) es
-- una tabla PLANA con sus propios Set/Get/Stop asignados directamente
-- — no dependen de ninguna metatabla compartida, así que no pueden
-- chocar con los métodos de Ventana ni de Pestaña.
local function safeCall(controller, fn, ...)
	if typeof(fn) ~= "function" then return end
	local args = table.pack(...)
	controller._threads = controller._threads or {}
	return task.spawn(function()
		local th = coroutine.running()
		controller._threads[th] = true
		local ok, err = pcall(function() fn(table.unpack(args, 1, args.n)) end)
		if not ok then
			warn("[AzucarUI] Error en callback: " .. tostring(err))
		end
		controller._threads[th] = nil
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	AzucarUI.Flags[flagName] = controller
	AzucarUI.FlagValues[flagName] = initialValue
end

local function setFlagValue(flagName, value)
	if flagName == nil then return end
	AzucarUI.FlagValues[flagName] = value
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function AzucarUI:CreateWindow(config)
	config = config or {}

	local title     = config.Title or "Azucar UI"
	local SIDEBAR_W = config.SidebarWidth or 240
	local HEADER_H  = 40

	local player    = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarUI",
		ResetOnSpawn = false,
		-- Global (no Sibling): así el panel desplegable de una pestaña
		-- puede dibujarse POR ENCIMA de las pestañas que están debajo
		-- suyo aunque viva dentro de su propio Holder.
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
		Parent = playerGui,
	})

	local Shell = new("Frame", {
		Name = "Shell",
		Size = UDim2.new(0, SIDEBAR_W, 0, 480),
		Position = config.Position or UDim2.new(0, 20, 0, 60),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		Parent = ScreenGui,
	}, { corner(8), stroke(Theme.Border, 1) })

	-- ---------------- Cabecera: título + reloj ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = Shell,
	}, { corner(8) })

	new("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.new(0, 0, 1, -8),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Header,
	})

	local TitleLabel = new("TextLabel", {
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		Parent = Header,
	})

	local ClockLabel = new("TextLabel", {
		Name = "Clock",
		Text = os.date("%H:%M:%S"),
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.45, 0, 0, 0),
		Size = UDim2.new(0.55, -12, 1, 0),
		Parent = Header,
	})

	local AccentUnderline = new("Frame", {
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = Header,
	})
	onAccent(function() AccentUnderline.BackgroundColor3 = Theme.Active end)

	-- ---------------- Sidebar con scroll ----------------
	local Sidebar = new("ScrollingFrame", {
		Name = "Sidebar",
		Size = UDim2.new(1, 0, 1, -HEADER_H),
		Position = UDim2.new(0, 0, 0, HEADER_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = false, -- deja que el contenido desplegado se vea aunque "sobresalga"
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 1,
		Parent = Shell,
	}, {
		-- Este UIListLayout SOLO ordena los "Holder" (uno por pestaña),
		-- que tienen altura FIJA. El contenido desplegable vive adentro
		-- de cada Holder pero no cambia su tamaño, así que abrir una
		-- pestaña nunca reordena ni empuja a las demás.
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 8, 6, 8, 6),
	})

	local Window = setmetatable({
		ScreenGui    = ScreenGui,
		Shell        = Shell,
		Header       = Header,
		Sidebar      = Sidebar,
		_tabs        = {},
		_connections = {},
		_tabCount    = 0,
	}, WindowMT)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- Reloj en vivo (hora del dispositivo del jugador).
	task.spawn(function()
		while ClockLabel.Parent do
			ClockLabel.Text = os.date("%H:%M:%S")
			task.wait(1)
		end
	end)

	-- Arrastrar la ventana entera desde la cabecera.
	do
		local dragging, dragStart, startPos = false, nil, nil
		track(Header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Shell.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Shell.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
	end

	table.insert(AzucarUI.Windows, Window)
	return Window
end

function Win:SetAccentColor(paletteName)
	local palette = Palettes[paletteName]
	if not palette then
		warn("[AzucarUI] Paleta desconocida: " .. tostring(paletteName))
		return
	end
	Theme.Active = palette.Active
	Theme.ActiveDim = palette.ActiveDim
	repaintAccent()
end

function Win:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then
		pcall(function() self.ScreenGui:Destroy() end)
	end
	for i, w in ipairs(AzucarUI.Windows) do
		if w == self then
			table.remove(AzucarUI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	CREATE TAB — posición fija, despliega como capa flotante
-- ============================================================
local LINE_H = 36

function Win:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Pestaña " .. (self._tabCount + 1))
	self._tabCount += 1

	-- Holder: tamaño FIJO (nunca AutomaticSize). Es lo único que el
	-- UIListLayout del sidebar usa para ordenar — como su altura no
	-- cambia jamás, ninguna pestaña se mueve nunca, la abras o no.
	local Holder = new("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, LINE_H),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		LayoutOrder = self._tabCount,
		ZIndex = 1,
		Parent = self.Sidebar,
	})

	-- ---------------- La línea ----------------
	local Line = new("TextButton", {
		Name = "Line",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, LINE_H),
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = Holder,
	}, { corner(5) })

	local AccentMark = new("Frame", {
		Size = UDim2.new(0, 3, 0, 16),
		Position = UDim2.new(0, 8, 0.5, -8),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = Line,
	}, { corner(2) })
	onAccent(function() AccentMark.BackgroundColor3 = Theme.Active end)

	local NameLabel = new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 0),
		Size = UDim2.new(1, -34, 1, 0),
		ZIndex = 3,
		Parent = Line,
	})

	local Arrow = new("TextLabel", {
		Text = "+",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -22, 0, 0),
		Size = UDim2.new(0, 16, 1, 0),
		ZIndex = 3,
		Parent = Line,
	})

	-- ---------------- El panel desplegable (OVERLAY) ----------------
	-- Vive DENTRO del Holder pero anclado con posición absoluta justo
	-- debajo de la línea, con más ZIndex y ZIndexBehavior Global en el
	-- ScreenGui: por eso puede "sobresalir" del Holder (que mide solo
	-- LINE_H) y dibujarse por encima de las pestañas siguientes sin
	-- moverlas ni un píxel.
	local Content = new("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 0, 0, LINE_H + 2),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		BackgroundColor3 = Theme.Content,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 10,
		Parent = Holder,
	}, {
		corner(5),
		stroke(Theme.Border, 1),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 6, 6, 6, 6),
	})

	local TabObj = setmetatable({
		Window    = self,
		Holder    = Holder,
		Line      = Line,
		Content   = Content,
		Name      = name,
		Expanded  = false,
		_rowCount = 0,
	}, TabMT)

	local function setExpanded(expanded)
		TabObj.Expanded = expanded
		Content.Visible = expanded
		Arrow.Text = expanded and "-" or "+"
		Arrow.TextColor3 = expanded and Theme.Active or Theme.TextDim
		NameLabel.TextColor3 = expanded and Theme.Text or Theme.TextDim
		tween(Line, { BackgroundColor3 = expanded and Theme.LineHover or Theme.Line }, 0.12):Play()
		tween(AccentMark, { BackgroundTransparency = expanded and 0 or 1 }, 0.12):Play()
	end

	Line.MouseEnter:Connect(function()
		if not TabObj.Expanded then
			tween(Line, { BackgroundColor3 = Theme.LineHover }, 0.1):Play()
		end
	end)
	Line.MouseLeave:Connect(function()
		if not TabObj.Expanded then
			tween(Line, { BackgroundColor3 = Theme.Line }, 0.1):Play()
		end
	end)

	table.insert(self._connections, Line.MouseButton1Click:Connect(function()
		setExpanded(not TabObj.Expanded)
	end))

	table.insert(self._tabs, TabObj)
	return TabObj
end

-- Fila base compartida por todos los controles dentro de una pestaña.
local function baseRow(tabObj, height)
	tabObj._rowCount = tabObj._rowCount + 1
	return new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 30),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = tabObj._rowCount,
		ZIndex = 11,
		Parent = tabObj.Content,
	}, { corner(4), pad(0, 0, 8, 0, 8) })
end

-- ============================================================
-- 	LABEL
-- ============================================================
function Tab:CreateLabel(text)
	local Row = baseRow(self, 26)
	new("TextLabel", {
		Text = tostring(text),
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 12,
		Parent = Row,
	})
	return { Instance = Row }
end

-- ============================================================
-- 	BOTÓN
-- ============================================================
function Tab:CreateButton(config)
	config = config or {}
	local callback = config.Callback or function() end
	local Row = baseRow(self, 32)

	local Btn = new("TextButton", {
		Text = config.Text or "Botón",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 12,
		Parent = Row,
	})

	local Button = { Callback = callback, _threads = {} }

	Btn.MouseButton1Click:Connect(function()
		tween(Row, { BackgroundColor3 = Theme.ActiveDim }, 0.1):Play()
		task.delay(0.15, function()
			if Row.Parent then tween(Row, { BackgroundColor3 = Theme.Row }, 0.15):Play() end
		end)
		safeCall(Button, Button.Callback)
	end)

	function Button:Stop() stopAllThreads(self) end

	return Button
end

-- ============================================================
-- 	TOGGLE
-- ============================================================
function Tab:CreateToggle(config)
	config = config or {}
	local callback = config.Callback or function() end
	local state = not not (config.Default or false)

	local Row = baseRow(self, 30)

	new("TextLabel", {
		Text = config.Text or "Opción",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -34, 1, 0),
		ZIndex = 12,
		Parent = Row,
	})

	local Box = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(1, -16, 0.5, -8),
		BackgroundColor3 = state and Theme.Active or Theme.LineHover,
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = Row,
	}, { corner(4), stroke(Theme.Border, 1) })

	local Toggle = { Value = state, Callback = callback, _threads = {} }

	onAccent(function()
		if Toggle.Value then Box.BackgroundColor3 = Theme.Active end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		tween(Box, { BackgroundColor3 = newState and Theme.Active or Theme.LineHover }, 0.12):Play()
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end
	function Toggle:Get() return self.Value end
	function Toggle:Stop() stopAllThreads(self) end

	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 13, Parent = Row })
	Click.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end)

	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

-- ============================================================
-- 	SLIDER
-- ============================================================
function Tab:CreateSlider(config)
	config = config or {}
	local callback = config.Callback or function() end

	local min = config.Min or 0
	local max = config.Max or 100
	if max <= min then max = min + 1 end
	local step = config.Increment or 1
	if step <= 0 then step = 1 end

	local function snap(v)
		v = math.clamp(v, min, max)
		return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max)
	end

	local value = snap(config.Default or min)
	local Row = baseRow(self, 40)

	new("TextLabel", {
		Text = config.Text or "Valor",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 16),
		ZIndex = 12,
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = tostring(value),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.new(0, 50, 0, 16),
		ZIndex = 12,
		Parent = Row,
	})
	onAccent(function() ValueLabel.TextColor3 = Theme.Active end)

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0, 24),
		BackgroundColor3 = Theme.LineHover,
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = Row,
	}, { corner(2) })

	local function ratio(v) return (v - min) / (max - min) end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = Track,
	}, { corner(2) })
	onAccent(function() Fill.BackgroundColor3 = Theme.Active end)

	local Slider = { Value = value, Min = min, Max = max, Callback = callback, _threads = {} }

	local function repaint(v)
		Fill.Size = UDim2.new(ratio(v), 0, 1, 0)
		ValueLabel.Text = tostring(v)
	end

	function Slider:Set(newValue)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		setFlagValue(config.Flag, newValue)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end

	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + rel * (max - min))
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	registerFlag(config.Flag, Slider, value)
	return Slider
end

-- ============================================================
-- 	DROPDOWN
-- ============================================================
function Tab:CreateDropdown(config)
	config = config or {}
	local callback = config.Callback or function() end
	local options = config.Options or {}
	local selected = config.Default or options[1]

	local Row = baseRow(self, 30)
	Row.ClipsDescendants = false

	new("TextLabel", {
		Text = config.Text or "Opciones",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, 0, 0, 30),
		ZIndex = 12,
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = tostring(selected or "-"),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 0, 30),
		ZIndex = 12,
		Parent = Row,
	})
	onAccent(function() SelectedLabel.TextColor3 = Theme.Active end)

	local List = new("Frame", {
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, 0, 0, #options * 22),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 13,
		Parent = Row,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = { Value = selected, Options = options, Callback = callback, _threads = {} }

	local function buildOptions()
		for _, c in ipairs(List:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for i, opt in ipairs(Dropdown.Options) do
			local Btn = new("TextButton", {
				Text = tostring(opt),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				BackgroundColor3 = Theme.LineHover,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 20),
				LayoutOrder = i,
				ZIndex = 13,
				Parent = List,
			}, { corner(3), pad(0, 0, 6, 0, 6) })

			Btn.MouseButton1Click:Connect(function()
				Dropdown:Set(opt)
				List.Visible = false
				Row.Size = UDim2.new(1, 0, 0, 30)
			end)
		end
	end

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = tostring(option)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end

	buildOptions()

	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), ZIndex = 12, Parent = Row })
	Click.MouseButton1Click:Connect(function()
		List.Visible = not List.Visible
		Row.Size = UDim2.new(1, 0, 0, List.Visible and (30 + #Dropdown.Options * 22 + 4) or 30)
	end)

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

return AzucarUI
