local Theme = SquareUI.Theme

local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function stroke(color, thickness)
	return new("UIStroke", {
		Color = color or Theme.Border, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Miter,
	})
end

local function pad(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	})
end

local function label(props)
	local p = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Font = Theme.Font, TextSize = Theme.TextSize,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
	}
	for k, v in pairs(props) do p[k] = v end
	return new("TextLabel", p)
end

local function isClick(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function round(v, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(v * m + 0.5) / m
end

local function guiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	local ok2, core = pcall(function() return game:GetService("CoreGui") end)
	if ok2 and core then return core end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local Group = {}
Group.__index = Group

function Group:_row(height)
	return new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = #self._body:GetChildren(), Parent = self._body,
	})
end

function Group:_register(flag, obj)
	if flag then SquareUI.Flags[flag] = obj end
	return obj
end

function Group:AddLabel(text)
	local row = self:_row(16)
	local lbl = label({ Text = tostring(text), TextColor3 = Theme.TextDim, Size = UDim2.new(1, 0, 1, 0), Parent = row })
	local obj = {}
	function obj:Set(t) lbl.Text = tostring(t) end
	return obj
end

function Group:AddDivider()
	local row = self:_row(7)
	new("Frame", {
		BackgroundColor3 = Theme.Dim, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), Parent = row,
	})
end

function Group:AddToggle(name, opts)
	opts = opts or {}
	local row = self:_row(18)
	local box = new("Frame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12), Parent = row,
	}, { stroke(Theme.Border, 1) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 6, 0, 6), Visible = false, Parent = box,
	})
	label({ Text = tostring(name), Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -20, 1, 0), Parent = row })
	local btn = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row })

	local obj = { Value = false }
	function obj:Set(v, silent)
		v = v and true or false
		obj.Value = v
		fill.Visible = v
		if not silent and opts.Callback then task.spawn(opts.Callback, v) end
	end
	function obj:Get() return obj.Value end
	btn.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
	btn.MouseEnter:Connect(function() box.BackgroundColor3 = Theme.Dim end)
	btn.MouseLeave:Connect(function() box.BackgroundColor3 = Theme.Field end)
	if opts.Default then obj:Set(true) end
	return self:_register(opts.Flag, obj)
end

function Group:AddSlider(name, opts)
	opts = opts or {}
	local min, max = opts.Min or 0, opts.Max or 100
	local decimals = opts.Decimals or 0
	local suffix = opts.Suffix or ""
	local row = self:_row(34)
	label({ Text = tostring(name), Size = UDim2.new(1, 0, 0, 14), Parent = row })
	local bar = new("Frame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 17), Size = UDim2.new(1, 0, 0, 15),
		ClipsDescendants = true, Parent = row,
	}, { stroke(Theme.Border, 1) })
	local fill = new("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = bar })
	local txt = label({
		Text = "", TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 1, 0), ZIndex = 3,
		TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = 0.3, Parent = bar,
	})

	local obj = { Value = min }
	function obj:Set(v, silent)
		v = round(math.clamp(tonumber(v) or min, min, max), decimals)
		obj.Value = v
		local rel = (max == min) and 0 or (v - min) / (max - min)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		txt.Text = tostring(v) .. "/" .. tostring(max) .. suffix
		if not silent and opts.Callback then task.spawn(opts.Callback, v) end
	end
	function obj:Get() return obj.Value end

	local dragging = false
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * rel)
	end
	bar.InputBegan:Connect(function(i) if isClick(i) then dragging = true fromX(i.Position.X) end end)
	self._window:_connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end)
	self._window:_connect(UserInputService.InputEnded, function(i) if isClick(i) then dragging = false end end)

	obj:Set(opts.Default or min, true)
	return self:_register(opts.Flag, obj)
end

function Group:AddButton(name, callback)
	local row = self:_row(20)
	local btn = new("TextButton", {
		Text = tostring(name), Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, Size = UDim2.new(1, 0, 1, 0), Parent = row,
	}, { stroke(Theme.Border, 1) })
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Theme.Dim end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Theme.Field end)
	btn.MouseButton1Click:Connect(function() if callback then task.spawn(callback) end end)
	return btn
end

function Group:AddInput(name, opts)
	opts = opts or {}
	local row = self:_row(38)
	label({ Text = tostring(name), Size = UDim2.new(1, 0, 0, 14), Parent = row })
	local box = new("TextBox", {
		Text = tostring(opts.Default or ""), PlaceholderText = opts.Placeholder or "", PlaceholderColor3 = Theme.TextDim,
		Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.Text, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 17), Size = UDim2.new(1, 0, 0, 19), Parent = row,
	}, { stroke(Theme.Border, 1), pad(5, 0, 5, 0) })
	local obj = { Value = box.Text }
	function obj:Set(v, silent)
		box.Text = tostring(v)
		obj.Value = box.Text
		if not silent and opts.Callback then task.spawn(opts.Callback, obj.Value) end
	end
	function obj:Get() return obj.Value end
	box.FocusLost:Connect(function()
		obj.Value = box.Text
		if opts.Callback then task.spawn(opts.Callback, obj.Value) end
	end)
	return self:_register(opts.Flag, obj)
end

function Group:AddDropdown(name, opts)
	opts = opts or {}
	local options = opts.Options or {}
	local ROW_H, MAX_ROWS = 18, 6
	local holder = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = #self._body:GetChildren(), Parent = self._body,
	}, { new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) })
	label({ Text = tostring(name), Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1, Parent = holder })
	local head = new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 19), LayoutOrder = 2, Parent = holder,
	}, { stroke(Theme.Border, 1) })
	local cur = label({ Text = "", Position = UDim2.new(0, 5, 0, 0), Size = UDim2.new(1, -22, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
	local arrow = label({ Text = "v", TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0, 14, 1, 0), Parent = head })
	local list = new("ScrollingFrame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Visible = false, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0),
		ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = holder,
	}, { stroke(Theme.Dim, 1), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

	local obj = { Value = nil, Options = options }
	local buttons = {}
	local function paint()
		for opt, b in pairs(buttons) do b.TextColor3 = (opt == obj.Value) and Theme.Accent or Theme.TextDim end
	end
	function obj:Set(v, silent)
		obj.Value = v
		cur.Text = v ~= nil and tostring(v) or "-"
		paint()
		if not silent and opts.Callback then task.spawn(opts.Callback, v) end
	end
	function obj:Get() return obj.Value end
	local function close()
		list.Visible = false
		arrow.Text = "v"
	end
	function obj:SetOptions(newOptions)
		for _, b in pairs(buttons) do b:Destroy() end
		table.clear(buttons)
		obj.Options = newOptions
		for i, opt in ipairs(newOptions) do
			local b = new("TextButton", {
				Text = " " .. tostring(opt), Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, BorderSizePixel = 0,
				AutoButtonColor = false, Size = UDim2.new(1, 0, 0, ROW_H), LayoutOrder = i, Parent = list,
			})
			b.MouseButton1Click:Connect(function() obj:Set(opt) close() end)
			buttons[opt] = b
		end
		list.Size = UDim2.new(1, 0, 0, math.min(#newOptions, MAX_ROWS) * ROW_H + 2)
		paint()
	end
	head.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
		arrow.Text = list.Visible and "^" or "v"
	end)
	obj:SetOptions(options)
	obj:Set(opts.Default ~= nil and opts.Default or options[1], true)
	return self:_register(opts.Flag, obj)
end

local Tab = {}
Tab.__index = Tab

function Tab:CreateGroupbox(title, side)
	local column = (side == "Right") and self._right or self._left
	local frame = new("Frame", {
		BackgroundColor3 = Theme.Group, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = #column:GetChildren(), Parent = column,
	}, { stroke(Theme.Border, 1) })
	label({
		Text = " " .. tostring(title) .. " ", TextColor3 = Theme.Accent, BackgroundTransparency = 0, BackgroundColor3 = Theme.Back,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 14), Position = UDim2.new(0, 8, 0, -8), ZIndex = 5, Parent = frame,
	})
	local body = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = frame,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), pad(8, 12, 8, 8) })
	return setmetatable({ _body = body, _window = self._window }, Group)
end

local Window = {}
Window.__index = Window

function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:_layoutTabs()
	local n = #self._tabs
	for i, t in ipairs(self._tabs) do
		t._btn.Size = UDim2.new(1 / n, i == n and 0 or -1, 1, 0)
		t._btn.Position = UDim2.new((i - 1) / n, 0, 0, 0)
	end
end

function Window:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = (t == tab)
		t._page.Visible = on
		t._on = on
		t._btn.BackgroundColor3 = on and Theme.Accent or Theme.Field
		t._btn.TextColor3 = on and Theme.OnAccent or Theme.Text
	end
end

function Window:CreateTab(name)
	local page = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Size = UDim2.new(1, 0, 1, 0), Parent = self._content,
	})
	local function column(x)
		return new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(x, x == 0 and 0 or 3, 0, 0),
			Size = UDim2.new(0.5, -3, 1, 0), ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
		}, { new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }), pad(0, 8, 2, 4) })
	end
	local btn = new("TextButton", {
		Text = string.lower(tostring(name)), Font = Theme.Font, TextSize = Theme.TextSize, TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, Parent = self._tabbar,
	}, { stroke(Theme.Border, 1) })
	local tab = setmetatable({ _page = page, _btn = btn, _left = column(0), _right = column(0.5), _window = self }, Tab)
	table.insert(self._tabs, tab)
	btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
	btn.MouseEnter:Connect(function() if not tab._on then btn.BackgroundColor3 = Theme.Dim end end)
	btn.MouseLeave:Connect(function() if not tab._on then btn.BackgroundColor3 = Theme.Field end end)
	self:_layoutTabs()
	if #self._tabs == 1 then self:SelectTab(tab) end
	return tab
end

function Window:SetVisible(v)
	self._visible = v
	self._main.Visible = v
end

function Window:Toggle() self:SetVisible(not self._visible) end

function Window:Notify(text, duration)
	local n = new("Frame", {
		BackgroundColor3 = Theme.Title, BorderSizePixel = 0, Size = UDim2.new(0, 220, 0, 24), LayoutOrder = os.clock() * 1000,
		Parent = self._notes,
	}, { stroke(Theme.Border, 1) })
	label({ Text = tostring(text), Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -12, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = n })
	task.delay(duration or 3, function() if n.Parent then n:Destroy() end end)
end

function Window:Destroy()
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self._gui then self._gui:Destroy() end
	for i, w in ipairs(SquareUI.Windows) do if w == self then table.remove(SquareUI.Windows, i) break end end
end

function SquareUI:CreateWindow(config)
	config = config or {}
	local preset = SquareUI.Themes[config.Theme or "Troll"]
	if preset then for k, v in pairs(preset) do Theme[k] = v end end
	if config.Accent then Theme.Accent = config.Accent end
	local size = config.Size or Vector2.new(440, 340)
	local self = setmetatable({ _tabs = {}, _conns = {}, _visible = true }, Window)

	local gui = new("ScreenGui", { Name = "SquareUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
	gui.Parent = guiParent()
	self._gui = gui

	local main = new("Frame", {
		Name = "Main", BackgroundColor3 = Theme.Back, BorderSizePixel = 0, Size = UDim2.new(0, size.X, 0, size.Y),
		Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2), Parent = gui,
	}, { stroke(Theme.Border, 1) })
	self._main = main

	local titlebar = new("Frame", { BackgroundColor3 = Theme.Title, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 22), Parent = main })
	new("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.new(0, 8, 0, 8), Parent = titlebar })
	label({ Text = tostring(config.Title or "Square UI"), Position = UDim2.new(0, 22, 0, 0), Size = UDim2.new(1, -90, 1, 0), Parent = titlebar })
	label({ Text = "v" .. SquareUI.Version, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -58, 0, 0), Size = UDim2.new(0, 50, 1, 0), Parent = titlebar })
	new("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), Parent = titlebar })

	local dragging, dragStart, startPos = false, nil, nil
	titlebar.InputBegan:Connect(function(i)
		if isClick(i) then dragging, dragStart, startPos = true, i.Position, main.Position end
	end)
	self:_connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	self:_connect(UserInputService.InputEnded, function(i) if isClick(i) then dragging = false end end)

	new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 3, 0, 52), Size = UDim2.new(1, -6, 1, -72), Parent = main,
	}, { stroke(Theme.Dim, 1) })
	self._tabbar = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 28), Size = UDim2.new(1, -12, 0, 20), Parent = main,
	})
	self._content = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 8, 0, 58), Size = UDim2.new(1, -16, 1, -84), Parent = main,
	})
	self._notes = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10),
		Size = UDim2.new(0, 220, 0, 200), Parent = gui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	local footer = new("Frame", { BackgroundColor3 = Theme.Title, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 18), Parent = main })
	new("Frame", { BackgroundColor3 = Theme.Dim, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Parent = footer })
	label({ Text = "[" .. toggleKey.Name .. "] mostrar / ocultar", TextColor3 = Theme.TextDim, TextSize = 11, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0.6, 0, 1, 0), Parent = footer })
	label({ Text = tostring(config.Theme or "Troll"), TextColor3 = Theme.Accent, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -8, 1, 0), Parent = footer })
	self:_connect(UserInputService.InputBegan, function(i, processed)
		if not processed and i.KeyCode == toggleKey then self:Toggle() end
	end)

	table.insert(SquareUI.Windows, self)
	return self
end

return SquareUI
end)()

