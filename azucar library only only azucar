UI.Moods = Moods
UI.CurrentMood = "Calma"

local Theme = {}
for key, value in pairs(Moods.Calma) do Theme[key] = value end
Theme.Font     = Enum.Font.Gotham
Theme.FontBold = Enum.Font.GothamBold
UI.Theme = Theme

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

-- Cambia de ánimo: repinta el acento/bordes ya enganchados (onAccent) y
-- cambia la velocidad del pulso/temblor/chispas para las ventanas
-- abiertas. Los fondos ya dibujados (Background/Header/Line/Field) no
-- se repintan solos, como con los Theme de la otra librería.
function UI:SetMood(moodName)
	local preset = Moods[moodName]
	if not preset then
		warn("[AzucarMood] Ánimo desconocido: " .. tostring(moodName) .. ". Elegí Ira o Calma.")
		return
	end
	UI.CurrentMood = moodName
	for key, value in pairs(preset) do
		Theme[key] = value
	end
	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end
function UI:Fail() UI:SetMood("Ira") end
function UI:Win() UI:SetMood("Calma") end

-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarMood] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

-- ============================================================
-- 	LIMPIEZA DE EJECUCIONES ANTERIORES
-- ============================================================
local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))

local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__AzucarMoodWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end

	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then
		table.insert(places, plr.PlayerGui)
	end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		pcall(function() table.insert(places, getHui()) end)
	end
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and child.Name == "AzucarMood"
					and child:GetAttribute("AzucarMoodLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end

local function hoverField(obj, base)
	base = base or Theme.Field
	local mark = new("Frame", {
		Name = "HoverMark",
		Size = UDim2.new(0, 3, 0.35, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = obj,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	onAccent(function()
		if mark.Parent then mark.BackgroundColor3 = Theme.Active end
	end)

	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.LineOpen })
		tween(mark, { BackgroundTransparency = 0, Size = UDim2.new(0, 3, 0.7, 0) }, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = base })
		tween(mark, { BackgroundTransparency = 1, Size = UDim2.new(0, 3, 0.35, 0) }, 0.15)
	end)
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES (SIN LÍMITE)
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)
	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarMood] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else
				warn("[AzucarMood] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do
			UI:SaveConfig(name)
		end
	end
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		warn("[AzucarMood] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	CREATE WINDOW — un solo rectángulo chico, riel + contenido adentro
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title = config.Title or config.Name or "Azúcar Hub"
	if config.Mood ~= nil then
		UI:SetMood(config.Mood)
	end

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarMood",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("AzucarMoodLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	local ShellStroke = stroke(Theme.Border, 2)
	local Shell = new("Frame", {
		Name = "Shell",
		Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H),
		Position = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(14), ShellStroke })
	onAccent(function() ShellStroke.Color = Theme.Border end)

	local Header = new("Frame", {
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Shell,
	}, { corner(14) })
	new("Frame", {
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = Header,
	})

	local TitleLabel = new("TextLabel", {
		Text = title,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Parent = Header,
	})
	onAccent(function() TitleLabel.TextColor3 = Theme.Text end)

	-- ---------------- Riel angosto de íconos (las pestañas) ----------------
	local Rail = new("Frame", {
		Name = "Rail",
		Position = UDim2.new(0, 0, 0, HEADER_H),
		Size = UDim2.new(0, RAIL_W, 1, -HEADER_H),
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		Parent = Shell,
	})
	onAccent(function() Rail.BackgroundColor3 = Theme.Line end)

	local RailList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Rail,
	})
	new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = RailList })
	pad(0, 8, 0, 8, 0).Parent = RailList

	-- ---------------- Área de contenido (dentro del MISMO rectángulo) ----------------
	local ContentArea = new("Frame", {
		Name = "Content",
		Position = UDim2.new(0, RAIL_W, 0, HEADER_H),
		Size = UDim2.new(1, -RAIL_W, 1, -HEADER_H),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = Shell,
	})
	onAccent(function() ContentArea.BackgroundColor3 = Theme.Background end)

	local EmptyHint = new("TextLabel", {
		Text = "Sin pestañas.\nUsá Window:CreateTab({ Name = \"...\" }).",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 12),
		Size = UDim2.new(1, -24, 1, -24),
		Parent = ContentArea,
	})

	-- ---------------- Chispas/brasas (pocas, chicas, atadas al ánimo) ----------------
	local SparkHolder = new("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = Shell,
	})
	local sparks = {}
	local function buildSpark(i)
		local outer = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = Theme.Active,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = SparkHolder,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local core = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.35, 0.35),
			BackgroundColor3 = Theme.Active,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = outer,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		return { outer = outer, core = core, born = nil, life = 1, x = 0, y = 0, vy = 0 }
	end
	for i = 1, 14 do
		table.insert(sparks, buildSpark(i))
	end
	onAccent(function()
		for _, sp in ipairs(sparks) do
			if sp.outer.Parent then
				sp.outer.BackgroundColor3 = Theme.Active
				sp.core.BackgroundColor3 = Theme.Active
			end
		end
	end)
	local function respawnSpark(sp, now)
		sp.x = math.random(0, WINDOW_W)
		sp.y = WINDOW_H + 4
		sp.vy = -(18 + math.random() * 24) * (Theme.SparkSpeed or 1)
		sp.life = (WINDOW_H / math.max(-sp.vy, 1)) * (1 + math.random() * 0.3)
		sp.born = now
	end

	local Window = setmetatable({
		ScreenGui = ScreenGui, Root = Root, Shell = Shell, Header = Header,
		TitleLabel = TitleLabel, Rail = Rail, RailList = RailList,
		ContentArea = ContentArea, EmptyHint = EmptyHint,
		_tabs = {}, _connections = {}, _visible = true,
		_loadId = LOAD_ID,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do
			table.insert(autoSaveIgnore, word)
		end
	end
	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		Window._configName = autoName
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end
	Window._loadStagger = config.AutoLoadStagger or 0
	Window._loadOrder = config.AutoLoadOrder

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	-- Arrastrar la ventana desde el Header.
	do
		local dragging, dragStart, startPos = false, nil, nil
		track(Header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Shell.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Window._basePos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
				if not Theme.Shake then
					Shell.Position = Window._basePos
				end
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
	end
	Window._basePos = Shell.Position

	-- Pulso del borde (rápido en Ira, lento en Calma) + temblor + chispas/brasas.
	track(RunService.Heartbeat:Connect(function()
		if not Window._visible then return end
		local now = os.clock()
		local cycle = Theme.PulseCycle or 2
		local pulse = 0.5 + 0.5 * math.sin((now / cycle) * (2 * math.pi))
		ShellStroke.Transparency = 0.15 + 0.45 * (1 - pulse)

		if Theme.Shake then
			local jx = (math.random() - 0.5) * 2 * (Theme.ShakeAmp or 0)
			local jy = (math.random() - 0.5) * 2 * (Theme.ShakeAmp or 0)
			Shell.Position = UDim2.new(Window._basePos.X.Scale, Window._basePos.X.Offset + jx, Window._basePos.Y.Scale, Window._basePos.Y.Offset + jy)
		else
			Shell.Position = Window._basePos
		end

		local count = math.min(Theme.SparkCount or 0, #sparks)
		for i, sp in ipairs(sparks) do
			if i <= count then
				if sp.born == nil or now - sp.born >= sp.life then
					respawnSpark(sp, now)
				end
				local age = now - sp.born
				local t = math.clamp(age / sp.life, 0, 1)
				sp.outer.Position = UDim2.fromOffset(sp.x, sp.y + sp.vy * age)
				local vis = math.sin(t * math.pi)
				sp.outer.BackgroundTransparency = 1 - 0.18 * vis
				sp.core.BackgroundTransparency = 1 - vis
			else
				sp.outer.BackgroundTransparency = 1
				sp.core.BackgroundTransparency = 1
			end
		end
	end))

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__AzucarMoodWindows")
	if typeof(registry) ~= "table" then
		registry = {}
		rawset(_G, "__AzucarMoodWindows", registry)
	end
	table.insert(registry, Window)

	return Window
end

function UI:Show() self.Root.Visible = true self._visible = true end
function UI:Hide() self.Root.Visible = false self._visible = false end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
function UI:SetTitle(text) if self.TitleLabel then self.TitleLabel.Text = tostring(text) end end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do
		if w == self then table.remove(UI.Windows, i) break end
	end
end

-- ============================================================
-- 	CREATE TAB — ícono en el riel + su propia columna adentro del rectángulo
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))
	local isFirst = #self._tabs == 0

	if self.EmptyHint then self.EmptyHint:Destroy() self.EmptyHint = nil end

	local icon = config.Icon or string.upper(string.sub(name, 1, 1))
	local IconBtn = new("TextButton", {
		Name = name,
		Text = icon,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = isFirst and Theme.Active or Theme.TextDim,
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.LineOpen or Theme.Line,
		Size = UDim2.new(0, 36, 0, 36),
		LayoutOrder = #self._tabs + 1,
		Parent = self.RailList,
	}, { corner(10) })

	local Panel = new("ScrollingFrame", {
		Name = name .. "Panel",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = isFirst,
		Parent = self.ContentArea,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 10, 10, 10, 10),
	})

	local Tab = setmetatable({
		Window = self, Button = IconBtn, Panel = Panel, List = Panel,
		Name = name, _rowCount = 0, _isOpen = isFirst,
	}, UI)

	onAccent(function()
		if Tab._isOpen then
			IconBtn.TextColor3 = Theme.Active
			IconBtn.BackgroundColor3 = Theme.LineOpen
		end
	end)

	table.insert(self._connections, IconBtn.MouseButton1Click:Connect(function()
		self:SelectTab(name)
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

function UI:SelectTab(name)
	for _, tab in ipairs(self._tabs or {}) do
		local selected = (tab.Name == name)
		tab._isOpen = selected
		tab.Panel.Visible = selected
		tab.Button.BackgroundColor3 = selected and Theme.LineOpen or Theme.Line
		tab.Button.TextColor3 = selected and Theme.Active or Theme.TextDim
	end
end
