-- ============================================================
-- 	CONFIGURACIONES (guardar / cargar / listar)
-- ============================================================
-- Esto es lo que distingue a un panel "de prueba" de uno real: poder
-- guardar los ajustes en disco y recuperarlos la próxima vez que
-- entrás, sin tener que tocar Toggle por Toggle otra vez.
--
-- Usa las funciones que da el ejecutor (writefile/readfile/isfile/
-- isfolder/makefolder/listfiles) — si tu ejecutor no las tiene, avisa
-- por consola y devuelve false, no rompe nada del resto del script.
UI.ConfigFolder = "AzucarHackerUI"

local function ensureConfigFolder()
	if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(UI.ConfigFolder) then
			pcall(makefolder, UI.ConfigFolder)
		end
	end
end

-- Solo guarda tipos "simples": booleanos, números y strings tal cual, y
-- los KeyCode como su nombre (ej. "F"), para poder reconstruirlos al
-- cargar. Cualquier otra cosa rara que alguien haya metido en una Flag
-- (un jugador, una tabla propia) se ignora en vez de romper el guardado
-- de todo lo demás.
function UI:SaveConfig(name)
	name = name or "default"

	if typeof(writefile) ~= "function" then
		warn("[AzucarHackerUI] Tu ejecutor no tiene writefile — no se puede guardar la config.")
		return false
	end

	ensureConfigFolder()

	local data = {}
	for flag, value in pairs(UI.FlagValues) do
		local t = typeof(value)
		if t == "boolean" or t == "number" or t == "string" then
			data[flag] = value
		elseif t == "EnumItem" and value.Name then
			data[flag] = { __keycode = value.Name }
		end
	end

	local okJson, encoded = pcall(function()
		return game:GetService("HttpService"):JSONEncode(data)
	end)
	if not okJson then
		warn("[AzucarHackerUI] No se pudo convertir la config a JSON.")
		return false
	end

	local okWrite, err = pcall(writefile, UI.ConfigFolder .. "/" .. name .. ".json", encoded)
	if not okWrite then
		warn("[AzucarHackerUI] No se pudo guardar la config: " .. tostring(err))
		return false
	end
	return true
end

-- Recorre la config guardada y llama a controller:Set(valor) por cada
-- Flag que coincida con un control que exista AHORA MISMO en la UI —
-- así no importa si guardaste con una versión del hub que tenía más o
-- menos controles que la que tenés cargada hoy.
function UI:LoadConfig(name)
	name = name or "default"

	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		warn("[AzucarHackerUI] Tu ejecutor no tiene readfile/isfile — no se puede cargar la config.")
		return false
	end

	local path = UI.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then
		warn("[AzucarHackerUI] No existe ninguna config guardada como '" .. name .. "'.")
		return false
	end

	local okRead, raw = pcall(readfile, path)
	if not okRead then
		warn("[AzucarHackerUI] No se pudo leer el archivo de config.")
		return false
	end

	local okJson, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(raw)
	end)
	if not okJson or typeof(data) ~= "table" then
		warn("[AzucarHackerUI] La config guardada está corrupta o vacía.")
		return false
	end

	for flag, value in pairs(data) do
		local controller = UI.Flags[flag]
		if controller and typeof(controller.Set) == "function" then
			if typeof(value) == "table" and value.__keycode then
				local okKey, keyCode = pcall(function()
					return Enum.KeyCode[value.__keycode]
				end)
				if okKey and keyCode then
					controller:Set(keyCode)
				end
			else
				pcall(function() controller:Set(value) end)
			end
		end
	end
	return true
end

-- Nombres de configs guardadas (sin ".json"), para armar por ejemplo un
-- Dropdown de "qué config cargar" en tu propio hub.
function UI:ListConfigs()
	if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" then
		return {}
	end
	if not isfolder(UI.ConfigFolder) then
		return {}
	end

	local names = {}
	local okList, files = pcall(listfiles, UI.ConfigFolder)
	if not okList then
		return names
	end

	for _, path in ipairs(files) do
		local name = path:match("([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	return names
end

return UI
