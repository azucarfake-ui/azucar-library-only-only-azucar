	if state == nil then state = false end
	state = not not state

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	})
	hoverField(Row, Theme.Field)

	new("TextLabel", {
		Text = config.Text or config.Name or "Opción",
		Font = Theme.Font,
		TextSize = 12 + FONT_BOOST,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(1, -44, 1, 0),
		Parent = Row,
	})

	local Box = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(1, -24, 0.5, -7),
		BackgroundColor3 = state and Theme.Active or Theme.Border,
		BorderSizePixel = 0,
		Parent = Row,
	}, { corner(3) })

	-- Efectos: pequeño "salto" al cambiar y un brillo rojo suave cuando está prendido.
	local BoxPop = new("UIScale", { Scale = 1, Parent = Box })
	local BoxGlow = new("UIStroke", {
		Color = Theme.Active,
		Thickness = 3,
		Transparency = state and 0.55 or 1,
		Parent = Box,
	})

	local Toggle = setmetatable({ Box = Box, Value = state, Callback = callback, _threads = {} }, UI)

	onAccent(function()
		if Box.Parent then
			Box.BackgroundColor3 = Toggle.Value and Theme.Active or Theme.Border
			BoxGlow.Color = Theme.Active
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		tween(Box, { BackgroundColor3 = newState and Theme.Active or Theme.Border })
		tween(BoxGlow, { Transparency = newState and 0.55 or 1 }, 0.2)
		BoxPop.Scale = 1.45
		tween(BoxPop, { Scale = 1 }, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end

	function Toggle:Get() return self.Value end
	function Toggle:Stop() stopAllThreads(self) end

	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })
	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end))

	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

