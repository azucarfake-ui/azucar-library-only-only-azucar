function UI:CreateGroup(config)
	config = config or {}
	local name = config.Text or config.Name or "Grupo"
	local list, window, owner = host(self)
	if not list then
		warn("[AzucarHackerUI] CreateGroup necesita una pestaña. Creá primero un CreateTab.")
		return setmetatable({}, Stub)
	end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 0, 10, 0, 10) })
	hoverRow(Row)

	rowLabel(Row, name, 20)

	local Arrow = new("TextLabel", {
		Text = ">",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 16, 1, 0),
		Position = UDim2.new(1, -16, 0, 0),
		Parent = Row,
	})

	local GroupPanel = new("Frame", {
		Name = name .. "GroupPanel",
		Size = UDim2.new(0, window.PANEL_W, 1, -(window.TOP_Y + window.HEADER_H + window.BOTTOM_MARGIN)),
		Position = UDim2.new(0, window.RAIL_W + window.PANEL_W, 0, window.HEADER_H),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		Parent = window.Shell,
	}, { corner(6), stroke(Theme.Border, 1) })

	local GroupTitle = new("TextLabel", {
		Text = string.upper(name),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = GroupPanel,
	}, { pad(0, 0, 10, 0, 10) })
	onAccent(function()
		if GroupTitle.Parent then
			GroupTitle.TextColor3 = Theme.Active
		end
	end)

	local GroupList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -26),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = GroupPanel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 4, 0, 8, 0),
	})

	local siblings = owner._groupPanels or self._groupPanels
	if siblings then
		siblings[name] = { Instance = GroupPanel, Arrow = Arrow }
	end

	local Click = clickLayer(Row)
	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		if siblings then
			for _, gp in pairs(siblings) do
				if gp.Instance ~= GroupPanel then
					gp.Instance.Visible = false
					gp.Arrow.Text = ">"
				end
			end
		end
		GroupPanel.Visible = not GroupPanel.Visible
		Arrow.Text = GroupPanel.Visible and "<" or ">"
		Arrow.TextColor3 = GroupPanel.Visible and Theme.Active or Theme.TextDim
	end))

	return setmetatable({
		Window       = window,
		Panel        = GroupPanel,
		List         = GroupList,
		Name         = name,
		_rowCount    = 0,
		_groupPanels = {},
	}, UI)
end

