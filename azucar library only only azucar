function Group:AddToggle(name, opts)
	opts = opts or {}
	local window = self._window
	local holder = self:_holder()
	local row = self:_row(18, holder, 1)
	local box = new("Frame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12), Parent = row,
	}, { stroke(Theme.Border, 1) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 6, 0, 6), Visible = false, Parent = box,
	})
	label({ Text = tostring(name), Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -20, 1, 0), Parent = row })
	local btn = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, -60, 1, 0), Parent = row })

	local obj = { Value = false, Name = name, Key = nil, Color = nil }
	local rightX = 0
	function obj:Set(v, silent)
		v = v and true or false
		obj.Value = v
		fill.Visible = v
		window:_listRefresh()
		window:_changed()
		if not silent and opts.Callback then task.spawn(opts.Callback, v) end
	end
	function obj:Get() return obj.Value end
	btn.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
	btn.MouseEnter:Connect(function() box.BackgroundColor3 = Theme.Dim end)
	btn.MouseLeave:Connect(function() box.BackgroundColor3 = Theme.Field end)

	function obj:AddKeybind(kopts)
		kopts = kopts or {}
		local key = kopts.Default
		local listening = false
		local kb = new("TextButton", {
			Text = key and key.Name or "-", Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextDim,
			BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -rightX, 0.5, 0), Size = UDim2.new(0, 34, 0, 14), Parent = row,
		}, { stroke(Theme.Dim, 1) })
		rightX = rightX + 38
		local function show() kb.Text = listening and "..." or (key and key.Name or "-") kb.TextColor3 = listening and Theme.Accent or Theme.TextDim end
		kb.MouseButton1Click:Connect(function() listening = true show() end)
		window:_connect(UserInputService.InputBegan, function(i, processed)
			if listening then
				if i.UserInputType == Enum.UserInputType.Keyboard then
					key = (i.KeyCode ~= Enum.KeyCode.Escape) and i.KeyCode or nil
					obj.Key = key
					listening = false
					show()
					window:_changed()
				end
				return
			end
			if not processed and key and i.KeyCode == key then obj:Set(not obj.Value) end
		end)
		obj.Key = key
		function obj:SetKey(k) key = k obj.Key = k show() window:_changed() end
		return obj
	end

	function obj:AddColorpicker(copts)
		copts = copts or {}
		local pick
		local sw = new("TextButton", {
			Text = "", BackgroundColor3 = copts.Default or Color3.new(1, 1, 1), BorderSizePixel = 0, AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -rightX, 0.5, 0), Size = UDim2.new(0, 18, 0, 12), Parent = row,
		}, { stroke(Theme.Border, 1) })
		rightX = rightX + 22
		pick = makePicker(window, holder, copts.Default, 2, function(c)
			sw.BackgroundColor3 = c
			obj.Color = c
			window:_changed()
			if copts.Callback then task.spawn(copts.Callback, c) end
		end)
		obj.Color = pick.Color
		sw.MouseButton1Click:Connect(function() pick.panel.Visible = not pick.panel.Visible end)
		function obj:SetColor(c, silent)
			pick.set(c, silent)
			sw.BackgroundColor3 = c
			obj.Color = c
			window:_changed()
		end
		return obj
	end

	function obj:_save()
		return { v = obj.Value, k = obj.Key and obj.Key.Name or nil, c = obj.Color and colorToTable(obj.Color) or nil }
	end
	function obj:_load(d)
		if type(d) ~= "table" then obj:Set(d and true or false) return end
		if d.c and obj.SetColor then obj:SetColor(tableToColor(d.c)) end
		if d.k and obj.SetKey and Enum.KeyCode[d.k] then obj:SetKey(Enum.KeyCode[d.k]) end
		obj:Set(d.v and true or false)
	end

	if not opts.NoList then window:_listAdd(obj) end
	if opts.Default then obj:Set(true, true) end
	return self:_register(opts.Flag, obj)
end

function Group:AddColorpicker(name, opts)
	opts = opts or {}
	local window = self._window
	local holder = self:_holder()
	local row = self:_row(18, holder, 1)
	label({ Text = tostring(name), Size = UDim2.new(1, -30, 1, 0), Parent = row })
	local sw = new("TextButton", {
