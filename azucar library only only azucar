function UI:CreateStat(config)
	config = config or {}
	local list, _, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 5, 10, 5, 10) })

	local ValueLabel = new("TextLabel", {
		Text = tostring(config.Value or "0"),
		Font = Theme.FontBold,
		TextSize = 20,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 21),
		Parent = holder,
	})
	onAccent(function()
		if ValueLabel.Parent then
			ValueLabel.TextColor3 = Theme.Active
		end
	end)

	new("TextLabel", {
		Text = config.Label or config.Text or config.Name or "",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 21),
		Size = UDim2.new(1, 0, 0, 13),
		Parent = holder,
	})

	local Stat = setmetatable({ Instance = ValueLabel, Value = config.Value or "0" }, UI)

	function Stat:Set(newValue)
		self.Value = newValue
		ValueLabel.Text = tostring(newValue)
	end

	registerFlag(config.Flag, Stat, config.Value)
	return Stat
end

