-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end

local function hoverField(obj, base)
	base = base or Theme.Field
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.FieldHover })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = base })
	end)
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES (igual que AzucarLegit)
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end

	local args = table.pack(...)
	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then controller._threads[thisThread] = true end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[NovaUI] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then return config.Callback end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else
				warn("[NovaUI] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

local loadingConfig = false
local autoSaveTargets = {}
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

local function setFlagValue(flagName, value, skipSave)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
	if not skipSave and not loadingConfig and next(autoSaveTargets) ~= nil then
		for name in pairs(autoSaveTargets) do
			UI:SaveConfig(name)
		end
	end
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		warn("[NovaUI] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title    = config.Title or config.Name or "Nova Hub"
	local WIDTH    = config.Width or 560
	local HEADER_H = 40
	local TABBAR_H = 40
	local CONTENT_H = config.ContentHeight or 340
	local TOP_Y  = config.TopOffset or 14
	local LEFT_X = config.LeftOffset or 14
	local RADIUS = 10

	local ScreenGui = new("ScreenGui", {
		Name = "NovaUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end

	local guiParent = getGuiParent()
	cleanupOldWindows(guiParent)
	ScreenGui:SetAttribute("NovaLoadId", LOAD_ID)
	ScreenGui.Parent = guiParent

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	local Shell = new("Frame", {
		Name = "Shell",
		Size = UDim2.new(0, WIDTH, 0, HEADER_H + TABBAR_H + CONTENT_H),
		Position = UDim2.new(0, LEFT_X, 0, TOP_Y),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(RADIUS), stroke(Theme.Border, 1) })

	-- Brillo del borde: respira despacio, look "holograma encendido".
	onAccent(function() end) -- placeholder para mantener la lista viva si hace falta

	-- ---------------- Barra superior: título + hora ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Bar,
		BorderSizePixel = 0,
		Parent = Shell,
	}, { corner(RADIUS) })
	-- Tapa las esquinas de abajo del header para que no sobresalgan del Shell.
	new("Frame", {
		Position = UDim2.new(0, 0, 1, -RADIUS),
		Size = UDim2.new(1, 0, 0, RADIUS),
		BackgroundColor3 = Theme.Bar,
		BorderSizePixel = 0,
		Parent = Header,
	})

	local Dot = new("Frame", {
		Size = UDim2.new(0, 8, 0, 8),
		Position = UDim2.new(0, 14, 0.5, -4),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Header,
	}, { corner(4) })
	onAccent(function() if Dot.Parent then Dot.BackgroundColor3 = Theme.Active end end)

	local TitleLabel = new("TextLabel", {
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 30, 0, 0),
		Size = UDim2.new(1, -130, 1, 0),
		Parent = Header,
	})

	local ClockLabel = new("TextLabel", {
		Text = os.date("%H:%M:%S"),
		Font = Theme.FontMono,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -100, 0, 0),
		Size = UDim2.new(0, 88, 1, 0),
		Parent = Header,
	})
	task.spawn(function()
		while ClockLabel.Parent do
			ClockLabel.Text = os.date("%H:%M:%S")
			task.wait(1)
		end
	end)

	-- ---------------- Barra de pestañas (horizontal, arriba) ----------------
	local TabBar = new("ScrollingFrame", {
		Name = "TabBar",
		Position = UDim2.new(0, 0, 0, HEADER_H),
		Size = UDim2.new(1, 0, 0, TABBAR_H),
		BackgroundColor3 = Theme.Bar,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ClipsDescendants = true,
		Parent = Shell,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = TabBar,
	})
	pad(0, 6, 10, 0, 10).Parent = TabBar

	new("Frame", {
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Parent = TabBar,
	})

	local Indicator = new("Frame", {
		Name = "Indicator",
		Size = UDim2.new(0, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = TabBar,
	})
	onAccent(function() if Indicator.Parent then Indicator.BackgroundColor3 = Theme.Active end end)

	-- ---------------- Panel de contenido ----------------
	local ContentArea = new("Frame", {
		Name = "ContentArea",
		Position = UDim2.new(0, 0, 0, HEADER_H + TABBAR_H),
		Size = UDim2.new(1, 0, 0, CONTENT_H),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = Shell,
	}, { corner(RADIUS) })
	new("Frame", {
		Size = UDim2.new(1, 0, 0, RADIUS),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = ContentArea,
	})

	-- Barrido de luz: una franja horizontal clara que recorre el panel
	-- de arriba a abajo cada tanto, efecto "escaneo de holograma".
	local ScanLine = new("Frame", {
		Name = "ScanLine",
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = ContentArea,
	})
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.85),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Color = ColorSequence.new(Theme.Active),
		Parent = ScanLine,
	})

	local EmptyHint = new("TextLabel", {
		Text = "Sin pestañas todavía.\nUsá Window:CreateTab({ Name = \"...\" }).",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 14),
		Size = UDim2.new(1, -28, 1, -28),
		Parent = ContentArea,
	})

	local Window = setmetatable({
		ScreenGui = ScreenGui, Root = Root, Shell = Shell,
		Header = Header, TitleLabel = TitleLabel, ClockLabel = ClockLabel,
		TabBar = TabBar, Indicator = Indicator, ContentArea = ContentArea,
		ScanLine = ScanLine, EmptyHint = EmptyHint,
		WIDTH = WIDTH, HEADER_H = HEADER_H, TABBAR_H = TABBAR_H, CONTENT_H = CONTENT_H,
		_tabs = {}, _connections = {}, _visible = true,
		_loadId = LOAD_ID,
		_loadStagger = config.AutoLoadStagger or 0,
		_loadOrder   = config.AutoLoadOrder,
		_configName  = nil,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	if typeof(config.AutoSaveIgnore) == "table" then
		for _, word in ipairs(config.AutoSaveIgnore) do
			table.insert(autoSaveIgnore, word)
		end
	end

	local autoName = config.AutoSaveConfig
	if autoName == true then autoName = "default" end
	if typeof(autoName) == "string" and autoName ~= "" then
		Window._configName = autoName
		autoSaveTargets[autoName] = true
		if config.AutoLoadConfig ~= false then
			local delay = config.AutoLoadDelay or 0
			task.spawn(function()
				task.wait()
				if delay > 0 then task.wait(delay) end
				Window:LoadConfig(autoName)
			end)
		end
	end

	-- ---------------- Arrastre horizontal de la barra de pestañas ----------------
	local dragKind, dragStartPos, canvasStartX = nil, Vector2.new(0, 0), 0
	Window._dragMoved = false

	function Window._beginDrag(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		Window._dragMoved = false
		dragKind = kind
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		canvasStartX = TabBar.CanvasPosition.X
	end

	track(TabBar.InputBegan:Connect(function(input) Window._beginDrag(input) end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragKind then return end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - dragStartPos.X
		if math.abs(dx) > 8 then Window._dragMoved = true end
		if dragKind == Enum.UserInputType.MouseButton1 and Window._dragMoved then
			TabBar.CanvasPosition = Vector2.new(canvasStartX - dx, 0)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragKind = nil
		end
	end))

	-- ---------------- Escaneo animado + brillo del borde ----------------
	local ShellStroke = Shell:FindFirstChildOfClass("UIStroke")
	track(RunService.Heartbeat:Connect(function()
		if not Window._visible then return end
		local t = os.clock()
		if ShellStroke then
			ShellStroke.Color = Theme.Active
			ShellStroke.Transparency = 0.55 + 0.35 * (0.5 + 0.5 * math.sin(t * 1.5))
		end
		local anyOpen = #Window._tabs > 0
		if anyOpen then
			local cycle = (t % 2.6) / 2.6
			ScanLine.Position = UDim2.new(0, 0, cycle, -13)
			ScanLine.Visible = true
		else
			ScanLine.Visible = false
		end
	end))

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(UI.Windows, Window)
	local registry = rawget(_G, "__NovaUIWindows")
	if typeof(registry) ~= "table" then
		registry = {}
		rawset(_G, "__NovaUIWindows", registry)
	end
	table.insert(registry, Window)

	return Window
end

function UI:Show() self.Root.Visible = true self._visible = true end
function UI:Hide() self.Root.Visible = false self._visible = false end
function UI:Toggle() if self._visible then self:Hide() else self:Show() end end
function UI:SetTitle(text) if self.TitleLabel then self.TitleLabel.Text = tostring(text) end end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do
		if w == self then table.remove(UI.Windows, i) break end
	end
end

-- ============================================================
-- 	CREATE TAB
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))
	local isFirst = #self._tabs == 0

	if self.EmptyHint then self.EmptyHint:Destroy() self.EmptyHint = nil end

	local TabBtn = new("TextButton", {
		Name = name,
		Text = name,
		Font = isFirst and Theme.FontBold or Theme.Font,
		TextSize = 13,
		TextColor3 = isFirst and Theme.Active or Theme.TextDim,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, math.max(#name * 8 + 20, 60), 1, 0),
		LayoutOrder = #self._tabs + 1,
		Parent = self.TabBar,
	})

	local List, PanelScroll
	local Panel = new("ScrollingFrame", {
		Name = name .. "Panel",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = isFirst,
		Parent = self.ContentArea,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 14, 14, 14, 14),
	})
	List = Panel

	local Tab = setmetatable({
		Window = self, Button = TabBtn, Panel = Panel, List = List,
		Name = name, _rowCount = 0,
	}, UI)

	local function updateIndicator()
		tween(self.Indicator, {
			Position = UDim2.new(0, TabBtn.AbsolutePosition.X - self.TabBar.AbsolutePosition.X + self.TabBar.CanvasPosition.X, 1, -1),
			Size = UDim2.new(0, TabBtn.AbsoluteSize.X, 0, 2),
		}, 0.2)
	end

	table.insert(self._connections, TabBtn.MouseButton1Click:Connect(function()
		if self._dragMoved then return end
		self:SelectTab(name)
	end))

	table.insert(self._tabs, Tab)

	if isFirst then
		task.defer(function()
			updateIndicator()
		end)
	end

	Tab._updateIndicator = updateIndicator
	return Tab
end

function UI:SelectTab(name)
	for _, tab in ipairs(self._tabs or {}) do
		local selected = (tab.Name == name)
		tab.Panel.Visible = selected
		tab.Button.TextColor3 = selected and Theme.Active or Theme.TextDim
		tab.Button.Font = selected and Theme.FontBold or Theme.Font
		if selected and tab._updateIndicator then
			tab._updateIndicator()
		end
	end
end

