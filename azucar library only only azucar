function UI:CreateTab(config, icon)
	if typeof(config) == "string" then config = { Name = config } end
	config = config or {}
	if icon ~= nil then config.Icon = icon end
	if config.Icon == nil then config.Icon = config.IconName or config.Image end
	local window = self
	local name = tostring(config.Text or config.Name or config.Title or ("Tab " .. (#window._tabs + 1)))

	local page = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Size = UDim2.new(1, 0, 1, 0), Parent = window._content,
	})
	-- Dos columnas que scrollean (rueda / dedo) SIN barra visible.
	local function column(x)
		return new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(x, x == 0 and 0 or 3, 0, 0),
			Size = UDim2.new(0.5, -3, 1, 0), ScrollBarThickness = 0, ScrollBarImageTransparency = 1,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
		}, { new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }), pad(2, 8, 2, 4) })
	end
	local btn = new("TextButton", {
		Text = "", BackgroundColor3 = Theme.Field, BorderSizePixel = 0, AutoButtonColor = false, Parent = window._tabbar,
	}, { stroke(Theme.Border, 1) })
	local lbl = label({
		Text = string.lower(name), TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 1, 0), Parent = btn,
	})

	local tab = setmetatable({
		Window = window, Name = name, List = page, Root = page, _page = page, _btn = btn, _lbl = lbl,
		_cols = { column(0), column(0.5) }, _heights = { 0, 0 }, _opts = {}, _rowCount = 0, _threads = {},
	}, UI)

	function tab:SetIcon(spec)
		if self._icon then self._icon.box:Destroy() self._icon = nil end
		if spec ~= nil and spec ~= false then
			self._icon = makeIcon(btn, spec)
			if spec ~= nil and not self._icon then warn("[AzucarSquare] Icono desconocido: " .. tostring(spec)) end
		end
		lbl.Position = UDim2.new(0, self._icon and 18 or 0, 0, 0)
		lbl.Size = UDim2.new(1, self._icon and -18 or 0, 1, 0)
	end
	function tab:SetOpen(open)
		if open ~= false then window:SelectTab(self) end
	end
	tab:SetIcon(config.Icon)

	table.insert(window._tabs, tab)
	table.insert(window._connections, btn.MouseButton1Click:Connect(function() window:SelectTab(tab) end))
	table.insert(window._connections, btn.MouseEnter:Connect(function() if not tab._on then btn.BackgroundColor3 = Theme.Line end end))
	table.insert(window._connections, btn.MouseLeave:Connect(function() if not tab._on then btn.BackgroundColor3 = Theme.Field end end))
	window:_layoutTabs()
	if #window._tabs == 1 or config.Open == true then window:SelectTab(tab) end
	return tab
end

function UI:_layoutTabs()
	local n = #self._tabs
	for i, t in ipairs(self._tabs) do
		t._btn.Size = UDim2.new(1 / n, i == n and 0 or -1, 1, 0)
		t._btn.Position = UDim2.new((i - 1) / n, 0, 0, 0)
	end
end

function UI:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = (t == tab)
		t._on = on
		t._page.Visible = on
		t._btn.BackgroundColor3 = on and Theme.Active or Theme.Field
		t._lbl.TextColor3 = on and Theme.OnAccent or Theme.Text
		if t._icon then t._icon.paint(on and Theme.OnAccent or Theme.Text) end
	end
	self._current = tab
	self:_activeRefresh()
end

