function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
	local text = config.Text or config.Name or config.Title or "Botón"
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, text, 84)
	local Pill = opt.Pill
	local Btn = new("TextButton", {
		Text = config.ButtonText or "Ejecutar", Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.Text,
		AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Pill,
	})

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)
	function Button:Set(...)
		-- Destello rosa de la píldora que se apaga solo.
		Pill.BackgroundColor3 = Theme.Active
		tween(Pill, { BackgroundColor3 = Theme.Panel }, 0.3)
		Btn.TextColor3 = Color3.new(1, 1, 1)
		task.delay(0.2, function()
			if Btn.Parent then Btn.TextColor3 = Theme.Text end
		end)
		opt.Flash()
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set
	function Button:Stop() stopAllThreads(self) end
	table.insert(window._connections, Btn.MouseButton1Click:Connect(function() Button:Set() end))
	registerFlag(config.Flag, Button, nil)
	return Button
end

function UI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end
	state = not not state
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, config.Text or config.Name or "Opción", 70)
	local Pill = opt.Pill
	local OFF_POS, ON_POS = UDim2.new(0, 7, 0.5, 0), UDim2.new(1, -7, 0.5, 0)

	local StateLabel = new("TextLabel", {
		Text = state and "ON" or "OFF", Font = Theme.FontMono, TextSize = 10,
		TextColor3 = state and Theme.Active or Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1, Position = UDim2.new(0, 11, 0, 0), Size = UDim2.new(0, 24, 1, 0), Parent = Pill,
	})
	local Track = new("Frame", {
		Size = UDim2.new(0, 28, 0, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		BackgroundColor3 = state and Theme.Active or Theme.Line, BorderSizePixel = 0, Parent = Pill,
	}, { circle(), accentStroke(1) })
	local Knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = state and ON_POS or OFF_POS,
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Track,
	}, { circle() })

	local Toggle = setmetatable({ Value = state, Callback = callback, _threads = {} }, UI)
	onAccent(function()
		if Track.Parent then
			StateLabel.TextColor3 = Toggle.Value and Theme.Active or Theme.TextDim
			Track.BackgroundColor3 = Toggle.Value and Theme.Active or Theme.Line
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		StateLabel.Text = newState and "ON" or "OFF"
		StateLabel.TextColor3 = newState and Theme.Active or Theme.TextDim
		tween(Track, { BackgroundColor3 = newState and Theme.Active or Theme.Line }, 0.15)
		tween(Knob, { Position = newState and ON_POS or OFF_POS }, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		opt.SetActive(newState)
		setFlagValue(config.Flag, newState)
		return safeCall(self, self.Callback, newState)
	end
	function Toggle:Get() return self.Value end
	function Toggle:Stop() stopAllThreads(self) end

	opt.SetActive(state)
	local Click = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Pill })
	table.insert(window._connections, Click.MouseButton1Click:Connect(function() Toggle:Set(not Toggle.Value) end))
	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)
	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then rangeMin = rangeMin or config.Range[1] rangeMax = rangeMax or config.Range[2] end
	local min, max = rangeMin or 0, rangeMax or 100
	if max <= min then max = min + 1 end
	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end
	local decimals = 0
	if step < 1 then decimals = math.min(#tostring(step):gsub("^%d*%.?", ""), 3) end
	local function snap(v) v = math.clamp(v, min, max) return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max) end
	local function show(v) if decimals > 0 then return string.format("%." .. decimals .. "f", v) end return tostring(math.floor(v + 0.5)) end
	local value = snap(config.Default or config.CurrentValue or min)
	local initial = value

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local W = 146
	local opt = makeOption(owner, config.Text or config.Name or "Valor", W)
	local Pill = opt.Pill

	local Dec = stepButton(Pill, "‹", 5)
	local Inc = stepButton(Pill, "›", W - 20)
	local Hit = new("Frame", { Size = UDim2.new(0, 60, 0, 18), Position = UDim2.new(0, 25, 0.5, -9), BackgroundTransparency = 1, Parent = Pill })
	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = Hit,
	}, { corner(2) })
	local function ratio(v) return (v - min) / (max - min) end
	local Fill = new("Frame", { Size = UDim2.new(ratio(value), 0, 1, 0), BackgroundColor3 = Theme.Active, BorderSizePixel = 0, Parent = Track }, { corner(2) })
	onAccent(function() if Fill.Parent then Fill.BackgroundColor3 = Theme.Active end end)
	local Knob = new("Frame", {
		Size = UDim2.new(0, 9, 0, 9), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(ratio(value), 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Track,
	}, { circle(), accentStroke(1.2) })
	local KnobPop = new("UIScale", { Scale = 1, Parent = Knob })
	local ValueLabel = new("TextLabel", {
		Text = show(value), Font = Theme.FontMono, TextSize = 10, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 1, Position = UDim2.new(0, 88, 0, 0), Size = UDim2.new(0, 34, 1, 0), Parent = Pill,
	})

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value, Min = min, Max = max, Callback = callback, _threads = {} }, UI)
	local function repaint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, 0, 0.5, 0)
		ValueLabel.Text = show(v)
	end
	function Slider:Set(newValue, whileDragging)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		opt.SetActive(newValue ~= initial)
		setFlagValue(config.Flag, newValue, whileDragging)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end

	table.insert(window._connections, Dec.MouseButton1Click:Connect(function() Slider:Set(Slider.Value - step) end))
	table.insert(window._connections, Inc.MouseButton1Click:Connect(function() Slider:Set(Slider.Value + step) end))

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + relative * (max - min), dragging)
	end
	table.insert(window._connections, Hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(KnobPop, { Scale = 1.5 }, 0.1)
			setFromX(input.Position.X)
		end
	end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
			dragging = false
			tween(KnobPop, { Scale = 1 }, 0.12)
			setFlagValue(config.Flag, Slider.Value)
		end
	end))
	opt.SetActive(false)
	registerFlag(config.Flag, Slider, value)
	return Slider
end

function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}
	local function display(v) if typeof(v) == "Instance" then return v.Name end if typeof(v) == "table" and v.Name then return tostring(v.Name) end return tostring(v) end
	local function isValid(v) for _, o in ipairs(options) do if o == v then return true end end return false end
	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if wanted ~= nil and isValid(wanted) then selected = wanted end
	local initial = selected

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local W = 126
	local opt = makeOption(owner, config.Text or config.Name or "Opciones", W)
	local Pill = opt.Pill
	local Prev = stepButton(Pill, "‹", 5)
	local Next = stepButton(Pill, "›", W - 20)
	local SelectedBtn = new("TextButton", {
		Text = selected ~= nil and display(selected) or "-", Font = Theme.FontMono, TextSize = 10, TextColor3 = Theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false, BackgroundTransparency = 1,
		Position = UDim2.new(0, 24, 0, 0), Size = UDim2.new(1, -48, 1, 0), Parent = Pill,
	})

	local Dropdown = setmetatable({ Value = selected, Options = options, Callback = callback, _threads = {} }, UI)
	function Dropdown:Set(option)
		self.Value = option
		SelectedBtn.Text = display(option)
		opt.SetActive(option ~= initial)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end
	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		if not keepSelection then
			self.Value = self.Options[1]
			SelectedBtn.Text = self.Value ~= nil and display(self.Value) or "-"
		end
	end
	Dropdown.SetOptions = Dropdown.Refresh

	-- Las flechas (y tocar el nombre) pasan a la opción anterior/siguiente, dando la vuelta.
	local function stepBy(dir)
		local opts = Dropdown.Options
		if #opts == 0 then return end
		local idx = table.find(opts, Dropdown.Value) or 0
		idx = ((idx - 1 + dir) % #opts) + 1
		Dropdown:Set(opts[idx])
	end
	table.insert(window._connections, Prev.MouseButton1Click:Connect(function() stepBy(-1) end))
	table.insert(window._connections, Next.MouseButton1Click:Connect(function() stepBy(1) end))
	table.insert(window._connections, SelectedBtn.MouseButton1Click:Connect(function() stepBy(1) end))

	opt.SetActive(false)
	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

function UI:CreateInput(config)
	config = config or {}
	local callback = resolveCallback(config)
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, config.Text or config.Name or "Texto", 134)
	local Pill = opt.Pill
	local Box = new("TextBox", {
		Text = tostring(config.Default or config.CurrentValue or ""), PlaceholderText = config.PlaceholderText or config.Placeholder or "...",
		Font = Theme.FontMono, TextSize = 10, TextColor3 = Theme.Text, PlaceholderColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ClipsDescendants = true,
		BackgroundTransparency = 1, Position = UDim2.new(0, 11, 0, 0), Size = UDim2.new(1, -22, 1, 0), Parent = Pill,
	})

	local Input = setmetatable({ Instance = Box, Value = Box.Text, Callback = callback, _threads = {} }, UI)
	function Input:Set(text)
		self.Value = tostring(text)
		Box.Text = self.Value
		setFlagValue(config.Flag, self.Value)
		return safeCall(self, self.Callback, self.Value)
	end
	function Input:Get() return Box.Text end
	function Input:Stop() stopAllThreads(self) end
	table.insert(window._connections, Box.FocusLost:Connect(function(enterPressed)
		if enterPressed or config.FireOnLoseFocus then
			Input.Value = Box.Text
			setFlagValue(config.Flag, Box.Text)
			safeCall(Input, Input.Callback, Box.Text)
		end
	end))
	table.insert(window._connections, Box:GetPropertyChangedSignal("Text"):Connect(function()
		opt.SetActive(Box.Text ~= "")
	end))
	opt.SetActive(Box.Text ~= "")
	registerFlag(config.Flag, Input, Box.Text)
	return Input
end

function UI:CreateKeybind(config)
	config = config or {}
	local callback = resolveCallback(config)
	local currentKey = config.Default or config.CurrentKeybind or Enum.KeyCode.RightShift
	if typeof(currentKey) == "string" then
		local ok, parsed = pcall(function() return Enum.KeyCode[currentKey] end)
		currentKey = (ok and parsed) or Enum.KeyCode.RightShift
	end
	local listening = false
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, config.Text or config.Name or "Tecla", 96)
	local KeyButton = new("TextButton", {
		Text = currentKey.Name, Font = Theme.FontMono, TextSize = 10, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = opt.Pill,
	})

	local Keybind = setmetatable({ Value = currentKey, Callback = callback, _threads = {} }, UI)
	function Keybind:Set(keyCode)
		if typeof(keyCode) == "string" then
			local ok, parsed = pcall(function() return Enum.KeyCode[keyCode] end)
			keyCode = (ok and parsed) or self.Value
		end
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		setFlagValue(config.Flag, keyCode)
	end
	function Keybind:Get() return self.Value end
	function Keybind:Stop() stopAllThreads(self) end
	table.insert(window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
		KeyButton.TextColor3 = Theme.Active
	end))
	table.insert(window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			KeyButton.TextColor3 = Theme.Text
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			safeCall(Keybind, Keybind.Callback, Keybind.Value)
		end
	end))
	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end

