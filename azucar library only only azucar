--[[
	AzucarDulce  v2.0  —  "Píldoras"
	================================
	(Antes: v1.1 con un rectángulo único. Misma lógica por dentro:
	Flags, Callbacks, Logic, guardado de config, Notify. Lo que cambió
	es el LAYOUT.)

	CÓMO SE VE Y SE USA:
	  • Cada pestaña es una tarjetita flotante (píldora) con su nombre y
	    un contador de opciones activas ("Movement  3 / 5").
	  • Tocás la cabecera de la pestaña y se abre la lista de opciones.
	    Tocala de nuevo y se cierra. Si la arrastrás, la movés de lugar.
	  • Tocás una opción (toggle, slider, dropdown, input, tecla o
	    botón) y se despliega al costado una píldora con el control:
	        Toggle   -> interruptor ON / OFF
	        Slider   -> barra + flechitas ‹ › para subir/bajar de a un paso
	        Dropdown -> ‹ Valor › (las flechas cambian de opción)
	        Input    -> caja de texto (Enter para aplicar)
	        Keybind  -> botón para elegir la tecla
	        Button   -> botón "Ejecutar"
	    Podés tener varias píldoras abiertas a la vez. Tocás la opción de
	    nuevo y la píldora se pliega.
	  • El puntito de cada opción se rellena cuando está "activa":
	        Toggle prendido, Slider/Dropdown con un valor distinto del
	        inicial, Input con texto. Botones y teclas no cuentan.
	    Ese conteo es el "3 / 5" de la cabecera.
	  • Arriba a la izquierda hay una tarjetita con el título, el
	    Badge/ServerName y el reloj (se apaga con ShowBrand = false).

	Paleta de "sabores": Fresa (por defecto), Chicle, Uva y Menta.
	Cambia SOLO el acento, no el fondo.

	Uso:
		local UI = loadstring(game:HttpGet("...AzucarDulce.lua"))()
		local Window = UI:CreateWindow({
			Title       = "Dulce Hub",
			Badge       = "NAH ID ADAPT",
			ServerName  = "NAH ID ADAPT",
			ToggleKey   = Enum.KeyCode.K,
			Theme       = "Fresa",   -- "Fresa" | "Chicle" | "Uva" | "Menta"
			CornerStyle = "Round",   -- "Round" | "Sharp"
			TabWidth    = 134,       -- ancho de una pestaña abierta
			SideWidth   = 148,       -- espacio entre pestañas para las píldoras
			Position    = UDim2.new(0, 12, 0, 10), -- dónde arranca todo
			ShowBrand   = true,
			AutoSaveConfig  = true,
			AutoLoadStagger = 0.1,
			AutoLoadOrder   = {"M", "F", "A"},
			AutoSaveIgnore  = {"MiniPekka"},
		})
		local Movement = Window:CreateTab({ Name = "Movement" })
		Movement:CreateSlider({ Text = "Walk Speed", Range = {16, 300}, Default = 16,
			Callback = function(v) ... end })
		Movement:CreateToggle({ Text = "Fly", Flag = "Fly",
			Callback = function(state) ... end })
		Movement:CreateDropdown({ Text = "Point Mode", Options = {"Void", "Head"},
			Callback = function(opt) ... end })

		Window:Notify("Auto Farm activado")
		Window:Notify({ Title = "Atención", Text = "Te quedaste sin energía", Duration = 4 })
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TextService      = game:GetService("TextService")

local UI = {}
UI.__index = UI
UI.Version    = "2.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}
UI.ConfigFolder = "AzucarDulce"

local autoSaveTargets = {}
local loadingConfig = false
local autoSaveIgnore = {}
local function isIgnoredFlag(flag)
	local lower = tostring(flag):lower()
	for _, word in ipairs(autoSaveIgnore) do
		if typeof(word) == "string" and word ~= "" and lower:find(word:lower(), 1, true) then
			return true
		end
	end
	return false
end

