-- Repintado en vivo: al cambiar de sabor se recorre toda la UI ya dibujada y
-- cada color que era "del tema viejo" pasa a ser el color equivalente del tema
-- nuevo (fondo -> fondo, texto -> texto, acento -> acento...).
local THEME_KEYS = { "Background", "Panel", "Field", "RowIdle", "Line", "LineOpen", "Border", "Text", "TextDim", "Active", "ActiveDim" }
local KEYS_NORMAL = { "Background", "Panel", "Field", "RowIdle", "Line", "LineOpen", "Text", "TextDim", "Active", "ActiveDim", "Border" }
local KEYS_STROKE = { "Border", "Background", "Panel", "Field", "RowIdle", "Line", "LineOpen", "Text", "TextDim", "Active", "ActiveDim" }

local function themeSnapshot()
	local snap = {}
	for _, k in ipairs(THEME_KEYS) do snap[k] = Theme[k] end
	return snap
end
local function sameColor(a, b)
	return math.abs(a.R - b.R) < 0.0025 and math.abs(a.G - b.G) < 0.0025 and math.abs(a.B - b.B) < 0.0025
end
local function remapColor(c, old, new, keys)
	for _, k in ipairs(keys) do
		if old[k] and new[k] and sameColor(old[k], c) then return new[k] end
	end
	return nil
end
local function rethemeTree(root, old, new)
	local function fix(inst, prop, keys)
		local ok, c = pcall(function() return inst[prop] end)
		if ok and typeof(c) == "Color3" then
			local nc = remapColor(c, old, new, keys)
			if nc then pcall(function() inst[prop] = nc end) end
		end
	end
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("UIStroke") then
			fix(inst, "Color", KEYS_STROKE)
		elseif inst:IsA("GuiObject") then
			fix(inst, "BackgroundColor3", KEYS_NORMAL)
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				fix(inst, "TextColor3", KEYS_NORMAL)
				if inst:IsA("TextBox") then fix(inst, "PlaceholderColor3", KEYS_NORMAL) end
			end
		end
	end
end

function UI:SetAccentColor(paletteName)
	local key, p = paletteName, Palettes[paletteName]
	if p == nil and typeof(paletteName) == "string" then
		for name, pal in pairs(Palettes) do
			if name:lower() == paletteName:lower() then key, p = name, pal break end
		end
	end
	if not p then
		warn("[AzucarDulce] Sabor desconocido: " .. tostring(paletteName) .. ". Usá Fresa, Chicle, Uva, Menta o Troll.")
		return
	end
	local old = themeSnapshot()
	UI.CurrentPalette = key
	for k, v in pairs(BaseTheme) do Theme[k] = v end
	if typeof(p) == "table" then
		for k, v in pairs(p) do Theme[k] = v end
		Theme.ActiveDim = Theme.Active:Lerp(Color3.new(0, 0, 0), 0.22)
	else
		Theme.Border, Theme.Active = p, p
		Theme.ActiveDim = p:Lerp(Color3.new(0, 0, 0), 0.22)
	end
	local new = themeSnapshot()
	for _, w in ipairs(UI.Windows) do
		if w.ScreenGui and w.ScreenGui.Parent then pcall(rethemeTree, w.ScreenGui, old, new) end
		if w._activeGui and w._activeGui.Parent then pcall(rethemeTree, w._activeGui, old, new) end
	end
	for _, fn in ipairs(accentListeners) do pcall(fn) end
end
UI.SetTheme = UI.SetAccentColor

