-- ============================================================
function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}

	local function display(value)
		if typeof(value) == "Instance" then return value.Name end
		if typeof(value) == "table" and value.Name then return tostring(value.Name) end
		return tostring(value)
	end
	local function isValid(value)
		for _, opt in ipairs(options) do if opt == value then return true end end
		return false
	end

	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if wanted ~= nil and isValid(wanted) then selected = wanted end

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	})

	new("TextLabel", {
		Text = config.Text or config.Name or "Opciones",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(0.45, -10, 0, 32),
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = selected ~= nil and display(selected) or "-",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.45, 0, 0, 0),
		Size = UDim2.new(0.55, -24, 0, 32),
		Parent = Row,
	})
	onAccent(function()
		if SelectedLabel.Parent then SelectedLabel.TextColor3 = Theme.Active end
	end)

	local Arrow = new("TextLabel", {
		Text = "+",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -20, 0, 0),
		Size = UDim2.new(0, 16, 0, 32),
		Parent = Row,
	})

	local ROW_H = 32
	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, -16, 0, math.min(math.max(#options, 1), 6) * 24 + 8),
		Position = UDim2.new(0, 8, 0, ROW_H),
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		stroke(Theme.Border, 1), pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = setmetatable({ Value = selected, Options = options, Callback = callback, _threads = {} }, UI)

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = display(option)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end

	local setOpen
	local function buildOptions()
		for _, child in ipairs(ListFrame:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for index, optionValue in ipairs(Dropdown.Options) do
			local OptionBtn = new("TextButton", {
				Text = display(optionValue),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				BackgroundColor3 = Theme.Field,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 22),
				LayoutOrder = index,
				Parent = ListFrame,
			}, { corner(3), pad(0, 0, 6, 0, 6) })
			OptionBtn.MouseEnter:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.LineOpen }) end)
			OptionBtn.MouseLeave:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.Field }) end)
			table.insert(window._connections, OptionBtn.MouseButton1Click:Connect(function()
				Dropdown:Set(optionValue)
				if setOpen then setOpen(false) end
			end))
		end
	end

	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		buildOptions()
		local h = math.min(math.max(#self.Options, 1), 6) * 24 + 8
		ListFrame.Size = UDim2.new(1, -16, 0, h)
		if not keepSelection then
			self.Value = self.Options[1]
			SelectedLabel.Text = self.Value ~= nil and display(self.Value) or "-"
		end
	end
	Dropdown.SetOptions = Dropdown.Refresh

	buildOptions()

	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ROW_H), Parent = Row })

	function setOpen(open)
		local h = math.min(math.max(#Dropdown.Options, 1), 6) * 24 + 8
		Row.Size = UDim2.new(1, 0, 0, open and (ROW_H + h + 4) or ROW_H)
		Arrow.Text = open and "-" or "+"
	end

	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		setOpen(Row.Size.Y.Offset <= ROW_H)
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

