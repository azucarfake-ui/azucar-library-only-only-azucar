local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function stroke(color, thickness)
	return new("UIStroke", {
		Color = color or Theme.Border, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Miter,
	})
end

local function pad(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	})
end

local function label(props)
	local p = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Font = Theme.Font, TextSize = Theme.TextSize,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
	}
	for k, v in pairs(props) do p[k] = v end
	return new("TextLabel", p)
end

local function isClick(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then return hui end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then
		if pcall(function() local p = Instance.new("Folder") p.Parent = coreGui p:Destroy() end) then return coreGui end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

local LOAD_ID = tostring(os.clock()) .. "-" .. tostring(math.random(1, 1000000000))
local function cleanupOldWindows(guiParent)
	local registry = rawget(_G, "__AzucarDulceWindows")
	if typeof(registry) == "table" then
		for i = #registry, 1, -1 do
			local w = registry[i]
			if typeof(w) == "table" and w._loadId ~= LOAD_ID then
				pcall(function() w:Destroy() end)
				table.remove(registry, i)
			end
		end
	end
	local places = { guiParent }
	local plr = Players.LocalPlayer
	if plr and plr:FindFirstChild("PlayerGui") then table.insert(places, plr.PlayerGui) end
	pcall(function() table.insert(places, game:GetService("CoreGui")) end)
	for _, place in ipairs(places) do
		pcall(function()
			for _, child in ipairs(place:GetChildren()) do
				if child:IsA("ScreenGui") and (child.Name == "AzucarDulce" or child.Name == "AzucarActiveList")
					and child:GetAttribute("AzucarLoadId") ~= LOAD_ID then
					child:Destroy()
				end
			end
		end)
	end
end

