	})
	local Track = new("Frame", {
		Size = UDim2.new(0, 28, 0, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		BackgroundColor3 = state and Theme.Active or Theme.Line, BorderSizePixel = 0, Parent = Pill,
	}, { circle(), accentStroke(1) })
	local Knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = state and ON_POS or OFF_POS,
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Track,
	}, { circle() })

	local Toggle = setmetatable({ Value = state, Callback = callback, _threads = {} }, UI)
	onAccent(function()
		if Track.Parent then
			StateLabel.TextColor3 = Toggle.Value and Theme.Active or Theme.TextDim
			Track.BackgroundColor3 = Toggle.Value and Theme.Active or Theme.Line
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		StateLabel.Text = newState and "ON" or "OFF"
		StateLabel.TextColor3 = newState and Theme.Active or Theme.TextDim
