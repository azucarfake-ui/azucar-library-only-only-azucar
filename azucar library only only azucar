function UI:CreateWindow(config)
	config = config or {}

	local title    = config.Title or config.Name or "Azúcar Hub"
	local subtitle = config.Subtitle or config.SubTitle or ""
	-- Riel ancho: antes eran 46px y solo entraba la inicial (o peor, el
	-- "rbxassetid://..." crudo del ícono). Ahora entra ícono + NOMBRE.
	local RAIL_W   = config.RailWidth or 148
	local PANEL_W  = config.PanelWidth or 275
	local HEADER_H = 32
	-- Más arriba: antes arrancaba en 8px por debajo del borde del área
	-- útil. Ahora queda pegada al tope.
	local TOP_Y    = config.TopOffset or 0
	-- Único margen que queda: un colchón chico abajo para que el panel
	-- no se pase del borde de la pantalla. Todo lo demás (cabecera-riel,
	-- riel-panel, panel-grupo) va a 0: sin separación, para que no se
	-- vea nada del fondo del juego colándose entre los bloques.
	-- Ya sin reservas: pegado también abajo, como pidió.
	local BOTTOM_MARGIN = config.BottomMargin or 0

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarHackerUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		-- false a propósito: así Roblox baja el contenido por debajo de
		-- su propia barra superior y el título/las pestañas dejan de
		-- quedar tapados (era el motivo de que "no se viera nada" arriba).
		IgnoreGuiInset = false,
	})

	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end
	ScreenGui.Parent = getGuiParent()

	-- Raíz a pantalla completa y transparente: los paneles se ubican
	-- adentro por offset y nunca quedan recortados por los bordes de un
	-- contenedor angosto.
	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	-- Shell: contenedor invisible que cuelga TODO lo demás (cabecera,
	-- riel, panel de cada pestaña, columnas de grupo). Moviendo nada más
	-- que Shell.Position se mueve el panel entero de una — es lo que
	-- permite el deslizamiento de apertura sin tener que animar cada
	-- pieza por separado, y lo que hace que Window:MoveTo sea un solo
	-- número en vez de reubicar cinco frames a mano.
	local Shell = new("Frame", {
		Name = "Shell",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, TOP_Y),
		BackgroundTransparency = 1,
		Parent = Root,
	})

	-- ---------------- Cabecera con el NOMBRE ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(0, RAIL_W + PANEL_W, 0, HEADER_H),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Shell,
	}, { corner(6), stroke(Theme.Border, 1) })

	-- Línea de acento bien fina justo debajo de la cabecera: un detalle
	-- de más "categoría" que separa la barra de título del resto sin
	-- necesitar sombras ni degradados.
	local HeaderUnderline = new("Frame", {
		Name = "HeaderUnderline",
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = Header,
	})
	onAccent(function()
		if HeaderUnderline.Parent then
			HeaderUnderline.BackgroundColor3 = Theme.Active
		end
	end)

	local AccentBar = new("Frame", {
		Name = "AccentBar",
		Size = UDim2.new(0, 3, 0, 18),
		Position = UDim2.new(0, 8, 0.5, -9),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Header,
	}, { corner(2) })
	onAccent(function()
		if AccentBar.Parent then
			AccentBar.BackgroundColor3 = Theme.Active
		end
	end)

	local TitleLabel = new("TextLabel", {
		Name = "Title",
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 0),
		Size = UDim2.new(1, -112, 1, 0),
		Parent = Header,
	})

	local SubLabel
	if subtitle ~= "" then
		TitleLabel.Size = UDim2.new(0, math.min(#title * 9 + 8, 130), 1, 0)
		SubLabel = new("TextLabel", {
			Text = subtitle,
			Font = Theme.Font,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 18 + TitleLabel.Size.X.Offset + 6, 0, 0),
			Size = UDim2.new(1, -(TitleLabel.Size.X.Offset + 134), 1, 0),
			Parent = Header,
		})
	end

	-- En vez de los botones "—" y "X" va el sello de la librería.
	-- Para abrir/cerrar el panel se usa la tecla K (o config.ToggleKey).
	local BrandLabel = new("TextLabel", {
		Name = "Brand",
		Text = "Azucar UI",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 90, 1, 0),
		Parent = Header,
	})
	onAccent(function()
		if BrandLabel.Parent then
			BrandLabel.TextColor3 = Theme.Active
		end
	end)

	-- ---------------- Riel de pestañas ----------------
	local Rail = new("Frame", {
		Name = "Rail",
		Size = UDim2.new(0, RAIL_W, 1, -(TOP_Y + HEADER_H + BOTTOM_MARGIN)),
		Position = UDim2.new(0, 0, 0, HEADER_H),
		BackgroundColor3 = Theme.Rail,
		BorderSizePixel = 0,
		Parent = Shell,
	}, { corner(6), stroke(Theme.Border, 1) })

	local RailList = new("ScrollingFrame", {
		Name = "RailList",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Rail,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 6, 5, 6, 5),
	})

	-- ---------------- Aviso "sin pestañas todavía" ----------------
	-- Si tu script muere antes de crear la primera pestaña, esto te lo
	-- dice en pantalla en vez de dejarte un panel negro mudo.
	local EmptyHint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Sin pestañas.\nRevisá la consola (F9):\nalgo cortó tu script\nantes de crearlas.",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(0, PANEL_W, 0, 90),
		Position = UDim2.new(0, RAIL_W, 0, HEADER_H),
		Parent = Shell,
	}, { stroke(Theme.Border, 1), pad(10) })

	-- ---------------- Watermark ----------------
	-- El típico rótulo de "external" arriba a la izquierda: nombre del
	-- hub + FPS + hora, siempre visible aunque cierres el panel con K.
	-- config.Watermark = false lo saca por completo.
	local showWatermark = config.Watermark ~= false
	local Watermark
	if showWatermark then
		Watermark = new("TextLabel", {
			Name = "Watermark",
			Text = title,
			Font = Theme.FontBold,
			TextSize = 12,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundColor3 = Theme.Header,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, 22),
			Position = UDim2.new(0, 8, 0, 8),
			Parent = ScreenGui,
		}, { stroke(Theme.Border, 1), pad(0, 0, 8, 0, 10) })

		local WatermarkAccent = new("Frame", {
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Theme.Active,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = Watermark,
		})
		onAccent(function()
			if WatermarkAccent.Parent then
				WatermarkAccent.BackgroundColor3 = Theme.Active
			end
		end)
	end

	-- ---------------- Notificaciones ----------------
	local NotifyHolder = new("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, 250, 1, -20),
		Position = UDim2.new(1, -262, 0, 10),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local Window = setmetatable({
		ScreenGui   = ScreenGui,
		Root        = Root,
		Shell       = Shell,
		Header      = Header,
		TitleLabel  = TitleLabel,
		SubLabel    = SubLabel,
		Rail        = Rail,
		RailList    = RailList,
		EmptyHint   = EmptyHint,
		NotifyHolder = NotifyHolder,
		Watermark   = Watermark,
		RAIL_W      = RAIL_W,
		PANEL_W     = PANEL_W,
		HEADER_H    = HEADER_H,
		TOP_Y       = TOP_Y,
		BOTTOM_MARGIN = BOTTOM_MARGIN,
		_originX     = 0,
		_originY     = TOP_Y,
		_tabs        = {},
		_connections = {},
		_visible     = true,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- ---------------- FPS y hora del watermark ----------------
	if Watermark then
		local RunService = game:GetService("RunService")
		local frames, lastCount, fps = 0, os.clock(), 0

		track(RunService.Heartbeat:Connect(function()
			frames = frames + 1
			local now = os.clock()
			if now - lastCount >= 1 then
				fps = frames
				frames = 0
				lastCount = now
			end
		end))

		-- Se corta solo apenas el watermark deja de existir (:Destroy()),
		-- no hace falta guardar ni cancelar este hilo a mano.
		task.spawn(function()
			while Watermark.Parent do
				Watermark.Text = string.format("%s  |  %d FPS  |  %s", title, fps, os.date("%H:%M:%S"))
				task.wait(0.5)
			end
		end)
	end

	-- ---------------- Ventana FIJA ----------------
	-- Antes la cabecera se podía arrastrar con el mouse. Se sacó a
	-- propósito: la interfaz queda clavada en su lugar y no hay forma de
	-- correrla sin querer mientras jugás. Si algún día la querés mover
	-- desde código, Window:MoveTo(x, y) sigue existiendo.
	Header.Active = false

	-- ---------------- Tecla para abrir/cerrar ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(UI.Windows, Window)

	-- Arranca deslizándose desde la izquierda, como el resto de las
	-- aperturas (Show/Toggle). Como tu script arma las pestañas justo
	-- después de este CreateWindow, para cuando termina el deslizamiento
	-- (unos 0.3s) el panel ya tiene todo su contenido adentro.
	Window:Show()

	return Window
end

-- ============================================================
-- 	MÉTODOS DE VENTANA
-- ============================================================
-- Reposiciona TODO el panel de una: como cabecera, riel y cada panel de
-- pestaña/grupo cuelgan del Shell, alcanza con mover un solo objeto en
-- vez de reubicar cinco frames a mano uno por uno.
--
-- Los ALTOS siguen necesitando el offsetY: el riel y los paneles miden
-- "1 de escala" MENOS un offset, y esa escala 1 siempre es el 100% de
-- la PANTALLA (no del Shell), así que para que el borde de abajo quede
-- a BOTTOM_MARGIN píxeles del final de la pantalla hay que restar
-- cuánto bajó el Shell (offsetY) más la cabecera más el margen.
function UI:MoveTo(offsetX, offsetY)
	self.TOP_Y = offsetY
	self._originX = offsetX
	self._originY = offsetY

	self.Shell.Position = UDim2.new(0, offsetX, 0, offsetY)

	local reserved = offsetY + self.HEADER_H + self.BOTTOM_MARGIN
	self.Rail.Size = UDim2.new(0, self.RAIL_W, 1, -reserved)

	for _, tab in ipairs(self._tabs) do
		tab.Panel.Size = UDim2.new(0, self.PANEL_W, 1, -reserved)
		for _, group in pairs(tab._groupPanels) do
			group.Instance.Size = UDim2.new(0, self.PANEL_W, 1, -reserved)
		end
	end
end

function UI:SetTitle(text)
	if self.TitleLabel then
		self.TitleLabel.Text = tostring(text)
	end
end

-- Distancia de deslizamiento: bien afuera de la pantalla a la
-- izquierda (riel + panel + un colchón), así nunca se alcanza a ver
-- el corte del panel entrando.
local function slideOffscreenX(self)
	return -(self.RAIL_W + self.PANEL_W + 60)
end

function UI:Show()
	self._visible = true
	self.Root.Visible = true

	local restX = self._originX or 0
	local y = self._originY or 0

	self.Shell.Position = UDim2.new(0, slideOffscreenX(self), 0, y)
	tween(self.Shell, { Position = UDim2.new(0, restX, 0, y) }, 0.32)
end

function UI:Hide()
	if not self._visible then
		return
	end
	self._visible = false

	local restX = self._originX or 0
	local y = self._originY or 0

	local outTween = TweenService:Create(
		self.Shell,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.new(0, slideOffscreenX(self), 0, y) }
	)
	-- Conectado ANTES de Play(): si algún día esto corre en un contexto
	-- donde Completed pudiera dispararse en el mismo instante (como en
	-- las pruebas), conectar después dejaría el handler sin engancharse
	-- a tiempo para escuchar ese disparo.
	outTween.Completed:Connect(function()
		-- Si mientras tanto lo volvieron a abrir, no lo ocultes ni lo
		-- dejes fuera de pantalla: Show() ya se encargó de todo.
		if self._visible then return end
		self.Root.Visible = false
		self.Shell.Position = UDim2.new(0, restX, 0, y)
	end)
	outTween:Play()
end

function UI:Toggle()
	if self._visible then
		self:Hide()
	else
		self:Show()
	end
end

function UI:Notify(config)
	config = config or {}
	local holder = self.NotifyHolder
	if not holder then return end

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(4), stroke(Theme.Border, 1), pad(8) })

	new("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.new(0, -8, 0, -8),
