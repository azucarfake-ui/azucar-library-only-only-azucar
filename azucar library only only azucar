local Palettes = {
	Rojo   = { Active = Color3.fromRGB(226, 52, 52),  ActiveDim = Color3.fromRGB(152, 32, 32) },
	Azul   = { Active = Color3.fromRGB(48, 132, 232),  ActiveDim = Color3.fromRGB(28, 84, 160) },
	Verde  = { Active = Color3.fromRGB(52, 199, 105),  ActiveDim = Color3.fromRGB(30, 132, 70) },
	Blanco = { Active = Color3.fromRGB(226, 226, 232), ActiveDim = Color3.fromRGB(150, 150, 158) },
}
UI.Palettes = Palettes
UI.CurrentPalette = "Rojo"

local accentListeners = {}
local function onAccent(fn)
	table.insert(accentListeners, fn)
	return fn
end

local rainbowThread = nil
function UI:SetAccentColor(paletteName)
	if rainbowThread then
		pcall(task.cancel, rainbowThread)
		rainbowThread = nil
	end

	if paletteName == "Rainbow" or paletteName == "RGB" then
		UI.CurrentPalette = "Rainbow"
		rainbowThread = task.spawn(function()
			local hue = 0
			while true do
				hue = (hue + 0.006) % 1
				Theme.Active = Color3.fromHSV(hue, 0.85, 1)
				Theme.ActiveDim = Color3.fromHSV(hue, 0.85, 0.62)
				for _, listener in ipairs(accentListeners) do pcall(listener) end
				task.wait(0.03)
			end
		end)
		return
	end

	local palette = Palettes[paletteName]
	if not palette then
		warn("[AzucarLegit] Paleta desconocida: " .. tostring(paletteName))
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Active    = palette.Active
	Theme.ActiveDim = palette.ActiveDim
	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end

-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

-- Sin argumento usa el radio "fuerte" (pestañas, cuerpos, cabecera).
-- corner("soft") usa el radio chico (filas de controles, campos).
-- corner(N) fuerza un número puntual si alguna vez hace falta.
local function corner(radius)
	if radius == "soft" then
		return new("UICorner", { CornerRadius = UDim.new(0, Theme.CornerRadiusSoft) })
	end
	return new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.CornerRadius) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time, style, dir)
	TweenService:Create(inst, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	return inst
end

-- Hover que lee Theme.Active/Border EN EL MOMENTO del evento, nunca un
-- valor viejo capturado desde que se creó el elemento (así sobrevive a
-- un cambio de paleta con SetAccentColor).
local function hoverField(obj, base)
	base = base or Theme.Field
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.LineOpen })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = base })
	end)
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES (SIN LÍMITE)
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)
	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarLegit] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else
				warn("[AzucarLegit] La tabla en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

-- Guarda el valor de una Flag sin reventar si el control no tiene Flag
-- (tabla[nil] = valor tira error en Lua y mataría el hilo ahí mismo).
local function setFlagValue(flagName, value)
	if flagName == nil then return end
	UI.FlagValues[flagName] = value
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

-- Todas las filas (Toggle/Slider/Botón/...) se agregan adentro de
-- self.List — la columna de contenido que vive DENTRO del acordeón de
-- la pestaña. Si alguien crea un control directo sobre la ventana (sin
-- pasar por CreateTab), se avisa y se cuelga en la primera pestaña para
-- no perderlo.
local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		warn("[AzucarLegit] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return self._tabs[1].List, self, self._tabs[1]
	end
	return nil, (self.Window or self), self
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title  = config.Title or config.Name or "Azúcar Hub"
	local LIST_W = config.Width or 340
	local HEADER_H = 34
	local TOP_Y = config.TopOffset or 0
	local BOTTOM_MARGIN = config.BottomMargin or 0

	-- Por defecto la UI se para POR ENCIMA de la barra superior de
	-- Roblox (más arriba posible en la pantalla). Si alguna vez la
	-- tapa algo que no querés tapar, pasá config.IgnoreGuiInset = false
	-- para volver a respetar esa barra.
	local ignoreInset = true
	if config.IgnoreGuiInset == false then
		ignoreInset = false
	end

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarLegit",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = ignoreInset,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	ScreenGui.Parent = getGuiParent()

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	-- ---------------- Cabecera: título + reloj ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(0, LIST_W, 0, HEADER_H),
		Position = UDim2.new(0, 0, 0, TOP_Y),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(), stroke(Theme.Border, 1) })

	local AccentBar = new("Frame", {
		Size = UDim2.new(0, 3, 0, 20),
		Position = UDim2.new(0, 10, 0.5, -10),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Header,
	}, { corner("soft") })
	onAccent(function()
		if AccentBar.Parent then AccentBar.BackgroundColor3 = Theme.Active end
	end)

	local TitleLabel = new("TextLabel", {
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(0.5, -22, 1, 0),
		Parent = Header,
	})

	-- El reloj usa la hora de TU PC (os.date), así que ya sale en el
	-- horario de tu país sin tener que configurar ningún huso horario.
	local ClockLabel = new("TextLabel", {
		Name = "Clock",
		Text = os.date("%H:%M:%S"),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, -14, 1, 0),
		Parent = Header,
	})
	onAccent(function()
		if ClockLabel.Parent then ClockLabel.TextColor3 = Theme.Active end
	end)

	task.spawn(function()
		while ClockLabel.Parent do
			ClockLabel.Text = os.date("%H:%M:%S")
			task.wait(1)
		end
	end)

	-- ---------------- Lista de pestañas (las "líneas") ----------------
	-- Separación real entre pestañas (8px) para que, con esquinas
	-- redondeadas, se vean como tarjetas propias y no como una sola
	-- franja cuadrada partida en pedazos.
	local SlideList = new("ScrollingFrame", {
		Name = "SlideList",
		Size = UDim2.new(0, LIST_W, 1, -(TOP_Y + HEADER_H + 4 + BOTTOM_MARGIN)),
		Position = UDim2.new(0, 0, 0, TOP_Y + HEADER_H + 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Root,
	})

	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = SlideList,
	})

	local EmptyHint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Sin pestañas todavía.\nUsá Window:CreateTab({ Name = \"...\" }).",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 60),
		Parent = SlideList,
	}, { corner(), stroke(Theme.Border, 1), pad(10) })

	local Window = setmetatable({
		ScreenGui  = ScreenGui,
		Root       = Root,
		Header     = Header,
		TitleLabel = TitleLabel,
		ClockLabel = ClockLabel,
		SlideList  = SlideList,
		EmptyHint  = EmptyHint,
		LIST_W     = LIST_W,
		HEADER_H   = HEADER_H,
		TOP_Y      = TOP_Y,
		BOTTOM_MARGIN = BOTTOM_MARGIN,
		_tabs        = {},
		_connections = {},
		_visible     = true,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(UI.Windows, Window)
	return Window
end

function UI:Show()
	self.Root.Visible = true
	self._visible = true
end

function UI:Hide()
	self.Root.Visible = false
	self._visible = false
end

function UI:Toggle()
	if self._visible then self:Hide() else self:Show() end
end

function UI:SetTitle(text)
	if self.TitleLabel then self.TitleLabel.Text = tostring(text) end
end

function UI:Destroy()
	for _, conn in ipairs(self._connections or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
	for i, w in ipairs(UI.Windows) do
		if w == self then table.remove(UI.Windows, i) break end
	end
end

-- ============================================================
-- 	CREATE TAB — la "línea" redondeada que se alarga hacia abajo
-- 	SIN tocar ni tapar a las demás (las empuja/esquiva).
-- ============================================================
function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))

	if self.EmptyHint then
		self.EmptyHint:Destroy()
		self.EmptyHint = nil
	end

	-- Envoltorio: línea + cuerpo desplegable, uno debajo del otro.
	-- CLAVE del "empuje sin pisarse": Item mide con AutomaticSize.Y, es
	-- decir, su alto real es SIEMPRE la suma de lo que mide adentro
	-- (línea fija + cuerpo, que va de 0 a su alto real). Como el
	-- UIListLayout de SlideList reacomoda a sus hijos según su alto
	-- ACTUAL, cada frame de la animación hace que Item crezca un
	-- poquito y arrastra a todas las pestañas de abajo con él — nunca
	-- se superponen, se van corriendo en vivo.
	local Item = new("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = #self._tabs + 1,
		Parent = self.SlideList,
	}, {
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local LineHeight = 42

	-- Ancho "cerrado": una píldora angosta que apenas envuelve el texto,
	-- pegada a la izquierda — NO ocupa todo el panel todavía.
	local collapsedWidth = math.clamp(#name * 8 + 58, 96, self.LIST_W)

	local HeaderRow = new("TextButton", {
		Name = "Line",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(0, collapsedWidth, 0, LineHeight),
		LayoutOrder = 1,
		Parent = Item,
	}, { corner(), stroke(Theme.Border, 1) })

	local Mark = new("Frame", {
		Size = UDim2.new(0, 3, 0, 20),
		Position = UDim2.new(0, 10, 0.5, -10),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = HeaderRow,
	}, { corner("soft") })
	onAccent(function()
		if Mark.Parent then Mark.BackgroundColor3 = Theme.Active end
	end)

	local NameLabel = new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(1, -48, 1, 0),
		ZIndex = 3,
		Parent = HeaderRow,
	})

	-- Flechita: apunta hacia abajo cuando está desplegada.
	local Arrow = new("TextLabel", {
		Text = "v",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		Rotation = -90,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -28, 0, 0),
		Size = UDim2.new(0, 18, 1, 0),
		ZIndex = 3,
		Parent = HeaderRow,
	})

	-- Cuerpo desplegable: arranca en 0 de alto y recortado, así no se ve
	-- nada de su contenido hasta que se abre la línea. Tiene su propio
	-- espacio antes de la línea (Padding en Item) para que se note como
	-- una continuación redondeada de la pestaña, no pegado a la línea de
	-- arriba.
	local Body = new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = 2,
		Parent = Item,
	}, { corner() })

	local List = new("Frame", {
		Name = "List",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = Body,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 8, 10, 12, 10),
	})

	local Tab = setmetatable({
		Window    = self,
		HeaderRow = HeaderRow,
		Body      = Body,
		List      = List,
		Mark      = Mark,
		Arrow     = Arrow,
		Name      = name,
		_isOpen   = false,
		_rowCount = 0,
	}, UI)

	hoverField(HeaderRow, Theme.Line)

	onAccent(function()
		if Mark.Parent and Tab._isOpen then
			Mark.BackgroundColor3 = Theme.Active
		end
	end)

	-- Animación en DOS tiempos, nunca junta:
	--   1) La línea se ALARGA hacia la derecha (de píldora angosta a
	--      todo el ancho del panel).
	--   2) Recién cuando ESO termina, lo que se alargó se DESLIZA hacia
	--      abajo mostrando los controles.
	-- Al cerrar es al revés: primero sube/se recoge el contenido de
	-- abajo, y cuando termina, la línea se encoge de nuevo a píldora.
	local ANIM_TIME = 0.16

	local function applyOpenVisual(open)
		Tab._isOpen = open
		Mark.BackgroundTransparency = open and 0 or 1
		HeaderRow.BackgroundColor3 = open and Theme.LineOpen or Theme.Line
		tween(Arrow, { Rotation = open and 0 or -90 }, ANIM_TIME)

		local targetHeight = 0
		if open then
			-- +4 de aire entre la línea y el primer control.
			targetHeight = List.AbsoluteSize.Y + 4
		end

		if open then
			-- Paso 1: alargar hacia la derecha.
			local widen = TweenService:Create(
				HeaderRow,
				TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Size = UDim2.new(1, 0, 0, LineHeight) }
			)
			widen.Completed:Connect(function()
				-- Si mientras se alargaba ya la cerraron de nuevo, no
				-- sigas desplegando hacia abajo.
				if not Tab._isOpen then return end
				tween(Body, { Size = UDim2.new(1, 0, 0, targetHeight) }, ANIM_TIME + 0.08)
			end)
			widen:Play()
		else
			-- Paso 1: recoger lo de abajo (deslizar hacia arriba).
			local collapseBody = TweenService:Create(
				Body,
				TweenInfo.new(ANIM_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Size = UDim2.new(1, 0, 0, 0) }
			)
			collapseBody.Completed:Connect(function()
				if Tab._isOpen then return end
				tween(HeaderRow, { Size = UDim2.new(0, collapsedWidth, 0, LineHeight) }, ANIM_TIME)
			end)
			collapseBody:Play()
		end
	end

	-- Expuesto para que setOpen de OTRA pestaña pueda cerrar esta sin
	-- disparar de nuevo la lógica de "cerrar a las demás" (evita recursión).
	function Tab:_setOpenInternal(open)
		applyOpenVisual(open)
	end

	local function setOpen(open)
		-- Cerrar cualquier otra línea que estuviera abierta: solo una a
		-- la vez ("se alarga y esquiva a las demás", no varias abiertas
		-- juntas empujándose entre sí).
		if open then
			for _, other in ipairs(self._tabs) do
				if other ~= Tab and other._isOpen then
					other:_setOpenInternal(false)
				end
			end
		end
		applyOpenVisual(open)
	end

	table.insert(self._connections, HeaderRow.MouseButton1Click:Connect(function()
		setOpen(not Tab._isOpen)
	end))

	table.insert(self._tabs, Tab)

	-- La primera pestaña que se crea arranca ya desplegada, para que no
	-- entres a un panel completamente vacío la primera vez.
	if #self._tabs == 1 then
		task.defer(function()
			setOpen(true)
		end)
	end

	return Tab
end

