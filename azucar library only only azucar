-- ============================================================
function UI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)

	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then
		rangeMin = rangeMin or config.Range[1]
		rangeMax = rangeMax or config.Range[2]
	end
	local min = rangeMin or 0
	local max = rangeMax or 100
	if max <= min then max = min + 1 end

	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end

	local decimals = 0
	if step < 1 then
		decimals = #tostring(step):gsub("^%d*%.?", "")
		if decimals > 3 then decimals = 3 end
	end

	local function snap(v)
		v = math.clamp(v, min, max)
		return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max)
	end
	local function show(v)
		if decimals > 0 then return string.format("%." .. decimals .. "f", v) end
		return tostring(math.floor(v + 0.5))
	end

	local value = snap(config.Default or config.CurrentValue or min)

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { corner("soft"), pad(0, 8, 10, 8, 10) })

	new("TextLabel", {
		Text = config.Text or config.Name or "Valor",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -52, 0, 16),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = show(value),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 50, 0, 16),
		Position = UDim2.new(1, -50, 0, 0),
		Parent = Row,
	})
	onAccent(function()
		if ValueLabel.Parent then ValueLabel.TextColor3 = Theme.Active end
	end)

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0, 28),
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Parent = Row,
	}, { corner("soft") })

	local function ratio(v) return (v - min) / (max - min) end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Track,
	}, { corner("soft") })
	onAccent(function()
		if Fill.Parent then Fill.BackgroundColor3 = Theme.Active end
	end)

	local Knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10),
		Position = UDim2.new(ratio(value), -5, 0.5, -5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = Track,
	}, { corner("soft") })

	local Slider = setmetatable({
		Track = Track, Fill = Fill, Knob = Knob, Value = value, Min = min, Max = max,
		Callback = callback, _threads = {},
	}, UI)

	local function repaint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -5, 0.5, -5)
		ValueLabel.Text = show(v)
	end

	function Slider:Set(newValue)
		newValue = snap(tonumber(newValue) or min)
		self.Value = newValue
		repaint(newValue)
		setFlagValue(config.Flag, newValue)
		return safeCall(self, self.Callback, newValue)
	end
	function Slider:Get() return self.Value end
	function Slider:Stop() stopAllThreads(self) end

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
		Slider:Set(min + relative * (max - min))
	end
	local function mouseOverThisTrack()
		local ok, mousePos = pcall(function() return UserInputService:GetMouseLocation() end)
		if not ok then return true end
		local tPos, tSize = Track.AbsolutePosition, Track.AbsoluteSize
		return mousePos.Y >= tPos.Y - 22 and mousePos.Y <= tPos.Y + tSize.Y + 22
	end

	table.insert(window._connections, Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end))
	table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if mouseOverThisTrack() then setFromX(input.Position.X) end
	end))
	table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	registerFlag(config.Flag, Slider, value)
	return Slider
end

-- ============================================================
-- 	DROPDOWN — acordeón adentro del acordeón: al abrirse empuja el
-- 	resto de esa pestaña hacia abajo (List ya mide con AutomaticSize,
-- 	y a su vez Item de la pestaña también, así que el empuje llega
-- 	hasta las OTRAS pestañas de la lista).
-- ============================================================
function UI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or config.Values or {}

	local function display(value)
		if typeof(value) == "Instance" then return value.Name end
		if typeof(value) == "table" and value.Name then return tostring(value.Name) end
		return tostring(value)
	end
	local function isValid(value)
		for _, opt in ipairs(options) do if opt == value then return true end end
		return false
	end

	local selected = options[1]
	local wanted = config.Default
	if wanted == nil then wanted = config.CurrentOption end
	if wanted ~= nil and isValid(wanted) then selected = wanted end

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { corner("soft") })

	new("TextLabel", {
		Text = config.Text or config.Name or "Opciones",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(0.45, -10, 0, 34),
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = selected ~= nil and display(selected) or "-",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.45, 0, 0, 0),
		Size = UDim2.new(0.55, -24, 0, 34),
		Parent = Row,
	})
	onAccent(function()
		if SelectedLabel.Parent then SelectedLabel.TextColor3 = Theme.Active end
	end)

	local Arrow = new("TextLabel", {
		Text = "+",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -20, 0, 0),
		Size = UDim2.new(0, 16, 0, 34),
		Parent = Row,
	})

	local ROW_H = 34
	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, -16, 0, math.min(math.max(#options, 1), 6) * 24 + 8),
		Position = UDim2.new(0, 8, 0, ROW_H),
		BackgroundColor3 = Theme.Line,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		corner("soft"), stroke(Theme.Border, 1), pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = setmetatable({ Value = selected, Options = options, Callback = callback, _threads = {} }, UI)

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = display(option)
		setFlagValue(config.Flag, option)
		return safeCall(self, self.Callback, option)
	end
	function Dropdown:Get() return self.Value end
	function Dropdown:Stop() stopAllThreads(self) end

	local setOpen
	local function buildOptions()
		for _, child in ipairs(ListFrame:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for index, optionValue in ipairs(Dropdown.Options) do
			local OptionBtn = new("TextButton", {
				Text = display(optionValue),
				Font = Theme.Font,
				TextSize = 11,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				BackgroundColor3 = Theme.Field,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 22),
				LayoutOrder = index,
				Parent = ListFrame,
			}, { corner("soft"), pad(0, 0, 6, 0, 6) })
			OptionBtn.MouseEnter:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.LineOpen }) end)
			OptionBtn.MouseLeave:Connect(function() tween(OptionBtn, { BackgroundColor3 = Theme.Field }) end)
			table.insert(window._connections, OptionBtn.MouseButton1Click:Connect(function()
				Dropdown:Set(optionValue)
				if setOpen then setOpen(false) end
			end))
		end
	end

	function Dropdown:Refresh(newOptions, keepSelection)
		self.Options = newOptions or {}
		options = self.Options
		buildOptions()
		local h = math.min(math.max(#self.Options, 1), 6) * 24 + 8
		ListFrame.Size = UDim2.new(1, -16, 0, h)
		if not keepSelection then
			self.Value = self.Options[1]
			SelectedLabel.Text = self.Value ~= nil and display(self.Value) or "-"
		end
	end
	Dropdown.SetOptions = Dropdown.Refresh

	buildOptions()

	local Click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ROW_H), Parent = Row })

	function setOpen(open)
		local h = math.min(math.max(#Dropdown.Options, 1), 6) * 24 + 8
		Row.Size = UDim2.new(1, 0, 0, open and (ROW_H + h + 4) or ROW_H)
		Arrow.Text = open and "-" or "+"
	end

	table.insert(window._connections, Click.MouseButton1Click:Connect(function()
		setOpen(Row.Size.Y.Offset <= ROW_H)
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

