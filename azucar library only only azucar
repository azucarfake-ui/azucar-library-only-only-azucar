function UI:CreateLabel(config)
	local text = config
	if typeof(config) == "table" then text = config.Text or config.Name or "" end

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local label = new("TextLabel", {
		Text = tostring(text),
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = nextOrder(owner),
		Parent = list,
	})

	local controller = setmetatable({ Instance = label }, UI)
	function controller:Set(newText) label.Text = tostring(newText) end
	return controller
end

function UI:CreateSection(config)
