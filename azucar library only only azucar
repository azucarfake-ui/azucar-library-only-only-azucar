Icons.star = function(root, st) -- estrella de 5 puntas (contorno)
	local cx, cy, R, r = 10, 10.8, 9, 3.9
	local pts = {}
	for i = 0, 9 do
		local a = math.rad(-90 + i * 36)
		local rad = (i % 2 == 0) and R or r
		pts[i + 1] = { cx + rad * math.cos(a), cy + rad * math.sin(a) }
	end
	for i = 1, 10 do
		local p, q = pts[i], pts[i % 10 + 1]
		line(root, st, p[1], p[2], q[1], q[2], 1.7)
	end
end

local IconLookup = {
	swords = Icons.swords, sword = Icons.swords, eye = Icons.eye, book = Icons.book,
	rings = Icons.rings, target = Icons.rings, circles = Icons.rings, heart = Icons.heart,
	diamond = Icons.diamond, gem = Icons.diamond, moon = Icons.moon, skull = Icons.skull, star = Icons.star,
}

local function buildIcon(parent, spec)
	local holder = new("Frame", {
		Name = "Icon", BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.new(0, ICON_SIZE, 0, ICON_SIZE), Parent = parent,
	})
	local paint
	local builder = typeof(spec) == "string" and IconLookup[spec:lower()] or nil
	if typeof(spec) == "string" and not builder and spec:match("^%a%a%a+$") then
		warn("[AzucarDulce] Ícono desconocido: '" .. spec .. "'. Usá Swords, Eye, Book, Rings, Heart, Diamond, Moon, Skull o Star.")
	end
	if builder then
		local st = { fills = {}, cuts = {}, strokes = {} }
		builder(holder, st)
		paint = function(c)
			for _, fr in ipairs(st.fills) do fr.BackgroundColor3 = c end
			for _, sk in ipairs(st.strokes) do sk.Color = c end
			for _, fr in ipairs(st.cuts) do fr.BackgroundColor3 = Theme.Background end
		end
	elseif typeof(spec) == "number" or (typeof(spec) == "string" and spec:find("^rbxasset")) then
		new("ImageLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
			Image = typeof(spec) == "number" and ("rbxassetid://" .. spec) or spec, Parent = holder,
		})
		paint = function() end
	else
		local lbl = new("TextLabel", {
			Text = tostring(spec), Font = Theme.FontBold, TextSize = 15, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0), Parent = holder,
		})
		paint = function(c) lbl.TextColor3 = c end
	end
	paint(Theme.Active)
	onAccent(function() if holder.Parent then paint(Theme.Active) end end)
	return holder
end

-- ============================================================
-- 	CREATE TAB — la tarjeta fija con su lista
-- ============================================================
function UI:CreateTab(config, icon)
	if typeof(config) == "string" then config = { Name = config } end
	config = config or {}
	if icon ~= nil then config.Icon = icon end
	if config.Icon == nil then config.Icon = config.IconName or config.Image end
	local window = self
	local name = tostring(config.Text or config.Name or config.Title or ("Tab " .. (#self._tabs + 1)))

	local openW = self._cardW
	local titleW = textW(name, 12, Theme.FontTitle)
	local iconSpec = config.Icon
	local function calcClosed(hasIcon) return math.clamp(math.ceil(titleW) + 76 + (hasIcon and ICON_W or 0), 70, openW) end
	local closedW = calcClosed(iconSpec ~= nil and iconSpec ~= false)

	-- Todas las pestañas van en UNA sola fila arriba, una al lado de la
	-- otra, cada una con su espacio para las píldoras. Están fijas.
	local x = TAB_PAD + #self._tabs * self._pitch
	self._canvasW = x + openW + self._sideW + TAB_PAD

	local shouldOpen = config.Open
	if shouldOpen == nil then shouldOpen = (#self._tabs == 0) end

	-- Root: punto fijo de la tarjeta. Nada recorta a nada acá, y las
	-- píldoras viven en PillLayer (afuera de la lista que scrollea).
	local Root = new("Frame", {
		Name = "Tab_" .. name, Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0, x, 0, TAB_PAD),
		BackgroundTransparency = 1, BorderSizePixel = 0, Parent = self.Holder,
	})

	local Card = new("Frame", {
		Name = "Card", Size = UDim2.new(0, closedW, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.Alpha, BorderSizePixel = 0, Parent = Root,
	}, {
		corner(14), accentStroke(1.5),
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) }),
	})

	local Header = new("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Card })
	local Title = new("TextLabel", {
		Text = name, Font = Theme.FontTitle, TextSize = 12, TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -74, 1, 0), Parent = Header,
	})
	onAccent(function() if Title.Parent then Title.TextColor3 = Theme.Active end end)
	local Counter = new("TextLabel", {
		Text = "0 / 0", Font = Theme.FontMono, TextSize = 9, TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 0), Size = UDim2.new(0, 42, 1, 0), Parent = Header,
	})
	-- Flechita: > = cerrada, < = abierta.
	local Arrow = new("TextLabel", {
		Text = ">", Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.TextDim, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.new(0, 12, 1, 0), Parent = Header,
	})
	local HeaderBtn = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Header })

	-- Ícono opcional a la izquierda del nombre.
	local IconHolder
	local function applyIcon(spec)
		if IconHolder then IconHolder:Destroy() IconHolder = nil end
		local has = spec ~= nil and spec ~= false and tostring(spec) ~= ""
		iconSpec = has and spec or nil
		Title.Position = UDim2.new(0, 10 + (has and ICON_W or 0), 0, 0)
		Title.Size = UDim2.new(1, -74 - (has and ICON_W or 0), 1, 0)
		closedW = calcClosed(has)
		if has then IconHolder = buildIcon(Header, spec) end
	end
	applyIcon(iconSpec)

	-- La lista: scrollea normal (rueda / arrastre / dedo) pero SIN barra.
	-- Su alto crece con las opciones hasta MaxListHeight y de ahí scrollea.
	local Layout = new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	local List = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = 2, Visible = false,
		ScrollBarThickness = 0, ScrollBarImageTransparency = 1, ScrollingEnabled = true,
		ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never,
		CanvasSize = UDim2.new(0, 0, 0, 0), Parent = Card,
	}, { pad(0, 2, 6, 8, 6), Layout })

	local PillLayer = new("Frame", {
		Name = "Pills", Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = Root,
	})

	local Tab = setmetatable({
		Window = self, Root = Root, Card = Card, List = List, PillLayer = PillLayer, Name = name,
		_isOpen = false, _rowCount = 0, _opts = {}, _openW = openW,
	}, UI)

	local function placeAll()
		for _, o in ipairs(Tab._opts) do o.Place() end
	end
	local function relayout()
		local contentH = Layout.AbsoluteContentSize.Y + 10
		local limit = window._maxH
		if not limit then
			local cam = workspace.CurrentCamera
			local vpY = cam and cam.ViewportSize.Y or 720
			limit = math.max(120, vpY - window._startY - HEADER_H - TAB_PAD * 2 - 24)
		end
		List.CanvasSize = UDim2.new(0, 0, 0, contentH)
		List.Size = UDim2.new(1, 0, 0, math.min(math.max(contentH, window._minH), limit))
	end
	Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(relayout)
	List:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeAll)
	-- Al scrollear la lista, las píldoras siguen a su fila.
	List:GetPropertyChangedSignal("CanvasPosition"):Connect(placeAll)

	Tab._recount = function()
		local active = 0
		for _, o in ipairs(Tab._opts) do if o.Active then active = active + 1 end end
		Counter.Text = string.format("%d / %d", active, #Tab._opts)
		if window._activeRefresh then window._activeRefresh() end
	end

	local function paintArrow()
		Arrow.Text = Tab._isOpen and "<" or ">"
		Arrow.TextColor3 = Tab._isOpen and Theme.Active or Theme.TextDim
	end
	onAccent(function() if Arrow.Parent then paintArrow() end end)

	local function setOpen(open)
		Tab._isOpen = open
		List.Visible = open
		paintArrow()
		tween(Card, { Size = UDim2.new(0, open and openW or closedW, 0, 0) }, 0.14)
		task.defer(placeAll)
		if window._activeRefresh then window._activeRefresh() end -- la lista de la derecha también muestra la flechita
	end
	Tab.Open = function() setOpen(true) end
	Tab.Close = function() setOpen(false) end
	Tab.SetOpen = function(_, open) setOpen(not not open) end
	Tab.SetIcon = function(_, spec) applyIcon(spec) setOpen(Tab._isOpen) end

	-- Click en la cabecera abre/cierra. Arrastrarla NO mueve la tarjeta:
	-- desplaza la fila de pestañas.
	table.insert(self._connections, HeaderBtn.InputBegan:Connect(function(input)
		local k = input.UserInputType
		if k ~= Enum.UserInputType.MouseButton1 and k ~= Enum.UserInputType.Touch then return end
		beginDrag(window, "x", nil, input, function() setOpen(not Tab._isOpen) end)
	end))
	-- Arrastrar sobre la lista la scrollea (rueda y dedo los maneja el
	-- ScrollingFrame; el click apretado lo hacemos acá). Si no hay nada
	-- que scrollear, arrastrar desplaza la fila de pestañas.
	Tab._listDrag = function(input)
		local k = input.UserInputType
		if k ~= Enum.UserInputType.MouseButton1 and k ~= Enum.UserInputType.Touch then return end
		beginDrag(window, listOverflows(Tab) and "y" or "x", Tab, input, nil)
	end
	table.insert(self._connections, List.InputBegan:Connect(Tab._listDrag))

	table.insert(self._tabs, Tab)
	setOpen(shouldOpen)
	return Tab
end

-- ============================================================
-- 	OPCIÓN = fila en la lista + píldora lateral
-- ============================================================
-- Crea la fila (puntito, nombre, flechita) y la píldora vacía que se
-- despliega al costado. Cada control llena la píldora a su manera. La
-- píldora NO es hija de la fila (la lista scrollea y recortaría): vive
-- en PillLayer y se acomoda a la altura de su fila.
local function makeOption(tab, labelText, pillW)
	local window = tab.Window
	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = Theme.RowIdle, BorderSizePixel = 0,
		LayoutOrder = nextOrder(tab), Parent = tab.List,
	}, { corner(9) })

	local Dot = new("Frame", {
		Size = UDim2.new(0, 7, 0, 7), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
		BackgroundColor3 = Theme.Active, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Row,
	}, { circle() })
	local DotStroke = new("UIStroke", { Color = Theme.Active, Thickness = 1.2, Parent = Dot })
	onAccent(function() if Dot.Parent then Dot.BackgroundColor3 = Theme.Active DotStroke.Color = Theme.Active end end)

	new("TextLabel", {
		Text = tostring(labelText), Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
		Position = UDim2.new(0, 23, 0, 0), Size = UDim2.new(1, -50, 1, 0), Parent = Row,
	})

	local Chev = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -5, 0.5, 0),
		BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Parent = Row,
	}, { circle(), accentStroke(1) })
	local ChevText = new("TextLabel", {
		Text = "›", Font = Theme.FontBold, TextSize = 14, TextColor3 = Theme.Active, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, -1), Parent = Chev,
	})

	local Pill = new("Frame", {
		Name = "Pill", Visible = false, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, tab._openW - 2, 0, 0),
		Size = UDim2.new(0, pillW, 0, PILL_H), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Parent = tab.PillLayer,
	}, { corner(PILL_H / 2), accentStroke(1.5) })
	local PillScale = new("UIScale", { Scale = 1, Parent = Pill })

	local Click = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local opt = { Row = Row, Pill = Pill, Open = false, Active = false }
	local hovering = false

	-- Acomoda la píldora a la altura de su fila. Si la fila quedó
	-- scrolleada fuera de la vista (o la pestaña está cerrada), se oculta.
	local function place()
		if not (opt.Open and tab._isOpen) then
			Pill.Visible = false
			return
		end
		local list = tab.List
		local center = Row.AbsolutePosition.Y + ROW_H / 2
		local top = list.AbsolutePosition.Y
		Pill.Position = UDim2.new(0, tab._openW - 2, 0, center - tab.Root.AbsolutePosition.Y)
		Pill.Visible = center >= top and center <= top + list.AbsoluteSize.Y
	end
	opt.Place = place
	Row:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		if opt.Open then place() end
	end)

	local function paintRow()
		local color = (opt.Open and Theme.LineOpen) or (hovering and Theme.Field) or Theme.RowIdle
		tween(Row, { BackgroundColor3 = color }, 0.12)
		if opt.Open then
			tween(Chev, { BackgroundColor3 = Theme.Active }, 0.12)
			ChevText.Text = "‹"
			ChevText.TextColor3 = Color3.new(1, 1, 1)
		else
			tween(Chev, { BackgroundColor3 = Theme.Background }, 0.12)
			ChevText.Text = "›"
			ChevText.TextColor3 = Theme.Active
		end
	end
	onAccent(function()
		if not Row.Parent then return end
		if opt.Open then Chev.BackgroundColor3 = Theme.Active else ChevText.TextColor3 = Theme.Active end
	end)

	function opt.SetActive(active)
		active = not not active
		opt.Active = active
		tween(Dot, { BackgroundTransparency = active and 0 or 1 }, 0.12)
		tab._recount()
	end
	function opt.Flash()
		Dot.BackgroundTransparency = 0
		tween(Dot, { BackgroundTransparency = opt.Active and 0 or 1 }, 0.4)
	end
	function opt.SetOpen(open)
		opt.Open = open
		-- La pestaña con una píldora abierta se dibuja por encima de la
		-- vecina, así la píldora nunca queda tapada aunque estén juntas.
		local anyOpen = false
		for _, o in ipairs(tab._opts) do if o.Open then anyOpen = true break end end
		tab.Root.ZIndex = anyOpen and 2 or 1
		place()
		if open and Pill.Visible then
			PillScale.Scale = 0.7
			tween(PillScale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
		paintRow()
	end

	Click.MouseEnter:Connect(function() hovering = true paintRow() end)
	Click.MouseLeave:Connect(function() hovering = false paintRow() end)
	Click.InputBegan:Connect(tab._listDrag)
	Click.MouseButton1Click:Connect(function()
		-- Si venía de un arrastre (scroll), no abre/cierra la píldora.
		local d = window._drag
		if window._dragMoved or (d and d.moved) then return end
		opt.SetOpen(not opt.Open)
	end)

	table.insert(tab._opts, opt)
	tab._recount()
	return opt
end

-- Botoncito redondo con flecha, para dentro de las píldoras (‹ ›).
local function stepButton(parent, text, x)
	local b = new("TextButton", {
		Text = text, Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Active, AutoButtonColor = false,
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Size = UDim2.new(0, 15, 0, 15),
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x, 0.5, 0), Parent = parent,
	}, { circle(), accentStroke(1) })
	onAccent(function() if b.Parent then b.TextColor3 = Theme.Active end end)
	b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = Theme.LineOpen }, 0.1) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = Theme.Field }, 0.1) end)
	return b
end

-- ============================================================
-- 	CONTROLES
-- ============================================================
function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
	local text = config.Text or config.Name or config.Title or "Botón"
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, text, 84)
	local Pill = opt.Pill
	local Btn = new("TextButton", {
		Text = config.ButtonText or "Ejecutar", Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.Text,
		AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Pill,
	})

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, UI)
	function Button:Set(...)
		-- Destello rosa de la píldora que se apaga solo.
		Pill.BackgroundColor3 = Theme.Active
		tween(Pill, { BackgroundColor3 = Theme.Panel }, 0.3)
		Btn.TextColor3 = Color3.new(1, 1, 1)
		task.delay(0.2, function()
			if Btn.Parent then Btn.TextColor3 = Theme.Text end
		end)
		opt.Flash()
		return safeCall(self, self.Callback, ...)
	end
	Button.Fire = Button.Set
	function Button:Stop() stopAllThreads(self) end
	table.insert(window._connections, Btn.MouseButton1Click:Connect(function() Button:Set() end))
	registerFlag(config.Flag, Button, nil)
	return Button
end

function UI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end
	state = not not state
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local opt = makeOption(owner, config.Text or config.Name or "Opción", 70)
	local Pill = opt.Pill
	local OFF_POS, ON_POS = UDim2.new(0, 7, 0.5, 0), UDim2.new(1, -7, 0.5, 0)

	local StateLabel = new("TextLabel", {
