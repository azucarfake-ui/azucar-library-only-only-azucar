function UI:CreateKeybind(config)
	config = config or {}
	local callback = resolveCallback(config)

	local currentKey = config.Default or config.CurrentKeybind or Enum.KeyCode.RightShift
	if typeof(currentKey) == "string" then
		local ok, parsed = pcall(function() return Enum.KeyCode[currentKey] end)
		currentKey = (ok and parsed) or Enum.KeyCode.RightShift
	end
	local listening = false

	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Field,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { corner(8), pad(0, 0, 12, 0, 12) })

	new("TextLabel", {
		Text = config.Text or config.Name or "Tecla",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -70, 1, 0),
		Parent = Row,
	})
	local KeyButton = new("TextButton", {
		Text = currentKey.Name,
		Font = Theme.FontMono,
		TextSize = 11,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 58, 0, 22),
		Position = UDim2.new(1, -58, 0.5, -11),
		Parent = Row,
	}, { corner(5), stroke(Theme.Border, 1) })

	local Keybind = setmetatable({ Value = currentKey, Callback = callback, _threads = {} }, UI)
	function Keybind:Set(keyCode)
		if typeof(keyCode) == "string" then
			local ok, parsed = pcall(function() return Enum.KeyCode[keyCode] end)
			keyCode = (ok and parsed) or self.Value
		end
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		setFlagValue(config.Flag, keyCode)
	end
	function Keybind:Get() return self.Value end
	function Keybind:Stop() stopAllThreads(self) end

	table.insert(window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
		KeyButton.TextColor3 = Theme.Active
	end))
	table.insert(window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			KeyButton.TextColor3 = Theme.Text
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			safeCall(Keybind, Keybind.Callback, Keybind.Value)
		end
	end))

	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end

