		if Panel.Visible then
			self:SelectTab(nil)
		else
			self:SelectTab(name)
		end
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

function UI:SelectTab(name)
	for _, tab in ipairs(self._tabs or {}) do
		local selected = (tab.Name == name)
		local wasVisible = tab.Panel.Visible

		tab.Panel.Visible = selected
		-- Negro brilloso en reposo, color de acento (rojo por defecto)
		-- cuando está abierta — el degradado y la franja de brillo son
		-- capas hijas separadas, así que siguen viéndose "brillosas"
		-- encima de cualquiera de los dos colores.
		tab.Button.BackgroundColor3 = selected and Theme.Active or Theme.TabIdle

		if selected and not wasVisible then
			slideInFromLeft(tab.Panel, 260, 0.32)
		end

		if tab.NameLabel then
			tab.NameLabel.TextColor3 = selected and Theme.Text or Theme.TextDim
		end
		if tab.Arrow then
			tab.Arrow.Text = selected and "<" or ">"
			tab.Arrow.TextColor3 = selected and Theme.Text or Theme.TextDim
		end

		if not selected then
			for _, group in pairs(tab._groupPanels) do
				group.Instance.Visible = false
				group.Arrow.Text = ">"
				group.Arrow.TextColor3 = Theme.TextDim
			end
		end
	end
end

