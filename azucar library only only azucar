function UI:CreateSection(config)
	local text = config
	if typeof(config) == "table" then text = config.Text or config.Name or "Sección" end
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local grp = newGroup(owner, tostring(text))
	local controller = setmetatable({ Instance = grp.frame }, UI)
	function controller:Set(newText) if grp.title then grp.title.Text = "  " .. tostring(newText) .. " " end end
	return controller
end
UI.CreateSectionLabel = UI.CreateSection

function UI:CreateLabel(config)
	local text = config
	if typeof(config) == "table" then text = config.Text or config.Name or "" end
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 16)
	local lbl = label({
		Text = tostring(text), TextColor3 = Theme.TextDim, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 16), LayoutOrder = nextOrder(owner), Parent = body,
	})
	local controller = setmetatable({ Instance = lbl }, UI)
	function controller:Set(newText) lbl.Text = tostring(newText) end
	return controller
end

function UI:CreateDivider()
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 7)
	local row = rowFrame(body, 7, nextOrder(owner))
	new("Frame", {
		BackgroundColor3 = Theme.Line, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), Parent = row,
	})
	return setmetatable({ Instance = row }, UI)
end

function UI:CreateStat(config)
	config = config or {}
	local list, window, owner = host(self)
	if not list then return setmetatable({}, Stub) end
	local body = tabBody(owner, 16)
	local row = rowFrame(body, 16, nextOrder(owner))
	label({ Text = tostring(config.Label or config.Text or config.Name or ""), TextColor3 = Theme.TextDim, Size = UDim2.new(0.5, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local valueLabel = label({
		Text = tostring(config.Value or "0"), TextColor3 = Theme.Active, TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})
	local Stat = setmetatable({ Instance = valueLabel, Value = config.Value or "0" }, UI)
	function Stat:Set(newValue) self.Value = newValue valueLabel.Text = tostring(newValue) end
	registerFlag(config.Flag, Stat, config.Value)
	return Stat
end

function UI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)
