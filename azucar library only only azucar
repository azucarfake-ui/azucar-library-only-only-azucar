--[[
	AzucarLegit  v1.2.0
	====================
	(Antes: AzucarSlideUI / AzucarHackerUI)

	Concepto: pestañas como LÍNEAS-píldora angostas pegadas a la
	izquierda, con bordes redondeados. Al tocar una pasa en DOS tiempos:
		1) la línea se ALARGA hacia la derecha hasta ocupar todo el
		   panel.
		2) recién ahí, lo que se alargó se DESLIZA hacia abajo
		   mostrando sus controles (toggles, sliders, dropdowns...).
	Las demás líneas se CORREN hacia abajo para no quedar tapadas ni
	superpuestas (nunca se pisan entre sí). Si hay muchas pestañas y una
	queda fuera de la pantalla, hay un scroll angosto para bajar y
	encontrarla. Arriba, la hora exacta de tu reloj (la pone tu propia
	PC, así que ya es la de tu país), y por defecto la ventana entera se
	para bien arriba, por encima de la barra superior de Roblox.

	NOVEDAD DE ESTA VERSIÓN (v1.2.0):

	- Antes cada línea ya arrancaba con el ancho completo del panel y
	  solo se desplegaba hacia abajo. Ahora arranca como una píldora
	  angosta (solo el ancho del texto) y la apertura tiene dos pasos
	  bien diferenciados: primero se estira hacia la derecha, y cuando
	  ESE movimiento termina, recién ahí baja el contenido. Al cerrar es
	  al revés: primero sube/se recoge el contenido, y cuando termina,
	  la línea se encoge de nuevo a píldora.
	- La ventana ahora se para por defecto por ENCIMA de la barra
	  superior de Roblox (más arriba en la pantalla). Si alguna vez
	  tapa algo que no querés tapar, pasá
	  UI:CreateWindow({ IgnoreGuiInset = false }) para volver a
	  respetarla.

	QUÉ CAMBIÓ RESPECTO A LA VERSIÓN ANTERIOR (AzucarSlideUI):

	1. TABS REDONDAS DE VERDAD.
	   Antes Theme.CornerRadius no existía y corner() devolvía esquinas
	   en 0 salvo que se pasara un número a mano — la mayoría de las
	   llamadas no lo hacían, así que todo quedaba cuadrado. Ahora hay
	   un radio por defecto (Theme.CornerRadius) y CADA línea, cuerpo
	   desplegable, fila (toggle/slider/dropdown/input/botón) y la
	   cabecera tienen esquinas redondeadas de fábrica.

	2. LAS PESTAÑAS YA NO SE PISAN AL ABRIRSE.
	   Antes cada "Item" (línea + su cuerpo desplegable) tenía una
	   altura FIJA de 40px. Cuando el cuerpo se desplegaba hacia abajo,
	   crecía por ENCIMA de la siguiente pestaña en vez de empujarla —
	   se superponían. Ahora Item mide con AutomaticSize (se ajusta solo
	   a lo que mide adentro: la línea + el cuerpo abierto), así que el
	   UIListLayout de la lista reacomoda automáticamente TODAS las
	   pestañas de abajo, cuadro por cuadro, mientras la animación
	   corre. El resultado: la pestaña activa se alarga y el resto se
	   corre para abajo, esquivándola, sin superposición posible.

	3. SEPARACIÓN VISUAL ENTRE PESTAÑAS.
	   Antes el espacio entre líneas era de 2px (casi pegadas, lo cual
	   se nota mal con esquinas redondeadas). Ahora hay más aire entre
	   cada una para que se vean como tarjetas independientes.

	4. RENOMBRADA A AzucarLegit.
	   Nombre del ScreenGui, mensajes de warn() y versión actualizados.
	   El motor es el mismo que SugarUI/AzucarHackerUI: Callbacks en
	   hilos independientes (task.spawn + pcall, concurrencia
	   ilimitada), Flags/FlagValues, y los mismos alias de campo:
		Text | Name                  → texto de la fila
		Min/Max | Range = {min, max} → rango del slider
		Default | CurrentValue       → valor inicial
		Increment | Step             → salto del slider
		Callback | Logic = TuTabla   → lógica a ejecutar

	Uso básico (igual que antes):

		local UI = loadstring(game:HttpGet("...AzucarLegit.lua"))()

		local Window = UI:CreateWindow({ Title = "Azúcar Hub" })

		local Combate = Window:CreateTab({ Name = "Combate" })
		Combate:CreateToggle({ Text = "Auto Farm", Flag = "AutoFarm",
			Callback = function(state) ... end })
		Combate:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) ... end })

		Window:CreateTab({ Name = "Ajustes" })

	Podés ajustar qué tan redondeado se ve todo con
		UI.Theme.CornerRadius = 14   -- más redondo
		UI.Theme.CornerRadius = 4    -- más recto
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UI = {}

UI.Version    = "1.2.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}

-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarLegit] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

