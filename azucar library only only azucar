-- Iconos dibujados con cuadros (no dependen de la fuente)
-- ============================================================
local Icons = {}
local function part(parent, list, kind, props, children)
	local f = new("Frame", props, children)
	f.Parent = parent
	table.insert(list, { inst = f, kind = kind })
	return f
end
local function fillPart(parent, list, x, y, w, h, rot, round_)
	return part(parent, list, "bg", {
		BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, w, 0, h), Rotation = rot or 0,
	}, round_ and { new("UICorner", { CornerRadius = UDim.new(1, 0) }) } or nil)
end
local function ringPart(parent, list, x, y, w, h, rot, radius)
	return part(parent, list, "stroke", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, w, 0, h), Rotation = rot or 0,
	}, { new("UIStroke", { Color = Theme.Text, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		radius and new("UICorner", { CornerRadius = UDim.new(0, radius) }) or nil })
end
Icons.target = function(p, l) ringPart(p, l, 0, 0, 10, 10, 0, 5) fillPart(p, l, 3, 3, 4, 4, 0, true) end
Icons.eye    = function(p, l) ringPart(p, l, 0, 2, 10, 6, 0, 3) fillPart(p, l, 3.5, 3.5, 3, 3, 0, true) end
Icons.gear   = function(p, l) ringPart(p, l, 1, 1, 8, 8, 0) ringPart(p, l, 1, 1, 8, 8, 45) fillPart(p, l, 3.5, 3.5, 3, 3) end
Icons.star   = function(p, l) fillPart(p, l, 1.5, 1.5, 7, 7, 0) fillPart(p, l, 1.5, 1.5, 7, 7, 45) end
Icons.list   = function(p, l) fillPart(p, l, 0, 1, 10, 2) fillPart(p, l, 0, 4, 10, 2) fillPart(p, l, 0, 7, 10, 2) end
Icons.user   = function(p, l) fillPart(p, l, 3, 0, 4, 4, 0, true) fillPart(p, l, 1, 5, 8, 5) end
Icons.dot    = function(p, l) fillPart(p, l, 3, 3, 4, 4) end
Icons.sword  = function(p, l) fillPart(p, l, 4, 0, 2, 8) fillPart(p, l, 1, 6, 8, 2) fillPart(p, l, 4, 8, 2, 2) end
Icons.home   = function(p, l) fillPart(p, l, 1.5, 0.5, 7, 7, 45) fillPart(p, l, 2, 5, 6, 5) end

local function makeIcon(parent, name)
	local build = Icons[name]
	if not build then return nil end
	local box = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.new(0, 10, 0, 10), Parent = parent,
	})
	local list = {}
	build(box, list)
	local function paint(color)
		for _, p in ipairs(list) do
			if p.kind == "bg" then p.inst.BackgroundColor3 = color
			else local s = p.inst:FindFirstChildOfClass("UIStroke") if s then s.Color = color end end
		end
	end
	paint(Theme.Text)
	return { paint = paint }
end

-- ============================================================
-- Selector de color (cuadro SV + barra de tono), en linea
-- ============================================================
local function makePicker(window, holder, default, order, onChange)
	local h, s, v = (default or Color3.new(1, 1, 1)):ToHSV()
	local panel = new("Frame", {
		BackgroundColor3 = Theme.Field, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 92), Visible = false,
		LayoutOrder = order or 9, Parent = holder,
	}, { stroke(Theme.Dim, 1) })
	local sv = new("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 6),
		Size = UDim2.new(1, -34, 1, -12), ClipsDescendants = true, Parent = panel,
	})
	new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = sv,
	}, { new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }) })
	new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = sv,
	}, { new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }) }) })
	local svCur = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 6, 0, 6), ZIndex = 3, Parent = sv,
	}, { stroke(Color3.new(1, 1, 1), 1) })
	local hue = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 6), Size = UDim2.new(0, 16, 1, -12), Parent = panel,
	}, { new("UIGradient", { Rotation = 90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
		ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
		ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)), ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
	}) }) })
	local hueCur = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4), ZIndex = 3, Parent = hue,
	}, { stroke(Color3.new(1, 1, 1), 1) })

	local obj = {}
	local function refresh(silent)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCur.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCur.Position = UDim2.new(0.5, 0, h, 0)
		obj.Color = Color3.fromHSV(h, s, v)
		if not silent and onChange then onChange(obj.Color) end
	end
	function obj.set(c, silent) h, s, v = c:ToHSV() refresh(silent) end
	obj.panel = panel
	obj.Color = Color3.fromHSV(h, s, v)

	local dragSV, dragH = false, false
	local function updSV(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		refresh()
	end
	local function updH(pos)
		h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
		refresh()
	end
	sv.InputBegan:Connect(function(i) if isClick(i) then dragSV = true updSV(i.Position) end end)
	hue.InputBegan:Connect(function(i) if isClick(i) then dragH = true updH(i.Position) end end)
	window:_connect(UserInputService.InputChanged, function(i)
		if not isMove(i) then return end
		if dragSV then updSV(i.Position) elseif dragH then updH(i.Position) end
	end)
	window:_connect(UserInputService.InputEnded, function(i) if isClick(i) then dragSV, dragH = false, false end end)
	refresh(true)
	return obj
end

